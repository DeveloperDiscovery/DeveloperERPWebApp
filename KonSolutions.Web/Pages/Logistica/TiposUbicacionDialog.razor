@using TiposUbicacionModel = KONSolutions.Shared.Models.Logistica.TiposUbicacion
@using KONSolutions.Shared.Common
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <CrudDialogTitle Modo="Modo" Descripcion="@Item?.DES_TIPO_UBICACION" />
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit" OnInvalidSubmit="OnInvalidSubmit">
            <DataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    @* El código lo escribe el usuario (no hay correlativo automático) y es
                       parte de la PK: solo se puede fijar al crear. *@
                    <CampoTexto Tabla="LOGISTICA.TIPOS_UBICACION" Columna="COD_TIPO_UBICACION"
                                @bind-Value="_model.COD_TIPO_UBICACION"
                                Disabled="@(!_esNuevo || _readonly)" Obligatorio="@_esNuevo" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <CampoTexto Tabla="LOGISTICA.TIPOS_UBICACION" Columna="DES_TIPO_UBICACION"
                                @bind-Value="_model.DES_TIPO_UBICACION"
                                Disabled="_readonly" Obligatorio="true" />
                </MudItem>
                <MudItem xs="12">
                    <ImagePicker Image="_model.IMG_IMAGEN" ImageChanged="@(v => _model.IMG_IMAGEN = v)"
                                 Label="Imagen del tipo de ubicación" ReadOnly="_readonly" />
                </MudItem>
            </MudGrid>
            <CrudDialogActions Modo="Modo" Saving="_saving" OnCancel="@(() => MudDialog.Cancel())" />
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TiposUbicacionModel? Item { get; set; }
    [Parameter] public CrudModo Modo { get; set; } = CrudModo.Create;

    private TiposUbicacionModel _model = new();
    private bool _esNuevo, _saving;
    private bool _readonly => Modo == CrudModo.Read || Modo == CrudModo.Delete;

    protected override async Task OnInitializedAsync()
    {
        _esNuevo = Modo == CrudModo.Create;
        if (Item is not null) MapearDesdeModelo(Item);
        if (!_esNuevo && Item is not null) await RecargarDesdeShowbyidAsync();
    }

    private void MapearDesdeModelo(TiposUbicacionModel m)
    {
        _model = new TiposUbicacionModel
        {
            COD_TIPO_UBICACION = m.COD_TIPO_UBICACION,
            DES_TIPO_UBICACION = m.DES_TIPO_UBICACION,
            IMG_IMAGEN         = m.IMG_IMAGEN
        };
    }

    /// <summary>Trae el registro fresco desde SHOWBYID — evita mostrar datos desactualizados
    /// de la grilla al Modificar/Eliminar/Ver.</summary>
    private async Task RecargarDesdeShowbyidAsync()
    {
        var fresco = await Http.SafeGetAsync<TiposUbicacionModel>(
            $"{ApiRoutes.Logistica.TiposUbicacion}/{Uri.EscapeDataString(_model.COD_TIPO_UBICACION)}");
        if (fresco is not null) MapearDesdeModelo(fresco);
    }

    private async Task OnInvalidSubmit(EditContext ctx)
    {
        var errores = string.Join(" · ", ctx.GetValidationMessages());
        await DialogService.ShowAsync<KONSolutions.Web.Pages.Shared.ErrorSqlDialog>("",
            new DialogParameters
            {
                ["Titulo"]  = "Faltan datos obligatorios",
                ["Mensaje"] = string.IsNullOrWhiteSpace(errores) ? "Hay campos obligatorios sin completar." : errores
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = false, BackdropClick = false, CloseOnEscapeKey = false });
    }

    private async Task Submit()
    {
        _saving = true;
        var ruta = ApiRoutes.Logistica.TiposUbicacion;
        if (Modo == CrudModo.Delete)
        {
            var rd = await Http.DeleteAsync($"{ruta}/{Uri.EscapeDataString(_model.COD_TIPO_UBICACION)}");
            _saving = false;
            if (rd.IsSuccessStatusCode) { Snackbar.Add("Eliminado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
            else await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(TiposUbicacionDialog), nameof(Submit), "No se pudo eliminar el registro");
            return;
        }

        // El SP INSERT hace upsert: Crear y Modificar usan el mismo POST.
        var resp = await Http.PostAsJsonAsync(ruta, _model);
        _saving = false;
        if (resp.IsSuccessStatusCode) { Snackbar.Add(_esNuevo ? "Creado." : "Modificado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(TiposUbicacionDialog), nameof(Submit));
    }
}
