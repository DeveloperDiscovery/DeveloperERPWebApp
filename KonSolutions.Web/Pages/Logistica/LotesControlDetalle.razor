@page "/logistica/lotes-control-detalle"
@attribute [Authorize]
@using Modelo = KONSolutions.Shared.Models.Logistica.LotesControlDetalle
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog

<PageTitle>Detalle de Lotes de Control · @ConfigSvc.Current.NombreApp</PageTitle>

@* Consulta transversal, de solo lectura. Los productos de un lote se ven dentro del lote;
   esta pantalla existe para la pregunta inversa —«¿en qué lotes está este producto?»— y por
   eso arranca pidiendo un lote o un filtro. *@
<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Detalle de Lotes de Control" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema LOGISTICA · consulta de solo lectura · @_visibles.Count productos</MudText>
    </div>
    <div style="width:320px;">
        <AriaCombo TItem="ComboboxItem" Items="_lotes"
                   TextFunc="@(t => $"{t.Id} — {t.Texto}")" ValueFunc="@(t => t.Id)"
                   Value="@_loteSel" ValueChanged="OnLoteChanged"
                   Label="Lote" Class="" />
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="Buscar" Placeholder="Filtrar por producto..." DebounceInterval="400" MaxWidth="520px" Class="grid-header-search" />
    <div class="grid-header-divider"></div>
    <GridRefreshButton OnRefresh="Load" />
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="lotes-control-detalle" style="position:relative;">
    <MudDataGrid T="Modelo" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Sortable="false" Title="Lote" Width="160px">
                <HeaderTemplate><EncabezadoOrdenable Texto="Lote" /></HeaderTemplate>
                <CellTemplate><span class="mono">@context.Item.NUM_LOTE_CONTROL</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Código" Width="160px">
                <HeaderTemplate><EncabezadoOrdenable Texto="Código" /></HeaderTemplate>
                <CellTemplate><span class="mono">@context.Item.COD_PRODUCTO</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Producto" Width="420px">
                <HeaderTemplate><EncabezadoOrdenable Texto="Producto" /></HeaderTemplate>
                <CellTemplate>@context.Item.DES_PRODUCTO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Cantidad" Width="130px"
                            CellStyle="text-align:right;" HeaderStyle="text-align:right;">
                <HeaderTemplate><EncabezadoOrdenable Texto="Cantidad" /></HeaderTemplate>
                <CellTemplate><span class="mono">@context.Item.CAN_PRODUCTO?.ToString("N6")</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Valor" Width="130px"
                            CellStyle="text-align:right;" HeaderStyle="text-align:right;">
                <HeaderTemplate><EncabezadoOrdenable Texto="Valor" /></HeaderTemplate>
                <CellTemplate><span class="mono">@context.Item.VAL_TOTAL?.ToString("N2")</span></CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Class="pa-6 mono" Style="opacity:.5;">
                @(string.IsNullOrWhiteSpace(_loteSel) ? "Elegí un lote para ver sus productos." : "Este lote no tiene productos.")
            </MudText>
        </NoRecordsContent>
        <PagerContent><MudDataGridPager T="Modelo" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<Modelo> _items = new();
    private List<ComboboxItem> _lotes = new();
    private string? _loteSel;
    private string _search = "";

    private List<Modelo> _visibles => string.IsNullOrWhiteSpace(_search)
        ? _items
        : _items.Where(x => (x.COD_PRODUCTO ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)
                         || (x.DES_PRODUCTO ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();

    private Task Buscar() { StateHasChanged(); return Task.CompletedTask; }

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("LOGISTICA", "LotesControlDetalle");
        _lotes = (await Http.SafeGetAsync<List<ComboboxItem>>(ApiRoutes.Logistica.LotesControlCombobox)) ?? new();
    }

    private async Task OnLoteChanged(string? v)
    {
        _loteSel = v;
        await Load();
    }

    private async Task Load()
    {
        if (string.IsNullOrWhiteSpace(_loteSel)) { _items = new(); return; }
        try
        {
            var r = await Http.SafeGetAsync<List<Modelo>>(
                $"{ApiRoutes.Logistica.LotesControlDetallePorDoc}/{Uri.EscapeDataString(_loteSel)}");
            _items = r ?? new();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(LotesControlDetalle), nameof(Load));
            Snackbar.Add("No se pudo cargar el detalle. Ver el log de errores.", Severity.Error);
            _items = new();
        }
    }
}
