@page "/logistica/tipos-reserva-stock"
@attribute [Authorize]
@using Modelo = KONSolutions.Shared.Models.Logistica.TiposReservaStock
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@inject ShortcutService ShortcutSvc
@implements IDisposable
@inject ErrorLogService ErrorLog

<PageTitle>Tipos de Reserva de Stock · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Tipos de Reserva de Stock" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema LOGISTICA · @_visibles.Count de @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="Buscar" Placeholder="Buscar..." DebounceInterval="400" MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f=>f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="tiposreservastock" style="position:relative;">
    <MudDataGrid T="Modelo" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Sortable="false" Title="Código"
                            Width="@Limites.ColWidth("LOGISTICA.TIPOS_RESERVA_STOCK","COD_TIPO_RESERVA",80,120)" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_TIPO_RESERVA" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="Modelo" ItemsBase="@Base(0)" ValorDe="@(x=>x.COD_TIPO_RESERVA)"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate><span class="mono">@context.Item.COD_TIPO_RESERVA</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Descripción"
                            Width="@Limites.ColWidth("LOGISTICA.TIPOS_RESERVA_STOCK","DES_TIPO_RESERVA",180,340)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_TIPO_RESERVA" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="Modelo" ItemsBase="@Base(1)" ValorDe="@(x=>x.DES_TIPO_RESERVA)"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_TIPO_RESERVA</CellTemplate>
            </TemplateColumn>
            @* Las marcas van juntas en una sola columna: son cinco banderas de sí/no y
               abrirlas en una columna cada una gasta todo el ancho de la grilla sin decir
               más. El ícono prendido es la marca activa; el tooltip la nombra. *@
            <TemplateColumn Sortable="false" Title="Aplica a" Width="200px">
                <HeaderTemplate><EncabezadoOrdenable Texto="Aplica a" /></HeaderTemplate>
                <CellTemplate>
                    <div class="d-flex align-center gap-2">
                        @if (context.Item.FLG_VENTA == true)
                        {
                            <MudTooltip Text="Venta"><MudIcon Icon="@Icons.Material.Filled.PointOfSale" Size="Size.Small" Color="Color.Primary" /></MudTooltip>
                        }
                        @if (context.Item.FLG_PRODUCCION == true)
                        {
                            <MudTooltip Text="Producción"><MudIcon Icon="@Icons.Material.Filled.Factory" Size="Size.Small" Color="Color.Primary" /></MudTooltip>
                        }
                        @if (!(context.Item.FLG_VENTA == true || context.Item.FLG_PRODUCCION == true))
                        {
                            <span style="opacity:.35;">—</span>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>

            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin registros.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="Modelo" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    private Func<Task>? _onCambio;
    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<Modelo> _items = new();
    private string _search = "";
    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;

    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }

    private List<Modelo> Ordenar(List<Modelo> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.COD_TIPO_RESERVA).ToList() : items.OrderByDescending(x => x.COD_TIPO_RESERVA).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_TIPO_RESERVA).ToList() : items.OrderByDescending(x => x.DES_TIPO_RESERVA).ToList(),
        _ => items
    };

    private List<Modelo> _visibles => Ordenar(Aplicar(_items, -1));
    private List<Modelo> Base(int col) => Aplicar(_items, col);

    private List<Modelo> Aplicar(List<Modelo> src, int ex)
    {
        IEnumerable<Modelo> q = src;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(x.COD_TIPO_RESERVA)),
                1 => q.Where(x => v.Contains(x.DES_TIPO_RESERVA)),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }

    // El SP _SEARCH de esta tabla arranca con "WHERE 1 = 1 OR (...)", así que ignora el texto
    // y devuelve todo igual: se filtra en memoria y no se lo llama.
    private Task Buscar() { StateHasChanged(); return Task.CompletedTask; }

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("LOGISTICA", "TiposReservaStock");
        await Load();
        _onCambio = async () => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        Cambios.Suscribir("LOGISTICA.TIPOS_RESERVA_STOCK", _onCambio);
        ShortcutSvc.NuevoRequested += OnAtajoNuevo;
    }

    private async void OnAtajoNuevo() => await InvokeAsync(() => Abrir(null, CrudModo.Create));

    private async Task Load()
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<Modelo>>>(
                ApiRoutes.Logistica.TiposReservaStock);
            var todos = r?.Data ?? new();
            _items = string.IsNullOrWhiteSpace(_search)
                ? todos
                : todos.Where(x => x.COD_TIPO_RESERVA.Contains(_search, StringComparison.OrdinalIgnoreCase)
                                || x.DES_TIPO_RESERVA.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(TiposReservaStock), nameof(Load));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            _items = new();
        }
    }

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create);
        return Task.CompletedTask;
    }

    private Task OnAccionGrilla(Modelo item, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_GET    == true) return Abrir(item, CrudModo.Read);
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        return Task.CompletedTask;
    }

    private async Task Abrir(Modelo? item, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nuevo registro",
            CrudModo.Delete => $"Eliminar · {item?.DES_TIPO_RESERVA}",
            CrudModo.Read   => $"Consultar · {item?.DES_TIPO_RESERVA}",
            _               => $"Editar · {item?.DES_TIPO_RESERVA}"
        };
        var dlg = await DialogService.ShowAsync<TiposReservaStockDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    public void Dispose()
    {
        Cambios.Desuscribir("LOGISTICA.TIPOS_RESERVA_STOCK", _onCambio ?? (() => Task.CompletedTask));
        ShortcutSvc.NuevoRequested -= OnAtajoNuevo;
    }
}
