@using TiposAlmacenModel = KONSolutions.Shared.Models.Logistica.TiposAlmacen
@using KONSolutions.Shared.Common
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <CrudDialogTitle Modo="Modo" Descripcion="@Item?.DES_TIPO_ALMACEN" />
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit" OnInvalidSubmit="OnInvalidSubmit">
            <DataAnnotationsValidator />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="4">
                    <CampoTexto Tabla="LOGISTICA.TIPOS_ALMACEN" Columna="COD_TIPO_ALMACEN"
                                @bind-Value="_model.COD_TIPO_ALMACEN"
                                Disabled="@(!_esNuevo || _readonly)" Obligatorio="@_esNuevo" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <CampoTexto Tabla="LOGISTICA.TIPOS_ALMACEN" Columna="DES_TIPO_ALMACEN"
                                @bind-Value="_model.DES_TIPO_ALMACEN"
                                Disabled="_readonly" Obligatorio="true" />
                </MudItem>
                <MudItem xs="12">
                    @* Los flags no son excluyentes: un tipo de almacén puede ser, por
                       ejemplo, de producción y de producto terminado a la vez. *@
                    <div class="pet-grupo-box mb-3">
                        <MudText Typo="Typo.subtitle2" Class="pet-grupo-titulo">Clasificación del Almacén</MudText>
                        <div class="d-flex flex-wrap" style="gap:8px 24px;">
                            @foreach (var s in _switches)
                            {
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@s.Icon" Size="Size.Small" Style="opacity:.6;" />
                                    <MudText Typo="Typo.body2">@s.Label</MudText>
                                    <MudSwitch T="bool?" Value="@s.Get()" ValueChanged="@s.Set" Color="Color.Primary" Disabled="_readonly" />
                                </div>
                            }
                        </div>
                    </div>
                </MudItem>
            </MudGrid>
            <CrudDialogActions Modo="Modo" Saving="_saving" OnCancel="@(() => MudDialog.Cancel())" />
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TiposAlmacenModel? Item { get; set; }
    [Parameter] public CrudModo Modo { get; set; } = CrudModo.Create;

    private TiposAlmacenModel _model = new();
    private bool _esNuevo, _saving;
    private bool _readonly => Modo == CrudModo.Read || Modo == CrudModo.Delete;

    private (string Icon, string Label, Func<bool?> Get, Action<bool?> Set)[] _switches => new (string, string, Func<bool?>, Action<bool?>)[]
    {
        (Icons.Material.Filled.Warehouse,     "Regular",            () => _model.FLG_REGULAR,            v => _model.FLG_REGULAR = v),
        (Icons.Material.Filled.LocalShipping, "Tránsito",           () => _model.FLG_TRANSITO,           v => _model.FLG_TRANSITO = v),
        (Icons.Material.Filled.Factory,       "Producción",         () => _model.FLG_PRODUCCION,         v => _model.FLG_PRODUCCION = v),
        (Icons.Material.Filled.Inventory2,    "Producto terminado", () => _model.FLG_PRODUCTO_TERMINADO, v => _model.FLG_PRODUCTO_TERMINADO = v),
    };

    protected override async Task OnInitializedAsync()
    {
        _esNuevo = Modo == CrudModo.Create;
        if (Item is not null) MapearDesdeModelo(Item);
        if (!_esNuevo && Item is not null) await RecargarDesdeShowbyidAsync();
    }

    private void MapearDesdeModelo(TiposAlmacenModel m)
    {
        _model = new TiposAlmacenModel
        {
            COD_TIPO_ALMACEN       = m.COD_TIPO_ALMACEN,
            DES_TIPO_ALMACEN       = m.DES_TIPO_ALMACEN,
            FLG_REGULAR            = m.FLG_REGULAR,
            FLG_TRANSITO           = m.FLG_TRANSITO,
            FLG_PRODUCCION         = m.FLG_PRODUCCION,
            FLG_PRODUCTO_TERMINADO = m.FLG_PRODUCTO_TERMINADO
        };
    }

    /// <summary>Trae el registro fresco desde SHOWBYID — evita mostrar datos desactualizados
    /// de la grilla al Modificar/Eliminar/Ver.</summary>
    private async Task RecargarDesdeShowbyidAsync()
    {
        var fresco = await Http.SafeGetAsync<TiposAlmacenModel>(
            $"{ApiRoutes.Logistica.TiposAlmacen}/{Uri.EscapeDataString(_model.COD_TIPO_ALMACEN)}");
        if (fresco is not null) MapearDesdeModelo(fresco);
    }

    private async Task OnInvalidSubmit(EditContext ctx)
    {
        var errores = string.Join(" · ", ctx.GetValidationMessages());
        await DialogService.ShowAsync<KONSolutions.Web.Pages.Shared.ErrorSqlDialog>("",
            new DialogParameters
            {
                ["Titulo"]  = "Faltan datos obligatorios",
                ["Mensaje"] = string.IsNullOrWhiteSpace(errores) ? "Hay campos obligatorios sin completar." : errores
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = false, BackdropClick = false, CloseOnEscapeKey = false });
    }

    private async Task Submit()
    {
        _saving = true;
        var ruta = ApiRoutes.Logistica.TiposAlmacen;
        if (Modo == CrudModo.Delete)
        {
            var rd = await Http.DeleteAsync($"{ruta}/{Uri.EscapeDataString(_model.COD_TIPO_ALMACEN)}");
            _saving = false;
            if (rd.IsSuccessStatusCode) { Snackbar.Add("Eliminado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
            else await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(TiposAlmacenDialog), nameof(Submit), "No se pudo eliminar el registro");
            return;
        }

        // El verbo lo elige el modo del diálogo, no el servidor: _INSERT sólo da de alta y
        // _UPDATE sólo modifica, así que mandar POST para editar fallaría con "ya existe".
        var resp = await Http.GuardarAsync(ruta, _model, _esNuevo);
        _saving = false;
        if (resp.IsSuccessStatusCode) { Snackbar.Add(_esNuevo ? "Creado." : "Modificado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(TiposAlmacenDialog), nameof(Submit));
    }
}
