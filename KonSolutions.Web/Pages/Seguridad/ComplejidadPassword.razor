@page "/seguridad/complejidad-password"
@attribute [Authorize]
@inject CatalogoService<ComplejidadPwd, ComplejidadPwdDto> Service
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@inject ConfigService ConfigSvc
@implements IDisposable

<PageTitle>Complejidad de contraseña · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Complejidad de contraseña" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Reglas de validación de contraseñas · @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_searchTerm" OnSearch="HandleSearch" Placeholder="Buscar regla..." DebounceInterval="450" MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f => f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <GridPrintButton Titulo="Complejidad de contraseña" Headers="@_printHeaders" Rows="@PrintRows()" />
        <AccionesBotones CodAplicacion="@CodAplicacion"
                         CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header"
                         OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="complejidad-password" style="position:relative;">
    <MudDataGrid T="ComplejidadPwd" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Sortable="false" Title="Código" Width="@Limites.ColWidth("SEGURIDAD.PASSWORD_COMPLEJIDAD","COD_PASSWORD_COMPLEJIDAD",60,150)" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1">
                        <EncabezadoOrdenable Campo="COD_PASSWORD_COMPLEJIDAD" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="ComplejidadPwd" ItemsBase="@BaseSinEstaColumna(0)"
                                            ValorDe="@(x => x.COD_PASSWORD_COMPLEJIDAD ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)"
                                            ValoresActivosChanged="@(v => AplicarFiltro(0, v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.COD_PASSWORD_COMPLEJIDAD</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Descripción" Width="@Limites.ColWidth("SEGURIDAD.PASSWORD_COMPLEJIDAD","DES_PASSWORD_COMPLEJIDAD",120,350)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1">
                        <EncabezadoOrdenable Campo="DES_PASSWORD_COMPLEJIDAD" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="ComplejidadPwd" ItemsBase="@BaseSinEstaColumna(1)"
                                            ValorDe="@(x => x.DES_PASSWORD_COMPLEJIDAD ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)"
                                            ValoresActivosChanged="@(v => AplicarFiltro(1, v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_PASSWORD_COMPLEJIDAD</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Mín">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1">
                        <EncabezadoOrdenable Campo="CAN_CARACTERES_MINIMO" Activo="@(_ordenColumna == 2)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(2))" />
                        <FiltroExcelColumna T="ComplejidadPwd" ItemsBase="@BaseSinEstaColumna(2)"
                                            ValorDe="@(x => x.CAN_CARACTERES_MINIMO?.ToString() ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(2)"
                                            ValoresActivosChanged="@(v => AplicarFiltro(2, v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.CAN_CARACTERES_MINIMO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Máx">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1">
                        <EncabezadoOrdenable Campo="CAN_CARACTERES_MAXIMO" Activo="@(_ordenColumna == 3)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(3))" />
                        <FiltroExcelColumna T="ComplejidadPwd" ItemsBase="@BaseSinEstaColumna(3)"
                                            ValorDe="@(x => x.CAN_CARACTERES_MAXIMO?.ToString() ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(3)"
                                            ValoresActivosChanged="@(v => AplicarFiltro(3, v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.CAN_CARACTERES_MAXIMO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Exige" Sortable="false">
                <CellTemplate>
                    @if (!string.IsNullOrWhiteSpace(context.Item.DES_CARACTERES_LETRAS_MAYUSCULAS)) { <MudChip T="string" Size="Size.Small">A-Z</MudChip> }
                    @if (!string.IsNullOrWhiteSpace(context.Item.DES_CARACTERES_LETRAS_MINUSCULAS)) { <MudChip T="string" Size="Size.Small">a-z</MudChip> }
                    @if (!string.IsNullOrWhiteSpace(context.Item.DES_CARACTERES_NUMERICOS)) { <MudChip T="string" Size="Size.Small">0-9</MudChip> }
                    @if (!string.IsNullOrWhiteSpace(context.Item.DES_CARACTERES_ESPECIALES)) { <MudChip T="string" Size="Size.Small">esp</MudChip> }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion"
                                     CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla"
                                     OnAccion="@(b => OnAccionGrilla(item, b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin reglas de complejidad.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="ComplejidadPwd" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    [Parameter] public string CodAplicacion { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<ComplejidadPwd> _items = new();
    private string _searchTerm = string.Empty;
    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;
    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }
    private List<ComplejidadPwd> Ordenar(List<ComplejidadPwd> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.COD_PASSWORD_COMPLEJIDAD).ToList() : items.OrderByDescending(x => x.COD_PASSWORD_COMPLEJIDAD).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_PASSWORD_COMPLEJIDAD).ToList() : items.OrderByDescending(x => x.DES_PASSWORD_COMPLEJIDAD).ToList(),
        2 => _ordenAscendente ? items.OrderBy(x => x.CAN_CARACTERES_MINIMO).ToList() : items.OrderByDescending(x => x.CAN_CARACTERES_MINIMO).ToList(),
        3 => _ordenAscendente ? items.OrderBy(x => x.CAN_CARACTERES_MAXIMO).ToList() : items.OrderByDescending(x => x.CAN_CARACTERES_MAXIMO).ToList(),
        _ => items
    };

    private List<ComplejidadPwd> _visibles => Ordenar(AplicarTodos(_items, -1));
    private List<ComplejidadPwd> BaseSinEstaColumna(int col) => AplicarTodos(_items, col);

    private List<ComplejidadPwd> AplicarTodos(List<ComplejidadPwd> origen, int excluir)
    {
        IEnumerable<ComplejidadPwd> q = origen;
        foreach (var (col, vals) in _filtros)
        {
            if (col == excluir || vals is null) continue;
            q = col switch
            {
                0 => q.Where(x => vals.Contains(x.COD_PASSWORD_COMPLEJIDAD ?? "")),
                1 => q.Where(x => vals.Contains(x.DES_PASSWORD_COMPLEJIDAD ?? "")),
                2 => q.Where(x => vals.Contains(x.CAN_CARACTERES_MINIMO?.ToString() ?? "")),
                3 => q.Where(x => vals.Contains(x.CAN_CARACTERES_MAXIMO?.ToString() ?? "")),
                _ => q
            };
        }
        return q.ToList();
    }

    private void AplicarFiltro(int col, HashSet<string>? vals) { _filtros[col] = vals; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }

    private readonly List<string> _printHeaders = new() { "Código", "Descripción", "Mín", "Máx" };
    private List<List<string>> PrintRows() => _items.Select(c => new List<string> { c.COD_PASSWORD_COMPLEJIDAD ?? "", c.DES_PASSWORD_COMPLEJIDAD ?? "", c.CAN_CARACTERES_MINIMO?.ToString() ?? "", c.CAN_CARACTERES_MAXIMO?.ToString() ?? "" }).ToList();

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("SEGURIDAD", "ComplejidadPassword");
        await Load();
        Cambios.Suscribir("SEGURIDAD.COMPLEJIDAD_PASSWORD", RefrescarPorCambio);
    }

    private async Task HandleSearch()
    {
        _items = string.IsNullOrWhiteSpace(_searchTerm)
            ? await Service.GetAllAsync()
            : await Service.SearchAsync(_searchTerm);
    }

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Open(null);
        return Task.CompletedTask;
    }

    private Task OnAccionGrilla(ComplejidadPwd item, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_GET    == true) return Ver(item);
        if (b.FLG_ACCION_PUT    == true) return Open(item);
        if (b.FLG_ACCION_DELETE == true) return Delete(item);
        return Task.CompletedTask;
    }

    private async Task Ver(ComplejidadPwd item) => await AbrirDialog(item, CrudModo.Read);
    private async Task Load() => _items = await Service.GetAllAsync();
    private async Task Open(ComplejidadPwd? c) => await AbrirDialog(c, c is null ? CrudModo.Create : CrudModo.Update);
    private async Task Delete(ComplejidadPwd c) => await AbrirDialog(c, CrudModo.Delete);

    private async Task AbrirDialog(ComplejidadPwd? c, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nuevo registro",
            CrudModo.Read   => $"Ver · {c?.COD_PASSWORD_COMPLEJIDAD}",
            CrudModo.Update => $"Editar · {c?.COD_PASSWORD_COMPLEJIDAD}",
            CrudModo.Delete => $"Eliminar · {c?.COD_PASSWORD_COMPLEJIDAD}",
            _ => "Registro"
        };
        var parameters = new DialogParameters { ["Item"] = c, ["Modo"] = modo };
        var dlg = await DialogService.ShowAsync<ComplejidadDialog>(titulo, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        var result = await dlg.Result;
        if (result is not null && !result.Canceled) await Load();
    }

    private async Task RefrescarPorCambio() => await InvokeAsync(async () => { await Load(); StateHasChanged(); });

    public void Dispose() => Cambios.Desuscribir("SEGURIDAD.COMPLEJIDAD_PASSWORD", RefrescarPorCambio);
}
