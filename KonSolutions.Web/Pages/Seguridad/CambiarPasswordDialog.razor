@*
    CambiarPasswordDialog.razor
    --------------------------------------------------------------------------
    Diálogo para cambiar la contraseña de un usuario.
    - Valida que la nueva contraseña y su confirmación coincidan.
    - Valida contra la regla de complejidad del perfil (si existe).
    - Llama a UsuarioService.CambiarPasswordAsync (POST /seguridad/usuarios/password).
    Si Obligatorio=true (cambio forzado en login), no se puede cancelar.
*@
@inject UsuarioService UsuarioService
@inject PasswordPolicyService PasswordPolicy
@inject MenuService MenuService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudDialog>
    <DialogContent>
        <MudText Class="mono mb-4" Style="opacity:.7;font-size:.85rem;">
            Usuario: <strong>@CodUsuario</strong>
        </MudText>

        @if (_regla is not null)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                <MudText Typo="Typo.caption">
                    <strong>@_regla.DES_PASSWORD_COMPLEJIDAD</strong><br/>
                    Entre @_regla.CAN_CARACTERES_MINIMO y @_regla.CAN_CARACTERES_MAXIMO caracteres.
                    @if (!string.IsNullOrWhiteSpace(_regla.DES_CARACTERES_LETRAS_MAYUSCULAS)) { <text>· Mayúsculas </text> }
                    @if (!string.IsNullOrWhiteSpace(_regla.DES_CARACTERES_LETRAS_MINUSCULAS)) { <text>· Minúsculas </text> }
                    @if (!string.IsNullOrWhiteSpace(_regla.DES_CARACTERES_NUMERICOS)) { <text>· Números </text> }
                    @if (!string.IsNullOrWhiteSpace(_regla.DES_CARACTERES_ESPECIALES)) { <text>· Especiales </text> }
                </MudText>
            </MudAlert>
        }

        <MudTextField Value="_model.COD_PASSWORD" Label="Nueva contraseña"
                      Variant="Variant.Outlined" InputType="@(_verPassword ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_verPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => _verPassword = !_verPassword)"
                      Immediate="true" Class="mb-3"
                      ValueChanged="@((string v) => OnPasswordChanged(v))" T="string" />
        <CampoTextoEstable @bind-Value="_confirmar" Label="Confirmar contraseña"
                      Variant="Variant.Outlined" InputType="@(_verConfirmar ? InputType.Text : InputType.Password)"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_verConfirmar ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="@(() => _verConfirmar = !_verConfirmar)"
                      Immediate="true"
                      Error="_noCoincide" ErrorText="Las contraseñas no coinciden" Class="mb-2" />

        @* Validación en tiempo real de los requisitos de complejidad *@
        @if (_regla is not null && !string.IsNullOrEmpty(_model.COD_PASSWORD))
        {
            <MudPaper Elevation="0" Class="pa-3 mb-2" Style="border:1px solid var(--line);">
                <MudText Typo="Typo.caption" Class="mono mb-1" Style="opacity:.6;">REQUISITOS</MudText>
                @foreach (var (texto, cumple) in _checks)
                {
                    <div class="d-flex align-center gap-2" style="@($"color:{(cumple ? "#2e7d32" : "#b71c1c")};")">
                        <MudIcon Icon="@(cumple ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)" Size="Size.Small" />
                        <MudText Typo="Typo.caption">@texto</MudText>
                    </div>
                }
            </MudPaper>
        }

        @if (_errores.Any())
        {
            <MudList T="string" Dense="true">
                @foreach (var e in _errores)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Error" IconColor="Color.Error">
                        <MudText Typo="Typo.caption">@e</MudText>
                    </MudListItem>
                }
            </MudList>
        }

        <div class="d-flex justify-end gap-2 mt-4 dialog-acciones-fijas">
            @if (!Obligatorio)
            {
                <MudButton OnClick="@(async () => { try { await JS.InvokeVoidAsync("dialogAnim.cerrar"); } catch { } MudDialog.Cancel(); })"
                           Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Cancel"
                           Style="background-color:var(--boton-forecolor,var(--paper));color:var(--boton-backcolor,var(--ink));">Cancelar</MudButton>
            }
            <MudButton OnClick="Submit" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Password"
                       Disabled="_saving" Style="font-weight:700;background-color:var(--boton-backcolor,var(--ink));color:var(--boton-forecolor,var(--paper));">
                @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Cambiar
            </MudButton>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string CodUsuario { get; set; } = string.Empty;
    [Parameter] public string? CodComplejidad { get; set; }
    [Parameter] public bool Obligatorio { get; set; }   // true = no se puede cancelar (cambio forzado en login)

    private CambiarPasswordRequest _model = new();
    private string _confirmar = string.Empty;
    private bool _noCoincide, _saving;
    private bool _verPassword, _verConfirmar;   // Ver/ocultar contraseña
    private List<string> _errores = new();
    private List<(string texto, bool cumple)> _checks = new();   // Validación en tiempo real
    private ComplejidadPwd? _regla;

    /// <summary>Recalcula los requisitos de complejidad conforme el usuario escribe.</summary>
    private void OnPasswordChanged(string valor)
    {
        _model.COD_PASSWORD = valor;
        if (_regla is null) return;

        _checks.Clear();
        var pwd = valor ?? "";

        // Longitud mínima/máxima
        if (_regla.CAN_CARACTERES_MINIMO is int min)
            _checks.Add(($"Mínimo {min} caracteres", pwd.Length >= min));
        if (_regla.CAN_CARACTERES_MAXIMO is int max)
            _checks.Add(($"Máximo {max} caracteres", pwd.Length <= max));
        // Tipos de caracteres requeridos
        if (!string.IsNullOrWhiteSpace(_regla.DES_CARACTERES_LETRAS_MAYUSCULAS))
            _checks.Add(("Al menos una mayúscula", pwd.Any(char.IsUpper)));
        if (!string.IsNullOrWhiteSpace(_regla.DES_CARACTERES_LETRAS_MINUSCULAS))
            _checks.Add(("Al menos una minúscula", pwd.Any(char.IsLower)));
        if (!string.IsNullOrWhiteSpace(_regla.DES_CARACTERES_NUMERICOS))
            _checks.Add(("Al menos un número", pwd.Any(char.IsDigit)));
        if (!string.IsNullOrWhiteSpace(_regla.DES_CARACTERES_ESPECIALES))
        {
            var set = _regla.DES_CARACTERES_ESPECIALES;
            _checks.Add(("Al menos un carácter especial", pwd.Any(c => set.Contains(c))));
        }
    }

    /// <summary>Carga la regla de complejidad del perfil (si tiene una asignada).</summary>
    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(CodComplejidad))
            _regla = await PasswordPolicy.GetReglaAsync(CodComplejidad);
    }

    /// <summary>
    /// Valida y graba la nueva contraseña. Muestra mensajes claros en cada
    /// validación para que el usuario sepa por qué no avanza.
    /// </summary>
    private async Task Submit()
    {
        // 1. Campos vacíos
        if (string.IsNullOrWhiteSpace(_model.COD_PASSWORD))
        {
            Snackbar.Add("Ingrese la nueva contraseña.", Severity.Warning);
            return;
        }

        // 2. Coincidencia
        _noCoincide = _model.COD_PASSWORD != _confirmar;
        if (_noCoincide)
        {
            Snackbar.Add("Las contraseñas no coinciden.", Severity.Warning);
            return;
        }

        // 3. Complejidad (si el perfil define una)
        _errores.Clear();
        if (_regla is not null)
            _errores = PasswordPolicy.Validar(_model.COD_PASSWORD, _regla);
        if (_errores.Any())
        {
            Snackbar.Add("La contraseña no cumple los requisitos de complejidad.", Severity.Warning);
            return;
        }

        // 4. Grabar vía API
        _model.COD_USUARIO = CodUsuario;
        _model.COD_ROL_USUARIO_ACTIVO = MenuService.RolActivo;
        _saving = true;
        var (ok, msg) = await UsuarioService.CambiarPasswordAsync(_model);
        _saving = false;
        if (ok)
        {
            Snackbar.Add("Contraseña actualizada.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add($"No se pudo cambiar la contraseña: {msg}", Severity.Error);
        }
    }
}
