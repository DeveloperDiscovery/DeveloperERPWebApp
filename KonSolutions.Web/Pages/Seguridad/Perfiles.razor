@page "/seguridad/perfiles"
@attribute [Authorize]
@inject CatalogoService<Perfil, PerfilDto> Service
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@inject ConfigService ConfigSvc
@implements IDisposable

<PageTitle>Perfiles · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Perfiles de usuario" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema SEGURIDAD · @_itemsVisibles.Count de @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_searchTerm" OnSearch="HandleSearch" Placeholder="Buscar perfil..." DebounceInterval="450" MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros"
                            HasFilters="@(_filtros.Any(f => f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <GridPrintButton Titulo="Perfiles de usuario" Headers="@_printHeaders" Rows="@PrintRows()" />
        <AccionesBotones CodAplicacion="@CodAplicacion"
                         CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header"
                         OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="perfiles" style="position:relative;">
    <MudDataGrid T="Perfil" Items="_itemsVisibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Title="Icono" Sortable="false" Filterable="false" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <CellTemplate><GridImage Image="context.Item.IMG_ICONO" /></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Código" SortBy="x => x.COD_PERFIL_USUARIO" Width="@Limites.ColWidth("SEGURIDAD.PERFILES_USUARIO","COD_PERFIL_USUARIO",60,150)" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1">
                        <EncabezadoOrdenable Campo="COD_PERFIL_USUARIO" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="Perfil" ItemsBase="@BaseSinEstaColumna(0)"
                                            ValorDe="@(p => p.COD_PERFIL_USUARIO)"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)"
                                            ValoresActivosChanged="@(v => AplicarFiltro(0, v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.COD_PERFIL_USUARIO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Descripción" SortBy="x => x.DES_PERFIL_USUARIO" Width="@Limites.ColWidth("SEGURIDAD.PERFILES_USUARIO","DES_PERFIL_USUARIO",120,350)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1">
                        <EncabezadoOrdenable Campo="DES_PERFIL_USUARIO" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="Perfil" ItemsBase="@BaseSinEstaColumna(1)"
                                            ValorDe="@(p => p.DES_PERFIL_USUARIO)"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)"
                                            ValoresActivosChanged="@(v => AplicarFiltro(1, v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_PERFIL_USUARIO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Complejidad" SortBy="x => x.DES_PASSWORD_COMPLEJIDAD">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1">
                        <EncabezadoOrdenable Campo="DES_PASSWORD_COMPLEJIDAD" Activo="@(_ordenColumna == 2)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(2))" />
                        <FiltroExcelColumna T="Perfil" ItemsBase="@BaseSinEstaColumna(2)"
                                            ValorDe="@(p => p.DES_PASSWORD_COMPLEJIDAD)"
                                            ValoresActivos="_filtros.GetValueOrDefault(2)"
                                            ValoresActivosChanged="@(v => AplicarFiltro(2, v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_PASSWORD_COMPLEJIDAD</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Permisos y Atributos" Sortable="false" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <CellTemplate>
                    <div class="d-flex align-center justify-center gap-2">
                        <MudTooltip Text="Developer">
                            <MudIcon Icon="@Icons.Material.Filled.Code" Color="@(context.Item.FLG_DEVELOPER ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_DEVELOPER ? "" : "opacity:.15;")" Size="Size.Small" />
                        </MudTooltip>
                        <MudTooltip Text="Admin">
                            <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Color="@(context.Item.FLG_ADMINISTRADOR ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_ADMINISTRADOR ? "" : "opacity:.15;")" Size="Size.Small" />
                        </MudTooltip>
                        <MudTooltip Text="Seguridad">
                            <MudIcon Icon="@Icons.Material.Filled.Security" Color="@(context.Item.FLG_SEGURIDAD ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_SEGURIDAD ? "" : "opacity:.15;")" Size="Size.Small" />
                        </MudTooltip>
                        <MudTooltip Text="Auditoría">
                            <MudIcon Icon="@Icons.Material.Filled.FactCheck" Color="@(context.Item.FLG_AUDITORIA ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_AUDITORIA ? "" : "opacity:.15;")" Size="Size.Small" />
                        </MudTooltip>
                        <MudTooltip Text="Comercial">
                            <MudIcon Icon="@Icons.Material.Filled.Storefront" Color="@(context.Item.FLG_COMERCIAL ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_COMERCIAL ? "" : "opacity:.15;")" Size="Size.Small" />
                        </MudTooltip>
                        <MudTooltip Text="Dependencia Comercial">
                            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="@(context.Item.FLG_DEPENDENCIA_COMERCIAL ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_DEPENDENCIA_COMERCIAL ? "" : "opacity:.15;")" Size="Size.Small" />
                        </MudTooltip>
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Estado" SortBy="x => x.DES_ESTADO">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1">
                        <EncabezadoOrdenable Campo="DES_ESTADO" Activo="@(_ordenColumna == 7)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(7))" />
                        <FiltroExcelColumna T="Perfil" ItemsBase="@BaseSinEstaColumna(7)"
                                            ValorDe="@(p => p.DES_ESTADO)"
                                            ValoresActivos="_filtros.GetValueOrDefault(7)"
                                            ValoresActivosChanged="@(v => AplicarFiltro(7, v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>
                    <MudChip T="string" Size="Size.Small"
                             Color="@(context.Item.COD_ESTADO == 1 ? Color.Success : Color.Default)">
                        @(context.Item.DES_ESTADO ?? "—")
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion"
                                     CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla"
                                     OnAccion="@(b => OnAccionGrilla(item, b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin perfiles.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="Perfil" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    [Parameter] public string CodAplicacion { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<Perfil> _items = new();
    private readonly List<string> _printHeaders = new() { "Código", "Descripción", "Complejidad", "Developer", "Admin", "Estado" };
    private List<List<string>> PrintRows() => _items.Select(p => new List<string> { p.COD_PERFIL_USUARIO ?? "", p.DES_PERFIL_USUARIO ?? "", p.DES_PASSWORD_COMPLEJIDAD ?? "", p.FLG_DEVELOPER ? "Sí":"No", p.FLG_ADMINISTRADOR ? "Sí":"No", p.DES_ESTADO ?? "" }).ToList();
    private string _searchTerm = string.Empty;

    // ── Filtro Excel en cascada ──
    // 0=Código, 1=Descripción, 2=Complejidad, 7=Estado
    private readonly Dictionary<int, HashSet<string>?> _filtros = new();

    private List<Perfil> _itemsVisibles => Ordenar(AplicarTodos(_items, excluirColumna: -1));
    private List<Perfil> BaseSinEstaColumna(int columna) => AplicarTodos(_items, columna);

    // ── Ordenamiento manual (clic en el título de columna) ──
    private int? _ordenColumna;
    private bool _ordenAscendente = true;

    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }

    private List<Perfil> Ordenar(List<Perfil> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(p => p.COD_PERFIL_USUARIO).ToList() : items.OrderByDescending(p => p.COD_PERFIL_USUARIO).ToList(),
        1 => _ordenAscendente ? items.OrderBy(p => p.DES_PERFIL_USUARIO).ToList() : items.OrderByDescending(p => p.DES_PERFIL_USUARIO).ToList(),
        2 => _ordenAscendente ? items.OrderBy(p => p.DES_PASSWORD_COMPLEJIDAD).ToList() : items.OrderByDescending(p => p.DES_PASSWORD_COMPLEJIDAD).ToList(),
        7 => _ordenAscendente ? items.OrderBy(p => p.DES_ESTADO).ToList() : items.OrderByDescending(p => p.DES_ESTADO).ToList(),
        _ => items
    };

    private List<Perfil> AplicarTodos(List<Perfil> origen, int excluirColumna)
    {
        IEnumerable<Perfil> q = origen;
        foreach (var (col, valores) in _filtros)
        {
            if (col == excluirColumna || valores is null) continue;
            q = col switch
            {
                0 => q.Where(p => valores.Contains(p.COD_PERFIL_USUARIO ?? "")),
                1 => q.Where(p => valores.Contains(p.DES_PERFIL_USUARIO ?? "")),
                2 => q.Where(p => valores.Contains(p.DES_PASSWORD_COMPLEJIDAD ?? "")),
                7 => q.Where(p => valores.Contains(p.DES_ESTADO ?? "")),
                _ => q
            };
        }
        return q.ToList();
    }

    private void AplicarFiltro(int columna, HashSet<string>? valores)
    {
        _filtros[columna] = valores;
        StateHasChanged();
    }

    private void LimpiarFiltros()
    {
        foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null;
        StateHasChanged();
    }

    private async Task HandleSearch()
    {
        _items = string.IsNullOrWhiteSpace(_searchTerm)
            ? await Service.GetAllAsync()
            : await Service.SearchAsync(_searchTerm);
    }

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("SEGURIDAD", "Perfiles");
        await Load();
        Cambios.Suscribir("SEGURIDAD.PERFILES_USUARIO", RefrescarPorCambio);
    }

    // ── Seguridad dinámica ──────────────────────────────────────────────────
    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Open(null);
        return Task.CompletedTask;
    }

    private Task OnAccionGrilla(Perfil item, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_GET    == true) return Ver(item);
        if (b.FLG_ACCION_PUT    == true) return Open(item);
        if (b.FLG_ACCION_DELETE == true) return Delete(item);
        return Task.CompletedTask;
    }

    // ── Acciones ────────────────────────────────────────────────────────────
    private async Task Ver(Perfil item) => await AbrirDialog(item, CrudModo.Read);

    private async Task Load() => _items = await Service.GetAllAsync();

    private async Task Open(Perfil? p) => await AbrirDialog(p, p is null ? CrudModo.Create : CrudModo.Update);

    private async Task Delete(Perfil p) => await AbrirDialog(p, CrudModo.Delete);

    private async Task AbrirDialog(Perfil? p, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nuevo registro",
            CrudModo.Read   => $"Ver · {p?.COD_PERFIL_USUARIO}",
            CrudModo.Update => $"Editar · {p?.COD_PERFIL_USUARIO}",
            CrudModo.Delete => $"Eliminar · {p?.COD_PERFIL_USUARIO}",
            _ => "Registro"
        };
        var parameters = new DialogParameters { ["Perfil"] = p, ["Modo"] = modo };
        var dlg = await DialogService.ShowAsync<PerfilDialog>(titulo, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, BackdropClick = false, CloseOnEscapeKey = false });
        var result = await dlg.Result;
        if (result is not null && !result.Canceled) await Load();
    }

    private async Task RefrescarPorCambio() => await InvokeAsync(async () => { await Load(); StateHasChanged(); });

    public void Dispose() => Cambios.Desuscribir("SEGURIDAD.PERFILES_USUARIO", RefrescarPorCambio);
}
