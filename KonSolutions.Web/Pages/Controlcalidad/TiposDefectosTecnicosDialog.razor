@using TiposDefectosTecnicosModel = KONSolutions.Shared.Models.Controlcalidad.TiposDefectosTecnicos
@using TiposDefectosTecnicosRoute = KONSolutions.Web.Services.ApiRoutes.Controlcalidad
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <CrudDialogTitle Modo="Modo" Descripcion="@Item?.DES_DEFECTO_TECNICO" />
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <AriaCombo TItem="ComboboxItem" Items="_clases"
                       TextFunc="@(c => $"{c.Id} - {c.Texto}")" ValueFunc="@(c => c.Id)"
                       @bind-Value="_model.COD_CLASE_DEFECTO_TECNICO"
                       Label="Clase de Defecto Técnico" Disabled="@(!_esNuevo || _readonly)" />
            <CampoTexto Tabla="CONTROLCALIDAD.TIPOS_DEFECTOS_TECNICOS" Columna="COD_TIPO_DEFECTO_TECNICO"
                        @bind-Value="_model.COD_TIPO_DEFECTO_TECNICO"
                        Disabled="@(!_esNuevo || _readonly)" Obligatorio="@_esNuevo" />
            <CampoTexto Tabla="CONTROLCALIDAD.TIPOS_DEFECTOS_TECNICOS" Columna="DES_DEFECTO_TECNICO"
                        @bind-Value="_model.DES_DEFECTO_TECNICO"
                        Disabled="_readonly" Obligatorio="true" />
            <div class="d-flex align-center justify-space-between py-1 mb-2">
                <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Size="Size.Medium" /><MudText Typo="Typo.body2">Requiere Observación</MudText></div>
                <MudSwitch T="bool?" @bind-Value="_model.FLG_OBSERVACION" Color="Color.Primary" Disabled="_readonly" />
            </div>
            <EstadoCombo DesTabla="CONTROLCALIDAD.TIPOS_DEFECTOS_TECNICOS"
                         @bind-Value="_model.COD_ESTADO"
                         CodTipoEstadoChanged="@(v => _model.COD_TIPO_ESTADO = v)"
                         Disabled="_readonly" Class="mb-3" />
            <CrudDialogActions Modo="Modo" Saving="_saving"
                               OnCancel="@(() => MudDialog.Cancel())">
                <LeftContent>
                    <PanelAuditoria CodUsuarioRegistro="@Item?.COD_USUARIO_REGISTRO"
                                    CodEstacionRegistro="@Item?.COD_ESTACION_REGISTRO"
                                    FecRegistro="@Item?.FEC_REGISTRO"
                                    CodUsuarioActualizacion="@Item?.COD_USUARIO_ACTUALIZACION"
                                    CodEstacionActualizacion="@Item?.COD_ESTACION_ACTUALIZACION"
                                    FecActualizacion="@Item?.FEC_ACTUALIZACION" />
                </LeftContent>
            </CrudDialogActions>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TiposDefectosTecnicosModel? Item { get; set; }
    [Parameter] public CrudModo Modo { get; set; } = CrudModo.Create;

    private TiposDefectosTecnicosModel _model = new();
    private bool _esNuevo, _saving;
    private bool _readonly => Modo == CrudModo.Read || Modo == CrudModo.Delete;

    private List<ComboboxItem> _clases = new();

    protected override void OnInitialized()
    {
        _esNuevo = Modo == CrudModo.Create;
        if (Item is not null) MapearDesdeModelo(Item);
    }

    private void MapearDesdeModelo(TiposDefectosTecnicosModel m)
    {
        _model = new TiposDefectosTecnicosModel
        {
            COD_CLASE_DEFECTO_TECNICO = m.COD_CLASE_DEFECTO_TECNICO,
            COD_TIPO_DEFECTO_TECNICO  = m.COD_TIPO_DEFECTO_TECNICO,
            DES_DEFECTO_TECNICO       = m.DES_DEFECTO_TECNICO,
            FLG_OBSERVACION           = m.FLG_OBSERVACION,
            COD_TIPO_ESTADO           = m.COD_TIPO_ESTADO,
            COD_ESTADO                = m.COD_ESTADO,
        };
    }

    private async Task RecargarDesdeShowbyidAsync()
    {
        try
        {
            var url = $"{TiposDefectosTecnicosRoute.TiposDefectosTecnicos}/{Uri.EscapeDataString(_model.COD_CLASE_DEFECTO_TECNICO)}/{Uri.EscapeDataString(_model.COD_TIPO_DEFECTO_TECNICO)}";
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<TiposDefectosTecnicosModel>>(url);
            if (r?.Data is not null) MapearDesdeModelo(r.Data);
        }
        catch { }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!_esNuevo && Item is not null) await RecargarDesdeShowbyidAsync();

        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<ComboboxItem>>>(
                TiposDefectosTecnicosRoute.ClasesDefectosTecnicosCombobox);
            _clases = r?.Data ?? new();
        }
        catch { _clases = new(); }
    }

    private async Task Submit()
    {
        _saving = true;
        var ruta = TiposDefectosTecnicosRoute.TiposDefectosTecnicos;
        if (Modo == CrudModo.Delete)
        {
            var rd = await Http.DeleteAsync(
                $"{ruta}/{Uri.EscapeDataString(_model.COD_CLASE_DEFECTO_TECNICO)}/{Uri.EscapeDataString(_model.COD_TIPO_DEFECTO_TECNICO)}");
            _saving = false;
            if (rd.IsSuccessStatusCode) { Snackbar.Add("Eliminado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
            else await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(TiposDefectosTecnicosDialog), nameof(Submit), "No se pudo eliminar el registro");
            return;
        }
        var dto = new { _model.COD_CLASE_DEFECTO_TECNICO, _model.COD_TIPO_DEFECTO_TECNICO, _model.DES_DEFECTO_TECNICO,
                        _model.FLG_OBSERVACION, _model.COD_TIPO_ESTADO, _model.COD_ESTADO };
        var resp = await Http.GuardarAsync(ruta, dto, _esNuevo);
        _saving = false;
        if (resp.IsSuccessStatusCode) { Snackbar.Add(_esNuevo ? "Creado." : "Modificado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(TiposDefectosTecnicosDialog), nameof(Submit));
    }
}
