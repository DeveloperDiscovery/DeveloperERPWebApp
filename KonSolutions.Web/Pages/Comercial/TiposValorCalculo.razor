@page "/comercial/tipos-valor-calculo"
@attribute [Authorize]
@using TiposValorCalculoModel = KONSolutions.Shared.Models.Comercial.TiposValorCalculo
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject ShortcutService ShortcutSvc
@implements IDisposable
@inject ErrorLogService ErrorLog

<PageTitle>Tipos de Valor de Cálculo · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Tipos de Valor de Cálculo" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema COMERCIAL · @_visibles.Count de @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="Buscar" Placeholder="Buscar tipo de valor de cálculo..." DebounceInterval="400" MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f=>f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="tipos-valor-calculo" style="position:relative;">
    <MudDataGrid T="TiposValorCalculoModel" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Title="Código" Sortable="false" Width="100">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_TIPO_VALOR_CALCULO" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="TiposValorCalculoModel" ItemsBase="@Base(0)" ValorDe="@(x=>x.COD_TIPO_VALOR_CALCULO)"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.COD_TIPO_VALOR_CALCULO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Descripción" Sortable="false">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_TIPO_VALOR_CALCULO" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="TiposValorCalculoModel" ItemsBase="@Base(1)" ValorDe="@(x=>x.DES_TIPO_VALOR_CALCULO)"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_TIPO_VALOR_CALCULO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Tipo de impuesto" Sortable="false" Width="180">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_TIPO_IMPUESTO" Activo="@(_ordenColumna == 2)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(2))" />
                        <FiltroExcelColumna T="TiposValorCalculoModel" ItemsBase="@Base(2)" ValorDe="@(x=>x.DES_TIPO_IMPUESTO)"
                                            ValoresActivos="_filtros.GetValueOrDefault(2)" ValoresActivosChanged="@(v=>Filtro(2,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_TIPO_IMPUESTO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Etiqueta XML" Sortable="false" Width="160">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_ETIQUETA_XML" Activo="@(_ordenColumna == 3)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(3))" />
                        <FiltroExcelColumna T="TiposValorCalculoModel" ItemsBase="@Base(3)" ValorDe="@(x=>x.DES_ETIQUETA_XML)"
                                            ValoresActivos="_filtros.GetValueOrDefault(3)" ValoresActivosChanged="@(v=>Filtro(3,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_ETIQUETA_XML</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Características" Sortable="false" Width="200">
                <CellTemplate>
                    <div class="d-flex align-center gap-1 flex-wrap">
                        @foreach (var (icono, texto) in Flags(context.Item))
                        {
                            <MudTooltip Text="@texto"><MudIcon Icon="@icono" Size="Size.Small" Style="opacity:.8;" /></MudTooltip>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin registros.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="TiposValorCalculoModel" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    private Func<Task>? _onCambio;
    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<TiposValorCalculoModel> _items = new();
    private string _search = "";
    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;
    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }
    private List<TiposValorCalculoModel> Ordenar(List<TiposValorCalculoModel> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.COD_TIPO_VALOR_CALCULO).ToList() : items.OrderByDescending(x => x.COD_TIPO_VALOR_CALCULO).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_TIPO_VALOR_CALCULO).ToList() : items.OrderByDescending(x => x.DES_TIPO_VALOR_CALCULO).ToList(),
        2 => _ordenAscendente ? items.OrderBy(x => x.DES_TIPO_IMPUESTO).ToList() : items.OrderByDescending(x => x.DES_TIPO_IMPUESTO).ToList(),
        3 => _ordenAscendente ? items.OrderBy(x => x.DES_ETIQUETA_XML).ToList() : items.OrderByDescending(x => x.DES_ETIQUETA_XML).ToList(),
        _ => items
    };
    private List<TiposValorCalculoModel> _visibles => Ordenar(Aplicar(_items, -1));
    private List<TiposValorCalculoModel> Base(int col) => Aplicar(_items, col);

    private List<TiposValorCalculoModel> Aplicar(List<TiposValorCalculoModel> src, int ex)
    {
        IEnumerable<TiposValorCalculoModel> q = src;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(x.COD_TIPO_VALOR_CALCULO)),
                1 => q.Where(x => v.Contains(x.DES_TIPO_VALOR_CALCULO ?? "")),
                2 => q.Where(x => v.Contains(x.DES_TIPO_IMPUESTO ?? "")),
                3 => q.Where(x => v.Contains(x.DES_ETIQUETA_XML ?? "")),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }

    private static IEnumerable<(string icono, string texto)> Flags(TiposValorCalculoModel t)
    {
        if (t.FLG_POSITIVO == true)           yield return (Icons.Material.Filled.Add, "Positivo");
        if (t.FLG_IMPUESTO == true)           yield return (Icons.Material.Filled.ReceiptLong, "Impuesto");
        if (t.FLG_CALCULA == true)            yield return (Icons.Material.Filled.Calculate, "Calcula");
        if (t.FLG_REGIMEN_TRIBUTARIO == true) yield return (Icons.Material.Filled.Gavel, "Régimen tributario");
    }

    private async Task Buscar()
        => _items = string.IsNullOrWhiteSpace(_search) ? await Fetch() : await FetchSearch(_search);

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("COMERCIAL", "TiposValorCalculo");
        await Load();
        _onCambio = async () => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        Cambios.Suscribir("COMERCIAL.TIPOS_VALOR_CALCULO", _onCambio);
        ShortcutSvc.NuevoRequested += OnAtajoNuevo;
    }

    private async void OnAtajoNuevo() => await InvokeAsync(() => Abrir(null, CrudModo.Create));

    private async Task Load() => _items = string.IsNullOrWhiteSpace(_search) ? await Fetch() : await FetchSearch(_search);

    private async Task<List<TiposValorCalculoModel>> Fetch()
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<TiposValorCalculoModel>>>(
                ApiRoutes.Comercial.TiposValorCalculo);
            return r?.Data ?? new();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(TiposValorCalculo), nameof(Fetch));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            return new();
        }
    }

    private async Task<List<TiposValorCalculoModel>> FetchSearch(string s)
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<TiposValorCalculoModel>>>(
                $"{ApiRoutes.Comercial.TiposValorCalculo}/search?search={Uri.EscapeDataString(s)}");
            return r?.Data ?? new();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(TiposValorCalculo), nameof(FetchSearch));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            return new();
        }
    }

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create);
        return Task.CompletedTask;
    }

    private Task OnAccionGrilla(TiposValorCalculoModel item, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_GET    == true) return Abrir(item, CrudModo.Read);
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        return Task.CompletedTask;
    }

    private async Task Abrir(TiposValorCalculoModel? item, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nuevo tipo de valor de cálculo",
            CrudModo.Delete => $"Eliminar · {item?.DES_TIPO_VALOR_CALCULO}",
            _               => $"Editar · {item?.DES_TIPO_VALOR_CALCULO}"
        };
        var dlg = await DialogService.ShowAsync<TiposValorCalculoDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    public void Dispose()
    {
        Cambios.Desuscribir("COMERCIAL.TIPOS_VALOR_CALCULO", _onCambio ?? (() => Task.CompletedTask));
        ShortcutSvc.NuevoRequested -= OnAtajoNuevo;
    }
}
