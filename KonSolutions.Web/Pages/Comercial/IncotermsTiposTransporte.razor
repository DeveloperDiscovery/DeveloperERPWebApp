@page "/comercial/incoterms-tipos-transporte"
@attribute [Authorize]
@using IncotermsTiposTransporteModel = KONSolutions.Shared.Models.Comercial.IncotermsTiposTransporte
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@implements IDisposable
@inject ErrorLogService ErrorLog

<PageTitle>Incoterms - Tipos de Transporte · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center justify-space-between mb-4">
    <div>
        <TituloPagina Fallback="Incoterms - Tipos de Transporte" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema COMERCIAL · @_visibles.Count relaciones</MudText>
    </div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Class="pa-4 mb-4" Style="border:1px solid var(--line);">
    <AriaCombo Items="_incoterms" TextFunc="@(t => $"{t.Texto} ({t.Id})")" ValueFunc="@(t => t.Id)"
                 @bind-Value="_codIncotermSeleccionado" Label="Incoterm"
                 Class="mb-0" />
</MudPaper>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="incoterms-tipos-transporte" style="position:relative;">
    <MudDataGrid T="IncotermsTiposTransporteModel" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Sortable="false" Title="Tipo de transporte">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_TIPO_TRANSPORTE" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="IncotermsTiposTransporteModel" ItemsBase="@Base(0)" ValorDe="@(x=>x.DES_TIPO_TRANSPORTE ?? x.COD_TIPO_TRANSPORTE ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@(context.Item.DES_TIPO_TRANSPORTE ?? context.Item.COD_TIPO_TRANSPORTE)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Class="pa-6 mono" Style="opacity:.5;">
                @(string.IsNullOrEmpty(_codIncotermSeleccionado) ? "Selecciona un incoterm para ver sus tipos de transporte." : "Sin tipos de transporte asignados a este incoterm.")
            </MudText>
        </NoRecordsContent>
        <PagerContent><MudDataGridPager T="IncotermsTiposTransporteModel" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    private Func<Task>? _onCambio;
    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<IncotermsTiposTransporteModel> _items = new();
    private List<KONSolutions.Shared.Common.ComboboxItem> _incoterms = new();
    private string? _codIncotermSeleccionado;

    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;
    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }
    private List<IncotermsTiposTransporteModel> Ordenar(List<IncotermsTiposTransporteModel> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.DES_TIPO_TRANSPORTE).ToList() : items.OrderByDescending(x => x.DES_TIPO_TRANSPORTE).ToList(),
        _ => items
    };

    private List<IncotermsTiposTransporteModel> _porIncoterm =>
        string.IsNullOrEmpty(_codIncotermSeleccionado)
            ? new()
            : _items.Where(x => x.COD_INCOTERM == _codIncotermSeleccionado).ToList();

    private List<IncotermsTiposTransporteModel> _visibles => Ordenar(Aplicar(_porIncoterm, -1));
    private List<IncotermsTiposTransporteModel> Base(int col) => Aplicar(_porIncoterm, col);

    private List<IncotermsTiposTransporteModel> Aplicar(List<IncotermsTiposTransporteModel> src, int ex)
    {
        IEnumerable<IncotermsTiposTransporteModel> q = src;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(x.DES_TIPO_TRANSPORTE ?? x.COD_TIPO_TRANSPORTE ?? "")),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("COMERCIAL", "IncotermsTiposTransporte");
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<KONSolutions.Shared.Common.ComboboxItem>>>(
                ApiRoutes.Comercial.IncotermsCombobox);
            _incoterms = r?.Data ?? new();
        }
        catch { }
        await Load();
        _onCambio = async () => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        Cambios.Suscribir("COMERCIAL.INCOTERMS_TIPOS_TRANSPORTE", _onCambio);
    }

    private async Task Load() => _items = await Fetch();

    private async Task<List<IncotermsTiposTransporteModel>> Fetch()
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<IncotermsTiposTransporteModel>>>(
                ApiRoutes.Comercial.IncotermsTiposTransporte);
            return r?.Data ?? new();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(IncotermsTiposTransporte), nameof(Fetch));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            return new();
        }
    }

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true)
        {
            if (string.IsNullOrEmpty(_codIncotermSeleccionado))
            {
                Snackbar.Add("Selecciona primero un incoterm.", Severity.Warning);
                return Task.CompletedTask;
            }
            return Abrir(null, CrudModo.Create);
        }
        return Task.CompletedTask;
    }

    private Task OnAccionGrilla(IncotermsTiposTransporteModel item, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_GET    == true) return Abrir(item, CrudModo.Read);
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        return Task.CompletedTask;
    }

    private async Task Abrir(IncotermsTiposTransporteModel? item, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nuevo tipo de transporte para el incoterm",
            CrudModo.Delete => $"Eliminar · {item?.DES_TIPO_TRANSPORTE}",
            _               => $"Consultar · {item?.DES_TIPO_TRANSPORTE}"
        };
        var dlg = await DialogService.ShowAsync<IncotermsTiposTransporteDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo, ["CodIncotermFijo"] = _codIncotermSeleccionado },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    public void Dispose()
    {
        Cambios.Desuscribir("COMERCIAL.INCOTERMS_TIPOS_TRANSPORTE", _onCambio ?? (() => Task.CompletedTask));
    }
}
