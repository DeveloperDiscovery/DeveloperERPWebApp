@page "/comercial/fases-incoterm"
@attribute [Authorize]
@using FasesIncotermModel = KONSolutions.Shared.Models.Comercial.FasesIncoterm
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@inject ShortcutService ShortcutSvc
@implements IDisposable
@inject ErrorLogService ErrorLog

<PageTitle>Fases de Incoterm · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Fases de Incoterm" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema COMERCIAL · @_visibles.Count de @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="Buscar" Placeholder="Buscar fase de incoterm..." DebounceInterval="400" MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f=>f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="fases-incoterm" style="position:relative;">
    <MudDataGrid T="FasesIncotermModel" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Title="Imagen" Sortable="false" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <CellTemplate>
                    @if (context.Item.IMG_ICONO is { Length: > 0 } img)
                    {
                        <img src="@($"data:image/png;base64,{Convert.ToBase64String(img)}")" style="width:26px;height:26px;object-fit:contain;" alt="" />
                    }
                    else { <MudText Typo="Typo.caption" Style="opacity:.25;">—</MudText> }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Código"
                            Width="@Limites.ColWidth("COMERCIAL.FASES_INCOTERM","COD_FASE_INCOTERM",60,120)" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_FASE_INCOTERM" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="FasesIncotermModel" ItemsBase="@Base(0)" ValorDe="@(x=>x.COD_FASE_INCOTERM)"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.COD_FASE_INCOTERM</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Descripción"
                            Width="@Limites.ColWidth("COMERCIAL.FASES_INCOTERM","DES_FASE_INCOTERM",150,400)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_FASE_INCOTERM" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="FasesIncotermModel" ItemsBase="@Base(1)" ValorDe="@(x=>x.DES_FASE_INCOTERM)"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_FASE_INCOTERM</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin registros.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="FasesIncotermModel" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    private Func<Task>? _onCambio;
    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<FasesIncotermModel> _items = new();
    private string _search = "";
    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;
    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }
    private List<FasesIncotermModel> Ordenar(List<FasesIncotermModel> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.COD_FASE_INCOTERM).ToList() : items.OrderByDescending(x => x.COD_FASE_INCOTERM).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_FASE_INCOTERM).ToList() : items.OrderByDescending(x => x.DES_FASE_INCOTERM).ToList(),
        _ => items
    };
    private List<FasesIncotermModel> _visibles => Ordenar(Aplicar(_items, -1));
    private List<FasesIncotermModel> Base(int col) => Aplicar(_items, col);

    private List<FasesIncotermModel> Aplicar(List<FasesIncotermModel> src, int ex)
    {
        IEnumerable<FasesIncotermModel> q = src;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(x.COD_FASE_INCOTERM)),
                1 => q.Where(x => v.Contains(x.DES_FASE_INCOTERM)),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }

    private async Task Buscar()
        => _items = string.IsNullOrWhiteSpace(_search) ? await Fetch() : await FetchSearch(_search);

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("COMERCIAL", "FasesIncoterm");
        await Load();
        _onCambio = async () => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        Cambios.Suscribir("COMERCIAL.FASES_INCOTERM", _onCambio);
        ShortcutSvc.NuevoRequested += OnAtajoNuevo;
    }

    private async void OnAtajoNuevo() => await InvokeAsync(() => Abrir(null, CrudModo.Create));

    private async Task Load() => _items = string.IsNullOrWhiteSpace(_search) ? await Fetch() : await FetchSearch(_search);

    private async Task<List<FasesIncotermModel>> Fetch()
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<FasesIncotermModel>>>(
                ApiRoutes.Comercial.FasesIncoterm);
            return r?.Data ?? new();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(FasesIncoterm), nameof(Fetch));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            return new();
        }
    }

    private async Task<List<FasesIncotermModel>> FetchSearch(string s)
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<FasesIncotermModel>>>(
                $"{ApiRoutes.Comercial.FasesIncoterm}/search?search={Uri.EscapeDataString(s)}");
            return r?.Data ?? new();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(FasesIncoterm), nameof(FetchSearch));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            return new();
        }
    }

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create);
        return Task.CompletedTask;
    }

    private Task OnAccionGrilla(FasesIncotermModel item, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_GET    == true) return Abrir(item, CrudModo.Read);
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        return Task.CompletedTask;
    }

    private async Task Abrir(FasesIncotermModel? item, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nueva fase de incoterm",
            CrudModo.Delete => $"Eliminar · {item?.DES_FASE_INCOTERM}",
            _               => $"Editar · {item?.DES_FASE_INCOTERM}"
        };
        var dlg = await DialogService.ShowAsync<FasesIncotermDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    public void Dispose()
    {
        Cambios.Desuscribir("COMERCIAL.FASES_INCOTERM", _onCambio ?? (() => Task.CompletedTask));
        ShortcutSvc.NuevoRequested -= OnAtajoNuevo;
    }
}
