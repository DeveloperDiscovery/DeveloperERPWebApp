@*
    PaginaError.razor
    --------------------------------------------------------------------------
    Se abre cuando una opción de menú SÍ tiene un DES_FORMULARIO asignado, pero
    esa ruta no resuelve a ninguna pantalla registrada (configuración inválida,
    ruta mal escrita, pantalla eliminada, etc.) — a diferencia de
    PaginaEnConstruccion.razor, que es para cuando DES_FORMULARIO está vacío.
    Ilustración vectorial propia (sin depender de una imagen/GIF externo).
*@
<div class="per-wrap">
    <svg class="per-svg" viewBox="0 0 320 220" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Monitor "roto" -->
        <rect x="80" y="50" width="160" height="110" rx="6" fill="var(--ink, #16130f)" opacity=".9" />
        <rect x="90" y="60" width="140" height="82" rx="2" fill="#ffffff" />
        <rect x="150" y="160" width="20" height="16" fill="var(--ink, #16130f)" opacity=".9" />
        <rect x="126" y="176" width="68" height="8" rx="3" fill="var(--ink, #16130f)" opacity=".7" />

        <!-- Grieta en la pantalla -->
        <path d="M160 60 L146 90 L168 100 L150 142" stroke="var(--rust, #b8472d)" stroke-width="3"
              fill="none" stroke-linecap="round" stroke-linejoin="round" opacity=".7" />
        <path d="M160 60 L184 84 L164 96" stroke="var(--rust, #b8472d)" stroke-width="3"
              fill="none" stroke-linecap="round" stroke-linejoin="round" opacity=".55" />

        <!-- Triángulo de advertencia, pulsante -->
        <g class="per-alerta">
            <path d="M160 76 L182 116 L138 116 Z" fill="var(--rust, #b8472d)" />
            <rect x="157" y="88" width="6" height="16" rx="2" fill="#ffffff" />
            <circle cx="160" cy="109" r="3.2" fill="#ffffff" />
        </g>

        <!-- Chispas / fragmentos flotando -->
        <g class="per-flotante-1">
            <rect x="246" y="70" width="16" height="16" rx="3" fill="var(--rust, #b8472d)" opacity=".7" />
        </g>
        <g class="per-flotante-2">
            <circle cx="60" cy="96" r="8" fill="var(--rust, #b8472d)" opacity=".55" />
        </g>
        <g class="per-flotante-3">
            <rect x="52" y="140" width="14" height="14" rx="7" fill="var(--ink,#16130f)" opacity=".15" />
        </g>
    </svg>

    <MudText Typo="Typo.h5" Class="mono">No se pudo abrir la pantalla</MudText>
    <MudText Typo="Typo.body2" Style="opacity:.6;max-width:420px;text-align:center;">
        @(!string.IsNullOrWhiteSpace(Titulo)
            ? $"'{Titulo}' tiene una ruta configurada, pero no corresponde a ninguna pantalla registrada."
            : "Esta opción tiene una ruta configurada, pero no corresponde a ninguna pantalla registrada.")
        @if (!string.IsNullOrWhiteSpace(Ruta))
        {
            <br /><span class="mono" style="opacity:.55;font-size:.78rem;">DES_FORMULARIO: '@Ruta'</span>
        }
    </MudText>
</div>

<style>
    .per-wrap {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 1.2rem; padding: 2rem 1rem; height: 100%; min-height: 60vh;
    }
    /* Ilustración ~1/5 de la página, centrada */
    .per-svg { width: 20vw; min-width: 220px; max-width: 420px; height: auto; }

    .per-alerta { animation: per-pulso 1.1s ease-in-out infinite; transform-origin: 160px 96px; }
    .per-flotante-1 { animation: per-flotar 3s ease-in-out infinite; }
    .per-flotante-2 { animation: per-flotar 3.6s ease-in-out infinite .3s; }
    .per-flotante-3 { animation: per-flotar 2.6s ease-in-out infinite .6s; }

    @@keyframes per-pulso {
        0%, 100% { transform: scale(1);   opacity: 1; }
        50%      { transform: scale(1.08); opacity: .85; }
    }
    @@keyframes per-flotar {
        0%, 100% { transform: translateY(0); }
        50%      { transform: translateY(-8px); }
    }
    @@media (prefers-reduced-motion: reduce) {
        .per-alerta, .per-flotante-1, .per-flotante-2, .per-flotante-3 { animation: none; }
    }
</style>

@code {
    [Parameter] public string? Titulo { get; set; }
    [Parameter] public string? Ruta { get; set; }
    [Parameter] public string? CodAplicacion { get; set; }
    [Parameter] public string? CodOpcionAplicacion { get; set; }
}
