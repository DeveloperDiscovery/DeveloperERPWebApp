@* Botón reutilizable para refrescar una grilla manualmente.
   Uso: <GridRefreshButton OnRefresh="LoadXxx" /> junto a Nuevo/Imprimir.
   Cuadrado redondeado y relleno con el mismo color configurable (Configuración
   General → Botones de Diálogo y Acciones de Cabecera) que el botón de
   confirmación de los diálogos, para que se vean consistentes en toda la app. *@
<MudTooltip Text="Refrescar datos">
    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                   Class="grid-header-btn"
                   Disabled="_loading"
                   Style="@($"background-color:var(--boton-backcolor,#8bd672);color:var(--boton-forecolor,#fff);border-radius:10px;{(_loading ? "opacity:.5;" : "")}")"
                   OnClick="DoRefresh" />
</MudTooltip>

@code {
    [Parameter] public EventCallback OnRefresh { get; set; }
    private bool _loading;

    private async Task DoRefresh()
    {
        _loading = true;
        try { await OnRefresh.InvokeAsync(); }
        finally { _loading = false; }
    }
}
