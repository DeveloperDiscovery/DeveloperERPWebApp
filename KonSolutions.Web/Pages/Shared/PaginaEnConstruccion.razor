@*
    PaginaEnConstruccion.razor
    --------------------------------------------------------------------------
    Se abre en vez de mostrar solo un snackbar cuando una opción de menú no
    tiene una pantalla ni un formulario dinámico asociado. Ilustración vectorial
    propia (sin depender de una imagen/GIF externo, para no requerir red).
*@
<div class="pec-wrap">
    <svg class="pec-svg" viewBox="0 0 320 220" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <!-- Escritorio -->
        <rect x="30" y="168" width="260" height="10" rx="3" fill="var(--rust, #b8472d)" opacity=".18" />
        <rect x="46" y="150" width="228" height="20" rx="4" fill="var(--ink, #16130f)" opacity=".08" />

        <!-- Monitor -->
        <rect x="96" y="58" width="128" height="92" rx="6" fill="var(--ink, #16130f)" opacity=".9" />
        <rect x="106" y="68" width="108" height="70" rx="2" fill="#ffffff" />
        <rect x="150" y="150" width="20" height="14" fill="var(--ink, #16130f)" opacity=".9" />
        <rect x="130" y="164" width="60" height="8" rx="3" fill="var(--ink, #16130f)" opacity=".7" />

        <!-- Wireframe dentro de la pantalla -->
        <rect x="114" y="76" width="40" height="6" rx="2" fill="var(--rust, #b8472d)" />
        <rect x="114" y="88" width="92" height="4" rx="2" fill="var(--ink,#16130f)" opacity=".25" />
        <rect x="114" y="97" width="92" height="4" rx="2" fill="var(--ink,#16130f)" opacity=".25" />
        <rect x="114" y="106" width="60" height="4" rx="2" fill="var(--ink,#16130f)" opacity=".25" />
        <rect x="114" y="118" width="30" height="16" rx="3" class="pec-blink" fill="var(--rust, #b8472d)" opacity=".55" />
        <rect x="150" y="118" width="56" height="16" rx="3" fill="var(--ink,#16130f)" opacity=".12" />

        <!-- Silla -->
        <path d="M182 205 q0 -30 20 -34 q20 4 20 34 z" fill="var(--ink,#16130f)" opacity=".12" />

        <!-- Teclado -->
        <rect x="176" y="152" width="60" height="16" rx="3" fill="var(--ink,#16130f)" opacity=".7" />
        <g fill="#ffffff" opacity=".8">
            <rect x="181" y="156" width="6" height="4" rx="1" /> <rect x="190" y="156" width="6" height="4" rx="1" />
            <rect x="199" y="156" width="6" height="4" rx="1" /> <rect x="208" y="156" width="6" height="4" rx="1" />
            <rect x="217" y="156" width="6" height="4" rx="1" /> <rect x="226" y="156" width="6" height="4" rx="1" />
        </g>

        <!-- Persona -->
        <g class="pec-persona">
            <!-- torso -->
            <path d="M168 150 q34 -14 64 4 l-6 40 q-28 12 -54 0 z" fill="var(--rust, #b8472d)" />
            <!-- cabeza -->
            <circle cx="200" cy="128" r="16" fill="#f0c9a0" />
            <path d="M184 122 q16 -18 32 0 q-2 -14 -16 -14 q-14 0 -16 14 z" fill="var(--ink,#16130f)" opacity=".85" />
            <!-- manos tecleando -->
            <path class="pec-mano-izq" d="M188 156 q-4 4 -2 10" stroke="#f0c9a0" stroke-width="8" stroke-linecap="round" fill="none" />
            <path class="pec-mano-der" d="M212 156 q4 4 2 10" stroke="#f0c9a0" stroke-width="8" stroke-linecap="round" fill="none" />
        </g>

        <!-- Elementos de diseño flotantes -->
        <g class="pec-flotante-1">
            <rect x="252" y="52" width="26" height="18" rx="4" fill="var(--rust, #b8472d)" opacity=".8" />
        </g>
        <g class="pec-flotante-2">
            <circle cx="56" cy="70" r="10" fill="var(--rust, #b8472d)" opacity=".6" />
        </g>
        <g class="pec-flotante-3">
            <rect x="38" y="100" width="18" height="18" rx="9" fill="var(--ink,#16130f)" opacity=".15" />
        </g>
    </svg>

    <MudText Typo="Typo.h5" Class="mono">Página en construcción</MudText>
    <MudText Typo="Typo.body2" Style="opacity:.6;max-width:420px;text-align:center;">
        @(!string.IsNullOrWhiteSpace(Titulo)
            ? $"'{Titulo}' todavía no tiene una pantalla asignada."
            : "Esta opción todavía no tiene una pantalla asignada.")
    </MudText>
</div>

<style>
    .pec-wrap {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 1.2rem; padding: 2rem 1rem; height: 100%; min-height: 60vh;
    }
    /* Ilustración ~1/5 de la página, centrada */
    .pec-svg { width: 20vw; min-width: 220px; max-width: 420px; height: auto; }

    .pec-mano-izq { transform-origin: 188px 156px; animation: pec-teclear 0.5s ease-in-out infinite; }
    .pec-mano-der { transform-origin: 212px 156px; animation: pec-teclear 0.5s ease-in-out infinite .25s; }
    .pec-blink { animation: pec-parpadeo 1.3s steps(1) infinite; }
    .pec-flotante-1 { animation: pec-flotar 3s ease-in-out infinite; }
    .pec-flotante-2 { animation: pec-flotar 3.6s ease-in-out infinite .3s; }
    .pec-flotante-3 { animation: pec-flotar 2.6s ease-in-out infinite .6s; }

    @@keyframes pec-teclear {
        0%, 100% { transform: translateY(0); }
        50%      { transform: translateY(3px); }
    }
    @@keyframes pec-parpadeo {
        0%, 49%  { opacity: .55; }
        50%, 100%{ opacity: .15; }
    }
    @@keyframes pec-flotar {
        0%, 100% { transform: translateY(0); }
        50%      { transform: translateY(-8px); }
    }
    @@media (prefers-reduced-motion: reduce) {
        .pec-mano-izq, .pec-mano-der, .pec-blink, .pec-flotante-1, .pec-flotante-2, .pec-flotante-3 { animation: none; }
    }
</style>

@code {
    [Parameter] public string? Titulo { get; set; }
    [Parameter] public string? CodAplicacion { get; set; }
    [Parameter] public string? CodOpcionAplicacion { get; set; }
}
