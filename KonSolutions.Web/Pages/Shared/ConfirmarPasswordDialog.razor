@* Diálogo de confirmación de contraseña — usado cuando una opción del menú
   tiene FLG_EXIGE_PASSWORD = true, para volver a pedir la contraseña del
   usuario actual antes de abrir esa pantalla. *@
@inject IAuthService AuthService

<MudDialog>
    <DialogContent>
        <div class="d-flex align-center gap-2 mb-3">
            <MudIcon Icon="@Icons.Material.Filled.Password" Color="Color.Primary" Size="Size.Medium" />
            <MudText Typo="Typo.body1">Esta opción requiere confirmar tu contraseña para continuar.</MudText>
        </div>
        @* Chrome detecta un campo de contraseña casi exclusivamente por el atributo
           type="password" en el DOM — ningún otro atributo (autocomplete, readonly,
           data-lpignore, etc.) evita que ofrezca el gestor una vez que ve ese type.
           La única forma confiable de evitarlo es no usar type="password": el input
           real es type="text" y se enmascara a mano — la contraseña real vive en
           _password (nunca en el DOM) y en pantalla solo se ven "•" del mismo largo. *@
        <MudTextField Value="@_masked" ValueChanged="@OnMaskedChanged" T="string"
                      Label="Contraseña" Variant="Variant.Outlined"
                      InputType="InputType.Text" Immediate="true" Class="mb-2"
                      UserAttributes="@(new Dictionary<string,object> {
                          ["autocomplete"]   = "off",
                          ["autocorrect"]    = "off",
                          ["autocapitalize"] = "off",
                          ["spellcheck"]     = "false",
                          ["data-lpignore"]  = "true",
                          ["data-1p-ignore"] = "true",
                          ["data-bwignore"]  = "true"
                      })"
                      OnKeyDown="@(e => { if (e.Key == "Enter") _ = Confirmar(); })" />
        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Cancel">Cancelar</MudButton>
        <MudButton OnClick="Confirmar" Variant="Variant.Filled" Color="Color.Primary" Disabled="_validando"
                   StartIcon="@Icons.Material.Filled.Check">
            @if (_validando) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Confirmar
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string CodUsuario { get; set; } = "";

    private string  _password  = "";   // valor real, nunca llega al DOM
    private string  _masked    = "";   // lo que ve el usuario (solo "•")
    private string? _error;
    private bool    _validando;

    /// <summary>
    /// El navegador nos entrega el valor final del campo tras la edición (inserción,
    /// borrado o reemplazo de selección), mezclado entre "•" viejos y los caracteres
    /// reales recién tecleados. Se calcula la diferencia por prefijo/sufijo común
    /// contra el "_masked" anterior para reconstruir _password sin exponerlo nunca
    /// en el DOM, y se vuelve a enmascarar todo antes de renderizar.
    /// </summary>
    private void OnMaskedChanged(string nuevoValor)
    {
        nuevoValor ??= "";
        var anterior = _masked;

        var prefijo = 0;
        var maxPrefijo = Math.Min(anterior.Length, nuevoValor.Length);
        while (prefijo < maxPrefijo && anterior[prefijo] == nuevoValor[prefijo]) prefijo++;

        var sufijo = 0;
        var maxSufijo = Math.Min(anterior.Length, nuevoValor.Length) - prefijo;
        while (sufijo < maxSufijo
               && anterior[anterior.Length - 1 - sufijo] == nuevoValor[nuevoValor.Length - 1 - sufijo])
            sufijo++;

        var quitar    = anterior.Length - prefijo - sufijo;
        var insertado = nuevoValor.Substring(prefijo, nuevoValor.Length - prefijo - sufijo);

        _password = _password.Remove(prefijo, quitar).Insert(prefijo, insertado);
        _masked   = new string('•', _password.Length);
    }

    private async Task Confirmar()
    {
        if (string.IsNullOrWhiteSpace(_password)) { _error = "Ingresa tu contraseña."; return; }
        _validando = true; _error = null;
        try
        {
            var (ok, error) = await AuthService.ValidarPasswordAsync(CodUsuario, _password);
            if (ok) MudDialog.Close(DialogResult.Ok(true));
            else _error = error ?? "Contraseña incorrecta.";
        }
        finally { _validando = false; }
    }
}
