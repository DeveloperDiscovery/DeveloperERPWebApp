@page "/estandar/ubigeos"
@attribute [Authorize]
@using UbigeoRow = KONSolutions.Shared.Models.Estandar.Ubigeo
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@inject ShortcutService ShortcutSvc
@inject ErrorLogService ErrorLog
@implements IDisposable

<PageTitle>Ubigeos · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Ubigeos" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema ESTANDAR · @_visibles.Count de @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="Filtrar" MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f=>f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <GridPrintButton Titulo="Ubigeos"
                         Headers="@(new List<string>{"Código","Descripción","Dep.","Prov.","Dist."})"
                         Rows="@(_items.Select(x=>new List<string>{x.COD_UBIGEO,x.DES_UBIGEO,x.FLG_DEPARTAMENTO==true?"Sí":"",x.FLG_PROVINCIA==true?"Sí":"",x.FLG_DISTRITO==true?"Sí":""}).ToList())" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="ubigeos" style="position:relative;">
    <MudDataGrid T="UbigeoRow" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Sortable="false" Title="Código" Width="@Limites.ColWidth("ESTANDAR.UBIGEOS","COD_UBIGEO",80,160)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_UBIGEO" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="UbigeoRow" ItemsBase="@Base(0)" ValorDe="@(x=>x.COD_UBIGEO)"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.COD_UBIGEO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Descripción" Width="@Limites.ColWidth("ESTANDAR.UBIGEOS","DES_UBIGEO",150,450)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_UBIGEO" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="UbigeoRow" ItemsBase="@Base(1)" ValorDe="@(x=>x.DES_UBIGEO)"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_UBIGEO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Nivel" Sortable="false" CellStyle="text-align:center;" HeaderStyle="text-align:center;" Width="110px">
                <CellTemplate>
                    <div class="d-flex align-center justify-center gap-2">
                        <MudTooltip Text="Departamento">
                            <MudIcon Icon="@Icons.Material.Filled.Public" Color="@(context.Item.FLG_DEPARTAMENTO == true ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_DEPARTAMENTO == true ? "" : "opacity:.15;")" Size="Size.Small" />
                        </MudTooltip>
                        <MudTooltip Text="Provincia">
                            <MudIcon Icon="@Icons.Material.Filled.Map" Color="@(context.Item.FLG_PROVINCIA == true ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_PROVINCIA == true ? "" : "opacity:.15;")" Size="Size.Small" />
                        </MudTooltip>
                        <MudTooltip Text="Distrito">
                            <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="@(context.Item.FLG_DISTRITO == true ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_DISTRITO == true ? "" : "opacity:.15;")" Size="Size.Small" />
                        </MudTooltip>
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin registros.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="UbigeoRow" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    [Parameter] public string CodAplicacion { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<UbigeoRow> _items = new();
    private string _search = "";
    private readonly Dictionary<int,HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;
    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }
    private List<UbigeoRow> Ordenar(List<UbigeoRow> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.COD_UBIGEO).ToList() : items.OrderByDescending(x => x.COD_UBIGEO).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_UBIGEO).ToList() : items.OrderByDescending(x => x.DES_UBIGEO).ToList(),
        _ => items
    };
    private List<UbigeoRow> _visibles => Ordenar(Aplicar(_items, -1));
    private List<UbigeoRow> Base(int col) => Aplicar(_items, col);

    private List<UbigeoRow> Aplicar(List<UbigeoRow> src, int ex)
    {
        IEnumerable<UbigeoRow> q = src;
        foreach (var (c,v) in _filtros) { if (c==ex||v is null) continue;
            q = c switch { 0=>q.Where(x=>v.Contains(x.COD_UBIGEO)), 1=>q.Where(x=>v.Contains(x.DES_UBIGEO)), _=>q }; }
        return q.ToList();
    }
    private void Filtro(int c, HashSet<string>? v) { _filtros[c]=v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach(var k in _filtros.Keys.ToList()) _filtros[k]=null; StateHasChanged(); }
    private async Task Filtrar() => _items = string.IsNullOrWhiteSpace(_search)
        ? await Fetch() : await FetchSearch(_search);

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("ESTANDAR","Ubigeos");
        await Load();
        Cambios.Suscribir("ESTANDAR.UBIGEOS", async()=>await InvokeAsync(async()=>{await Load();StateHasChanged();}));
        ShortcutSvc.NuevoRequested += OnAtajoNuevo;
    }

    private async void OnAtajoNuevo() => await InvokeAsync(() => Abrir(null, CrudModo.Create));

    private async Task Load() { _items = string.IsNullOrWhiteSpace(_search) ? await Fetch() : await FetchSearch(_search); }
    private async Task<List<UbigeoRow>> Fetch()
    {
        try { var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<UbigeoRow>>>(ApiRoutes.Estandar.Ubigeos); return r?.Data ?? new(); }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(Ubigeos), nameof(Fetch));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            return new();
        }
    }
    private async Task<List<UbigeoRow>> FetchSearch(string s)
    {
        try { var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<UbigeoRow>>>($"{ApiRoutes.Estandar.Ubigeos}/search?search={Uri.EscapeDataString(s)}"); return r?.Data ?? new(); }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(Ubigeos), nameof(FetchSearch));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            return new();
        }
    }

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.DES_METODO == "UploadJSON") return DescargarUbigeos(b);
        if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create);
        return Task.CompletedTask;
    }

    private async Task DescargarUbigeos(BotonTreeviewItem b)
    {
        try
        {
            var payload = new { b.COD_APLICACION, b.COD_OPCION_APLICACION, COD_BOTON_OPCION = b.COD_BOTON_OPCION };
            var resp = await Http.PostAsJsonAsync(ApiRoutes.Estandar.UbigeosDownloadFromSnippet, payload);
            if (resp.IsSuccessStatusCode) { Snackbar.Add("Ubigeos cargados correctamente.", Severity.Success); await Load(); }
            else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(Ubigeos), nameof(DescargarUbigeos), "No se pudieron descargar los ubigeos");
        }
        catch (Exception ex) { await ErrorDialogHelper.MostrarMensajeAsync(ex.Message, DialogService, nameof(Ubigeos)); await ErrorLog.LogAsync(ex, nameof(Ubigeos), nameof(DescargarUbigeos)); }
    }
    private Task OnAccionGrilla(UbigeoRow item, BotonTreeviewItem b)
    {
        if(b.FLG_ACCION_GET==true)    return Abrir(item, CrudModo.Read);
        if(b.FLG_ACCION_PUT==true)    return Abrir(item, CrudModo.Update);
        if(b.FLG_ACCION_DELETE==true) return Abrir(item, CrudModo.Delete);
        return Task.CompletedTask;
    }

    private async Task Abrir(UbigeoRow? item, CrudModo modo)
    {
        var titulo = modo switch { CrudModo.Create=>"Nuevo ubigeo", CrudModo.Delete=>$"Eliminar · {item?.DES_UBIGEO}", _=>$"Editar · {item?.DES_UBIGEO}" };
        var dlg = await DialogService.ShowAsync<UbigeosDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo },
            new DialogOptions { MaxWidth=MaxWidth.Small, FullWidth=true, BackdropClick = false, CloseOnEscapeKey = false });
        if((await dlg.Result) is {Canceled:false}) await Load();
    }

    public void Dispose()
    {
        Cambios.Desuscribir("ESTANDAR.UBIGEOS", ()=>Task.CompletedTask);
        ShortcutSvc.NuevoRequested -= OnAtajoNuevo;
    }
}
