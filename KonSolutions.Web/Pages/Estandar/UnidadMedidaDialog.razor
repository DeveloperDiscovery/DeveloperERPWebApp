@using KONSolutions.Shared.Models.Estandar
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <CrudDialogTitle Modo="Modo" Codigo="@Item?.COD_UNIDAD_MEDIDA" Descripcion="@Item?.DES_UNIDAD_MEDIDA" />
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrWhiteSpace(DesTipoUnidadMedida))
            {
                <MudText Typo="Typo.caption" Class="mb-3 d-block" Style="opacity:.6;">
                    Tipo de magnitud: <strong>@DesTipoUnidadMedida</strong>
                </MudText>
            }

            <CampoTexto Tabla="ESTANDAR.UNIDADES_MEDIDA" Columna="COD_UNIDAD_MEDIDA"
                        @bind-Value="_model.COD_UNIDAD_MEDIDA"
                        Disabled="@(!_esNuevo || _readonly)" Obligatorio="@_esNuevo" />
            <CampoTexto Tabla="ESTANDAR.UNIDADES_MEDIDA" Columna="DES_UNIDAD_MEDIDA"
                        @bind-Value="_model.DES_UNIDAD_MEDIDA"
                        Disabled="_readonly" Obligatorio="true" />
            <CampoTexto Tabla="ESTANDAR.UNIDADES_MEDIDA" Columna="COD_SIMBOLO"
                        @bind-Value="_model.COD_SIMBOLO"
                        Disabled="_readonly" />
            <CampoTexto Tabla="ESTANDAR.UNIDADES_MEDIDA" Columna="COD_UNIDAD_MEDIDA_SUNAT"
                        @bind-Value="_model.COD_UNIDAD_MEDIDA_SUNAT"
                        Disabled="_readonly" />
            <div class="my-3">
                <ImagePicker Image="_model.IMG_ICONO" ImageChanged="@(v => _model.IMG_ICONO = v)"
                             Label="Ícono" ReadOnly="_readonly" RemoveBackground="true" />
            </div>
            <CrudDialogActions Modo="Modo" Saving="_saving"
                               OnCancel="@(() => MudDialog.Cancel())" />
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public UnidadesMedida? Item { get; set; }
    [Parameter] public CrudModo Modo { get; set; } = CrudModo.Create;
    [Parameter] public string CodTipoUnidadMedida { get; set; } = "";
    [Parameter] public string DesTipoUnidadMedida { get; set; } = "";

    private UnidadesMedidaInsertDto _model = new();
    private bool _esNuevo, _saving;
    private bool _readonly => Modo == CrudModo.Read || Modo == CrudModo.Delete;

    protected override void OnInitialized()
    {
        _esNuevo = Modo == CrudModo.Create;
        if (Item is not null) MapearDesdeModelo(Item);
        else
            _model.COD_TIPO_UNIDAD_MEDIDA = CodTipoUnidadMedida;
    }

    private void MapearDesdeModelo(UnidadesMedida m) =>
        _model = new UnidadesMedidaInsertDto
        {
            COD_UNIDAD_MEDIDA       = m.COD_UNIDAD_MEDIDA,
            DES_UNIDAD_MEDIDA       = m.DES_UNIDAD_MEDIDA,
            COD_UNIDAD_MEDIDA_SUNAT = m.COD_UNIDAD_MEDIDA_SUNAT,
            COD_SIMBOLO             = m.COD_SIMBOLO,
            COD_TIPO_UNIDAD_MEDIDA  = m.COD_TIPO_UNIDAD_MEDIDA ?? CodTipoUnidadMedida,
            IMG_ICONO               = m.IMG_ICONO
        };

    private async Task RecargarDesdeShowbyidAsync()
    {
        var fresco = await Http.SafeGetAsync<UnidadesMedida>($"{ApiRoutes.Estandar.UnidadesMedida}/{Uri.EscapeDataString(_model.COD_UNIDAD_MEDIDA)}");
        if (fresco is not null) MapearDesdeModelo(fresco);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!_esNuevo && Item is not null) await RecargarDesdeShowbyidAsync();
    }
    private async Task Submit()
    {
        _saving = true;
        if (Modo == CrudModo.Delete)
        {
            var rd = await Http.DeleteAsync($"{ApiRoutes.Estandar.UnidadesMedida}/{Uri.EscapeDataString(_model.COD_UNIDAD_MEDIDA)}");
            _saving = false;
            if (rd.IsSuccessStatusCode) { Snackbar.Add("Eliminada.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
            else await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(UnidadMedidaDialog), nameof(Submit), "No se pudo eliminar el registro");
            return;
        }
        var resp = _esNuevo
            ? await Http.PostAsJsonAsync(ApiRoutes.Estandar.UnidadesMedida, _model)
            : await Http.PutAsJsonAsync($"{ApiRoutes.Estandar.UnidadesMedida}/{Uri.EscapeDataString(_model.COD_UNIDAD_MEDIDA)}", _model);
        _saving = false;
        if (resp.IsSuccessStatusCode) { Snackbar.Add(_esNuevo ? "Creada." : "Modificada.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(UnidadMedidaDialog), nameof(Submit));
    }
}
