@inject MotivoService Service
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog Style="width:min(820px,95vw);">
    <TitleContent>
        <CrudDialogTitle Modo="@(_isEdit ? CrudModo.Update : CrudModo.Create)"
                         Descripcion="@Item?.DES_MOTIVO" />
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div style="display:flex;gap:16px;align-items:flex-start;">
                <div style="flex:1;min-width:0;">
                    <MudGrid>
                        <MudItem xs="12" sm="8">
                            <CampoTexto Tabla="ESTANDAR.MOTIVOS" Columna="DES_MOTIVO"
                                        @bind-Value="_model.DES_MOTIVO" Class="" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField @bind-Value="_model.NUM_ORDEN_PRESENTACION" Label="Orden"
                                             Variant="Variant.Outlined" Min="0" Margin="Margin.Normal" Class="mb-3"
                                             Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Primary" Size="Size.Medium" />
                                <MudSwitch @bind-Value="_model.FLG_DEFAULT" Color="Color.Primary" Label="Por defecto" /></div>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Comment" Color="Color.Primary" Size="Size.Medium" />
                                <MudSwitch @bind-Value="_model.FLG_EXPLICAR" Color="Color.Primary" Label="Requiere explicar" /></div>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.SmartToy" Color="Color.Primary" Size="Size.Medium" />
                                <MudSwitch @bind-Value="_model.FLG_AUTOMATICO" Color="Color.Primary" Label="Automático" /></div>
                        </MudItem>
                    </MudGrid>
                </div>
                <div style="flex-shrink:0;padding-left:8px;border-left:1px solid rgba(0,0,0,.1);">
                    <ImagePicker Image="_model.IMG_PICTURE" ImageChanged="@(v => _model.IMG_PICTURE = v)" Label="Imagen del motivo" />
                </div>
            </div>

            <CrudDialogActions Modo="@(_isEdit ? CrudModo.Update : CrudModo.Create)" Saving="_saving"
                               OnCancel="@(() => MudDialog.Cancel())">
                <LeftContent>
                    <PanelAuditoria CodUsuarioRegistro="@Item?.COD_USUARIO_REGISTRO"
                                    CodEstacionRegistro="@Item?.COD_ESTACION_REGISTRO"
                                    FecRegistro="@Item?.FEC_REGISTRO"
                                    CodUsuarioActualizacion="@Item?.COD_USUARIO_ACTUALIZACION"
                                    CodEstacionActualizacion="@Item?.COD_ESTACION_ACTUALIZACION"
                                    FecActualizacion="@Item?.FEC_ACTUALIZACION" />
                </LeftContent>
            </CrudDialogActions>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Motivo? Item { get; set; }
    [Parameter] public int CodTipoMotivo { get; set; }

    private MotivoDto _model = new();
    private bool _isEdit, _saving;

    protected override void OnInitialized()
    {
        _isEdit = Item is not null;
        if (_isEdit && Item is not null)
            _model = new MotivoDto
            {
                COD_TIPO_MOTIVO = Item.COD_TIPO_MOTIVO,
                COD_MOTIVO = Item.COD_MOTIVO,
                DES_MOTIVO = Item.DES_MOTIVO ?? "",
                FLG_DEFAULT = Item.FLG_DEFAULT,
                FLG_EXPLICAR = Item.FLG_EXPLICAR,
                FLG_AUTOMATICO = Item.FLG_AUTOMATICO,
                NUM_ORDEN_PRESENTACION = Item.NUM_ORDEN_PRESENTACION ?? 0,
                IMG_PICTURE = Item.IMG_PICTURE
            };
        else
            _model.COD_TIPO_MOTIVO = CodTipoMotivo;

        _model.EsNuevo = !_isEdit;
    }

    private async Task Submit()
    {
        _model.COD_TIPO_MOTIVO = CodTipoMotivo;
        _saving = true;
        var (ok, msg) = await Service.GuardarAsync(_model);
        _saving = false;
        if (ok) { Snackbar.Add(_isEdit ? "Motivo actualizado." : "Motivo creado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarMensajeAsync(msg, DialogService, nameof(MotivoDialog));
    }
}
