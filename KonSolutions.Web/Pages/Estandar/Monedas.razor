@page "/estandar/monedas"
@attribute [Authorize]
@using KONSolutions.Shared.Models.Estandar
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@inject ShortcutService ShortcutSvc
@implements IDisposable
@inject ErrorLogService ErrorLog

<PageTitle>Monedas · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Monedas" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema ESTANDAR · @_visibles.Count de @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="Filtrar" MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f=>f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <GridPrintButton Titulo="Monedas"
            Headers="@(new List<string>{"Código","Descripción","Cód. SUNAT"})"
            Rows="@(_items.Select(x=>new List<string>{x.COD_MONEDA,x.DES_MONEDA,x.COD_MONEDA_SUNAT?.ToString()??"—"}).ToList())" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="monedas" style="position:relative;">
    <MudDataGrid T="Moneda" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Title="Icono" Sortable="false" Width="60">
                <CellTemplate>
                    <GridImage Image="@context.Item.IMG_ICONO" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Código" Width="@Limites.ColWidth("ESTANDAR.MONEDAS","COD_MONEDA",70,150)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_MONEDA" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="Moneda" ItemsBase="@Base(0)" ValorDe="@(x=>x.COD_MONEDA)"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate><span class="mono">@context.Item.COD_MONEDA</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Descripción" Width="@Limites.ColWidth("ESTANDAR.MONEDAS","DES_MONEDA",140,360)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_MONEDA" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="Moneda" ItemsBase="@Base(1)" ValorDe="@(x=>x.DES_MONEDA)"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_MONEDA</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Cód. SUNAT" Width="100">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_MONEDA_SUNAT" Activo="@(_ordenColumna == 2)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(2))" />
                        <FiltroExcelColumna T="Moneda" ItemsBase="@Base(2)" ValorDe="@(x=>x.COD_MONEDA_SUNAT?.ToString() ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(2)" ValoresActivosChanged="@(v=>Filtro(2,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate><span class="mono">@(context.Item.COD_MONEDA_SUNAT?.ToString() ?? "—")</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Estado" Width="110">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_ESTADO" Activo="@(_ordenColumna == 3)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(3))" />
                        <FiltroExcelColumna T="Moneda" ItemsBase="@Base(3)" ValorDe="@(x=>x.DES_ESTADO ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(3)" ValoresActivosChanged="@(v=>Filtro(3,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>
                    <EstadoChip Estado="@context.Item.DES_ESTADO"
                                BackColor="@context.Item.DES_BACKCOLOR"
                                ForeColor="@context.Item.DES_FORECOLOR" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin registros.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="Moneda" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    private Func<Task>? _onCambio;
    [Parameter] public string CodAplicacion { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<Moneda> _items = new();
    private string _search = "";
    private readonly Dictionary<int,HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;
    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }
    private List<Moneda> Ordenar(List<Moneda> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.COD_MONEDA).ToList() : items.OrderByDescending(x => x.COD_MONEDA).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_MONEDA).ToList() : items.OrderByDescending(x => x.DES_MONEDA).ToList(),
        2 => _ordenAscendente ? items.OrderBy(x => x.COD_MONEDA_SUNAT).ToList() : items.OrderByDescending(x => x.COD_MONEDA_SUNAT).ToList(),
        3 => _ordenAscendente ? items.OrderBy(x => x.DES_ESTADO).ToList() : items.OrderByDescending(x => x.DES_ESTADO).ToList(),
        _ => items
    };
    private List<Moneda> _visibles => Ordenar(Aplicar(_items, -1));
    private List<Moneda> Base(int col) => Aplicar(_items, col);

    private List<Moneda> Aplicar(List<Moneda> src, int ex)
    {
        IEnumerable<Moneda> q = src;
        foreach (var (c,v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(x.COD_MONEDA)),
                1 => q.Where(x => v.Contains(x.DES_MONEDA)),
                2 => q.Where(x => v.Contains(x.COD_MONEDA_SUNAT?.ToString() ?? "")),
                3 => q.Where(x => v.Contains(x.DES_ESTADO ?? "")),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }
    private async Task Filtrar() => _items = string.IsNullOrWhiteSpace(_search)
        ? await Fetch() : await FetchSearch(_search);

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("ESTANDAR", "Monedas");
        await Load();
        _onCambio = async () => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        Cambios.Suscribir("ESTANDAR.MONEDAS", _onCambio);
        ShortcutSvc.NuevoRequested += OnAtajoNuevo;
    }

    private async void OnAtajoNuevo() => await InvokeAsync(() => Abrir(null, CrudModo.Create));

    private async Task Load() { _items = string.IsNullOrWhiteSpace(_search) ? await Fetch() : await FetchSearch(_search); }
    private async Task<List<Moneda>> Fetch()
    {
        try { var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<Moneda>>>(ApiRoutes.Estandar.Monedas); return r?.Data ?? new(); }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(Monedas), nameof(Fetch));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            return new();
        }
    }
    private async Task<List<Moneda>> FetchSearch(string s)
    {
        try { var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<Moneda>>>($"{ApiRoutes.Estandar.Monedas}/search?search={Uri.EscapeDataString(s)}"); return r?.Data ?? new(); }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(Monedas), nameof(FetchSearch));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            return new();
        }
    }

    private Task OnAccionHeader(BotonTreeviewItem b) { if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create); return Task.CompletedTask; }
    private Task OnAccionGrilla(Moneda item, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_GET    == true) return Abrir(item, CrudModo.Read);
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        return Task.CompletedTask;
    }

    private async Task Abrir(Moneda? item, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nueva moneda",
            CrudModo.Read   => $"Ver · {item?.DES_MONEDA}",
            CrudModo.Delete => $"Eliminar · {item?.DES_MONEDA}",
            _               => $"Editar · {item?.DES_MONEDA}"
        };
        var dlg = await DialogService.ShowAsync<MonedasDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    public void Dispose()
    {
        Cambios.Desuscribir("ESTANDAR.MONEDAS", _onCambio ?? (() => Task.CompletedTask));
        ShortcutSvc.NuevoRequested -= OnAtajoNuevo;
    }
}
