@page "/estandar/anos"
@attribute [Authorize]
@using KONSolutions.Shared.Models.Estandar
@inject CatalogoService<Ano, AnoDto> Service
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@inject ShortcutService ShortcutSvc
@inject ConfigService ConfigSvc
@implements IDisposable

<PageTitle>Años · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Años" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema ESTANDAR · @_visibles.Count de @_items.Count registros</MudText>
    </div>
    @* Sin SP _SEARCH — el filtro de texto es local sobre lo ya cargado. *@
    <BarraBusqueda @bind-Value="_searchTerm" OnSearch="Filtrar" Placeholder="Buscar año..." MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f => f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <GridPrintButton Titulo="Años" Headers="@_printHeaders" Rows="@PrintRows()" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="anos" style="position:relative;">
    <MudDataGrid T="Ano" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Sortable="false" Title="Código" Width="@Limites.ColWidth("ESTANDAR.ANOS","NUM_ANO",60,150)" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1">
                        <EncabezadoOrdenable Campo="NUM_ANO" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="Ano" ItemsBase="@BaseSinEstaColumna(0)"
                                            ValorDe="@(x => x.NUM_ANO.ToString())"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)"
                                            ValoresActivosChanged="@(v => AplicarFiltro(0, v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.NUM_ANO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Descripción" Width="@Limites.ColWidth("ESTANDAR.ANOS","DES_ANO",120,350)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1">
                        <EncabezadoOrdenable Campo="DES_ANO" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="Ano" ItemsBase="@BaseSinEstaColumna(1)"
                                            ValorDe="@(x => x.DES_ANO ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)"
                                            ValoresActivosChanged="@(v => AplicarFiltro(1, v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_ANO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b => OnAccionGrilla(item, b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin años registrados.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="Ano" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    [Parameter] public string CodAplicacion { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<Ano> _items = new();
    private string _searchTerm = string.Empty;
    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;
    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }
    private List<Ano> Ordenar(List<Ano> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.NUM_ANO).ToList() : items.OrderByDescending(x => x.NUM_ANO).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_ANO).ToList() : items.OrderByDescending(x => x.DES_ANO).ToList(),
        _ => items
    };

    private List<Ano> _visibles => Ordenar(AplicarTodos(Filtrados(), -1));
    private List<Ano> BaseSinEstaColumna(int col) => AplicarTodos(Filtrados(), col);

    private List<Ano> Filtrados() => string.IsNullOrWhiteSpace(_searchTerm)
        ? _items
        : _items.Where(x => (x.DES_ANO ?? "").Contains(_searchTerm, StringComparison.OrdinalIgnoreCase)
                          || x.NUM_ANO.ToString().Contains(_searchTerm)).ToList();

    private List<Ano> AplicarTodos(List<Ano> origen, int excluir)
    {
        IEnumerable<Ano> q = origen;
        foreach (var (col, vals) in _filtros)
        {
            if (col == excluir || vals is null) continue;
            q = col switch
            {
                0 => q.Where(x => vals.Contains(x.NUM_ANO.ToString())),
                1 => q.Where(x => vals.Contains(x.DES_ANO ?? "")),
                _ => q
            };
        }
        return q.ToList();
    }

    private void AplicarFiltro(int col, HashSet<string>? vals) { _filtros[col] = vals; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }
    private void Filtrar() => StateHasChanged();

    private readonly List<string> _printHeaders = new() { "Código", "Descripción" };
    private List<List<string>> PrintRows() => _items.Select(a => new List<string> { a.NUM_ANO.ToString(), a.DES_ANO ?? "" }).ToList();

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("ESTANDAR", "Anos");
        await Load();
        Cambios.Suscribir("ESTANDAR.ANOS", RefrescarPorCambio);
        ShortcutSvc.NuevoRequested += OnAtajoNuevo;
    }

    private async void OnAtajoNuevo() => await InvokeAsync(() => Open(null));

    private async Task Load() => _items = await Service.GetAllAsync();

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Open(null);
        return Task.CompletedTask;
    }

    private Task OnAccionGrilla(Ano item, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_GET    == true) return Ver(item);
        if (b.FLG_ACCION_PUT    == true) return Open(item);
        if (b.FLG_ACCION_DELETE == true) return Delete(item);
        return Task.CompletedTask;
    }

    private async Task Ver(Ano item)  => await AbrirDialog(item, CrudModo.Read);
    private async Task Open(Ano? a)   => await AbrirDialog(a, a is null ? CrudModo.Create : CrudModo.Update);
    private async Task Delete(Ano a)  => await AbrirDialog(a, CrudModo.Delete);

    private async Task AbrirDialog(Ano? a, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nuevo año",
            CrudModo.Read   => $"Ver · {a?.DES_ANO}",
            CrudModo.Update => $"Editar · {a?.DES_ANO}",
            CrudModo.Delete => $"Eliminar · {a?.DES_ANO}",
            _ => "Año"
        };
        var parameters = new DialogParameters { ["Item"] = a, ["Modo"] = modo };
        var dlg = await DialogService.ShowAsync<AnosDialog>(titulo, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    private async Task RefrescarPorCambio() => await InvokeAsync(async () => { await Load(); StateHasChanged(); });

    public void Dispose()
    {
        Cambios.Desuscribir("ESTANDAR.ANOS", RefrescarPorCambio);
        ShortcutSvc.NuevoRequested -= OnAtajoNuevo;
    }
}
