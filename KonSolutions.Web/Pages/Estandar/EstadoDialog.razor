@inject EstadoService Service
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog Style="width:min(820px,95vw);">
    <TitleContent>
        <CrudDialogTitle Modo="@(_isEdit ? CrudModo.Update : CrudModo.Create)"
                         Descripcion="@Item?.DES_ESTADO" />
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div style="display:flex;gap:16px;align-items:flex-start;">
                <div style="flex:1;min-width:0;">
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <CampoTexto Tabla="ESTANDAR.ESTADOS" Columna="DES_ESTADO"
                                        @bind-Value="_model.DES_ESTADO" Class="" />
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <CampoTexto Tabla="ESTANDAR.ESTADOS" Columna="COD_ESTADO_ALIAS"
                                        @bind-Value="_model.COD_ESTADO_ALIAS" Class="" />
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudNumericField @bind-Value="_model.NUM_ORDEN_PRESENTACION" Label="Orden"
                                             Variant="Variant.Outlined" Margin="Margin.Normal" Min="0"
                                             Culture="@System.Globalization.CultureInfo.CurrentCulture" />
                        </MudItem>

                        @* Colores Font y Fondo — componente genérico reutilizado de Configuración General *@
                        <MudItem xs="12" sm="6">
                            <ColorConSwatch @bind-Text="_model.DES_BACKCOLOR" Label="Fondo de fondo del estado" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <ColorConSwatch @bind-Text="_model.DES_FORECOLOR" Label="Color de texto (Font)" />
                        </MudItem>

                        @* Preview del chip con los colores elegidos *@
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Class="mono mb-1" Style="opacity:.6;">Vista previa:</MudText>
                            <MudChip T="string" Style="@($"background-color:{_model.DES_BACKCOLOR};color:{_model.DES_FORECOLOR};")">
                                @(string.IsNullOrWhiteSpace(_model.DES_ESTADO) ? "Estado" : _model.DES_ESTADO)
                            </MudChip>
                        </MudItem>

                        @* Tipo de motivo (acepta null) *@
                        <MudItem xs="12" sm="6">
                            <AriaCombo TItem="ComboboxItem"
                                         Items="_motivos"
                                         TextFunc="@(m => m.Texto)"
                                         ValueFunc="@(m => m.Id)"
                                         Value="_codTipoMotivoStr"
                                         ValueChanged="OnMotivoChanged"
                                         Label="Tipo de motivo (opcional)" />
                        </MudItem>

                        @* Flags *@
                        <MudItem xs="12" sm="6">
                            <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Star" Color="Color.Primary" Size="Size.Medium" />
                                <MudSwitch @bind-Value="_model.FLG_DEFAULT" Color="Color.Primary" Label="Por defecto" /></div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Email" Color="Color.Primary" Size="Size.Medium" />
                                <MudSwitch @bind-Value="_model.FLG_DISPARADOR_MAIL" Color="Color.Primary" Label="Dispara correo" /></div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Notifications" Color="Color.Primary" Size="Size.Medium" />
                                <MudSwitch @bind-Value="_model.FLG_DISPARADOR_NOTIFICACION" Color="Color.Primary" Label="Dispara notificación" /></div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Primary" Size="Size.Medium" />
                                <MudSwitch @bind-Value="_model.FLG_DISPARADOR_AUTORIZACION" Color="Color.Primary" Label="Dispara autorización" /></div>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Storefront" Color="Color.Primary" Size="Size.Medium" />
                                <MudSwitch @bind-Value="_model.FLG_DISPARADOR_AUTORIZACION_COMERCIAL" Color="Color.Primary" Label="Dispara autorización comercial" /></div>
                        </MudItem>
                    </MudGrid>
                </div>
                <div style="flex-shrink:0;padding-left:8px;border-left:1px solid rgba(0,0,0,.1);">
                    <ImagePicker Image="_model.IMG_PICTURE" ImageChanged="@(v => _model.IMG_PICTURE = v)" Label="Imagen del estado" />
                </div>
            </div>

            <CrudDialogActions Modo="@(_isEdit ? CrudModo.Update : CrudModo.Create)" Saving="_saving"
                               OnCancel="@(() => MudDialog.Cancel())">
                <LeftContent>
                    <PanelAuditoria CodUsuarioRegistro="@Item?.COD_USUARIO_REGISTRO"
                                    CodEstacionRegistro="@Item?.COD_ESTACION_REGISTRO"
                                    FecRegistro="@Item?.FEC_REGISTRO"
                                    CodUsuarioActualizacion="@Item?.COD_USUARIO_ACTUALIZACION"
                                    CodEstacionActualizacion="@Item?.COD_ESTACION_ACTUALIZACION"
                                    FecActualizacion="@Item?.FEC_ACTUALIZACION" />
                </LeftContent>
            </CrudDialogActions>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Estado? Item { get; set; }
    [Parameter] public int CodTipoEstado { get; set; }

    private EstadoDto _model = new();
    private bool _isEdit, _saving;
    private List<ComboboxItem> _motivos = new();
    private string? _codTipoMotivoStr;

    [Inject] private EstadoService EstadoSvc { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _motivos = await EstadoSvc.GetTiposMotivosAsync();
    }

    private void OnMotivoChanged(string? val)
    {
        _codTipoMotivoStr = val;
        // Acepta null: si se limpia el combo, COD_TIPO_MOTIVO queda null
        _model.COD_TIPO_MOTIVO = int.TryParse(val, out var n) ? n : (int?)null;
    }

    protected override void OnParametersSet()
    {
        _isEdit = Item is not null;
        if (_isEdit && Item is not null)
            _model = new EstadoDto
            {
                COD_TIPO_ESTADO = Item.COD_TIPO_ESTADO,
                COD_ESTADO = Item.COD_ESTADO,
                DES_ESTADO = Item.DES_ESTADO ?? "",
                COD_ESTADO_ALIAS = Item.COD_ESTADO_ALIAS,
                FLG_DEFAULT = Item.FLG_DEFAULT,
                FLG_DISPARADOR_MAIL = Item.FLG_DISPARADOR_MAIL,
                FLG_DISPARADOR_NOTIFICACION = Item.FLG_DISPARADOR_NOTIFICACION ?? false,
                FLG_DISPARADOR_AUTORIZACION = Item.FLG_DISPARADOR_AUTORIZACION,
                FLG_DISPARADOR_AUTORIZACION_COMERCIAL = Item.FLG_DISPARADOR_AUTORIZACION_COMERCIAL ?? false,
                NUM_ORDEN_PRESENTACION = Item.NUM_ORDEN_PRESENTACION ?? 0,
                COD_TIPO_MOTIVO = Item.COD_TIPO_MOTIVO,
                DES_BACKCOLOR = string.IsNullOrWhiteSpace(Item.DES_BACKCOLOR) ? "#FFFFFF" : Item.DES_BACKCOLOR,
                DES_FORECOLOR = string.IsNullOrWhiteSpace(Item.DES_FORECOLOR) ? "#000000" : Item.DES_FORECOLOR,
                IMG_PICTURE = Item.IMG_PICTURE
            };
        else
            _model = new EstadoDto { COD_TIPO_ESTADO = CodTipoEstado };

        // Crítico: EsNuevo se fija explícitamente según si hay Item, sin depender de estado previo.
        _model.EsNuevo = !_isEdit;
        _codTipoMotivoStr = _model.COD_TIPO_MOTIVO?.ToString();
    }

    private async Task Submit()
    {
        _model.COD_TIPO_ESTADO = CodTipoEstado;
        _saving = true;
        var (ok, msg) = await Service.GuardarAsync(_model);
        _saving = false;
        if (ok) { Snackbar.Add(_isEdit ? "Estado actualizado." : "Estado creado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarMensajeAsync(msg, DialogService, nameof(EstadoDialog));
    }
}
