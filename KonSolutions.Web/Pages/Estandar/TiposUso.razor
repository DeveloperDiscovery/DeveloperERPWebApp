@page "/estandar/tipos-uso"
@attribute [Authorize]
@using TiposUsoModel = KONSolutions.Shared.Models.Estandar.TiposUso
@using System.Net.Http.Json
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject ShortcutService ShortcutSvc
@implements IDisposable

<PageTitle>Tipos de Uso · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Tipos de Uso" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema ESTANDAR · @_visibles.Count de @_items.Count registros</MudText>
    </div>
    @* Búsqueda en cliente: ESTANDAR.TIPOS_USO no tiene SP SEARCH, y el catálogo
       es pequeño, así que se filtra sobre el listado ya cargado. *@
    <BarraBusqueda @bind-Value="_search" OnSearch="@(() => Task.CompletedTask)" Placeholder="Buscar tipo de uso..." DebounceInterval="300" MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f=>f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="LoadItems" />
        <AccionesBotones CodAplicacion="@_codAp" CodOpcionAplicacion="@_codOp"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="tipos-uso" data-default-height="480" style="position:relative;">
    <MudDataGrid T="TiposUsoModel" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 FixedHeader="true" Height="100%" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaPadre">
        <Columns>
            <TemplateColumn Title="Código" Sortable="false" Width="120">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Código" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="TiposUsoModel" ItemsBase="@Base(0)" ValorDe="@(x=>x.COD_TIPO_USO)"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.COD_TIPO_USO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Descripción" Sortable="false">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Descripción" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="TiposUsoModel" ItemsBase="@Base(1)" ValorDe="@(x=>x.DES_TIPO_USO)"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_TIPO_USO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false" Width="140">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@_codAp" CodOpcionAplicacion="@_codOp"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Class="pa-6 mono" Style="opacity:.5;">Sin registros.</MudText>
        </NoRecordsContent>
        <PagerContent><MudDataGridPager T="TiposUsoModel" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    private Func<Task>? _onCambio;

    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private string _codAp => CodAplicacion;
    private string _codOp => CodOpcionAplicacion;

    private List<TiposUsoModel> _items = new();

    private string _search = "";

    private List<TiposUsoModel> _busqueda =>
        string.IsNullOrWhiteSpace(_search) ? _items
        : _items.Where(c => (c.COD_TIPO_USO?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                          || (c.DES_TIPO_USO?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;

    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }

    private List<TiposUsoModel> Ordenar(List<TiposUsoModel> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.COD_TIPO_USO).ToList() : items.OrderByDescending(x => x.COD_TIPO_USO).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_TIPO_USO).ToList() : items.OrderByDescending(x => x.DES_TIPO_USO).ToList(),
        _ => items
    };

    private List<TiposUsoModel> _visibles => Ordenar(Aplicar(_busqueda, -1));
    private List<TiposUsoModel> Base(int col) => Aplicar(_busqueda, col);

    private List<TiposUsoModel> Aplicar(List<TiposUsoModel> src, int ex)
    {
        IEnumerable<TiposUsoModel> q = src;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(x.COD_TIPO_USO)),
                1 => q.Where(x => v.Contains(x.DES_TIPO_USO)),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("ESTANDAR", "TiposUso");
        await LoadItems();

        _onCambio = async () => await InvokeAsync(async () => { await LoadItems(); StateHasChanged(); });
        Cambios.Suscribir("ESTANDAR.TIPOS_USO", _onCambio);
        ShortcutSvc.NuevoRequested += OnAtajoNuevo;
    }

    private async void OnAtajoNuevo() => await InvokeAsync(() => Abrir(null, CrudModo.Create));

    private async Task LoadItems()
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<TiposUsoModel>>>(
                ApiRoutes.Estandar.TiposUso);
            _items = r?.Data ?? new();
        }
        catch { _items = new(); }
    }

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create);
        return Task.CompletedTask;
    }

    private Task OnAccionGrilla(TiposUsoModel item, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        if (b.FLG_ACCION_GET    == true) return Abrir(item, CrudModo.Read);
        return Task.CompletedTask;
    }

    private async Task Abrir(TiposUsoModel? item, CrudModo modo)
    {
        var dlg = await DialogService.ShowAsync<TipoUsoDialog>(
            modo switch
            {
                CrudModo.Create => "Nuevo tipo de uso",
                CrudModo.Delete => $"Eliminar · {item?.DES_TIPO_USO}",
                CrudModo.Read   => $"Consultar · {item?.DES_TIPO_USO}",
                _               => $"Editar · {item?.DES_TIPO_USO}"
            },
            new DialogParameters { ["Item"] = item, ["Modo"] = modo },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await LoadItems();
    }

    public void Dispose()
    {
        Cambios.Desuscribir("ESTANDAR.TIPOS_USO", _onCambio ?? (() => Task.CompletedTask));
        ShortcutSvc.NuevoRequested -= OnAtajoNuevo;
    }
}
