@page "/estandar/tipos-producto"
@attribute [Authorize]
@using TiposProductoModel = KONSolutions.Shared.Models.Estandar.TiposProducto
@using System.Net.Http.Json
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@inject ShortcutService ShortcutSvc
@implements IDisposable
@inject ErrorLogService ErrorLog

<PageTitle>Tipos de Producto · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Tipos de Producto" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema ESTANDAR · @_visibles.Count de @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="Buscar" Placeholder="Buscar tipo de producto..." DebounceInterval="400" MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f=>f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <GridPrintButton Titulo="Tipos de Producto"
                         Headers="@(new List<string>{"Código","Descripción","Comprado","Servicio","Gastos","Industrializado","Genérico","En Desarrollo"})"
                         Rows="@(_items.Select(x=>new List<string>{
                             x.COD_TIPO_PRODUCTO,
                             x.DES_TIPO_PRODUCTO,
                             (x.FLG_COMPRADO==true?"Sí":"No"),
                             (x.FLG_SERVICIO==true?"Sí":"No"),
                             (x.FLG_GASTOS==true?"Sí":"No"),
                             (x.FLG_INDUSTRIALIZADO==true?"Sí":"No"),
                             (x.FLG_GENERICO==true?"Sí":"No"),
                             (x.FLG_DESARROLLO==true?"Sí":"No")
                         }).ToList())" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="tipos-producto" style="position:relative;">
    <MudDataGrid T="TiposProductoModel" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Sortable="false" Title="Código"
                            Width="@Limites.ColWidth("ESTANDAR.TIPOS_PRODUCTO","COD_TIPO_PRODUCTO",60,120)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_TIPO_PRODUCTO" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="TiposProductoModel" ItemsBase="@Base(0)" ValorDe="@(x=>x.COD_TIPO_PRODUCTO)"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.COD_TIPO_PRODUCTO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Descripción"
                            Width="@Limites.ColWidth("ESTANDAR.TIPOS_PRODUCTO","DES_TIPO_PRODUCTO",150,400)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_TIPO_PRODUCTO" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="TiposProductoModel" ItemsBase="@Base(1)" ValorDe="@(x=>x.DES_TIPO_PRODUCTO)"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_TIPO_PRODUCTO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Clasificación" Sortable="false" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <CellTemplate>
                    <div class="d-flex align-center justify-center gap-2">
                        <MudTooltip Text="Comprado">
                            <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Color="@(context.Item.FLG_COMPRADO == true ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_COMPRADO == true ? "" : "opacity:.15;")" Size="Size.Small" />
                        </MudTooltip>
                        <MudTooltip Text="Servicio">
                            <MudIcon Icon="@Icons.Material.Filled.MiscellaneousServices" Color="@(context.Item.FLG_SERVICIO == true ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_SERVICIO == true ? "" : "opacity:.15;")" Size="Size.Small" />
                        </MudTooltip>
                        <MudTooltip Text="Gastos">
                            <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="@(context.Item.FLG_GASTOS == true ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_GASTOS == true ? "" : "opacity:.15;")" Size="Size.Small" />
                        </MudTooltip>
                        <MudTooltip Text="Industrializado">
                            <MudIcon Icon="@Icons.Material.Filled.Factory" Color="@(context.Item.FLG_INDUSTRIALIZADO == true ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_INDUSTRIALIZADO == true ? "" : "opacity:.15;")" Size="Size.Small" />
                        </MudTooltip>
                        <MudTooltip Text="Genérico">
                            <MudIcon Icon="@Icons.Material.Filled.AllInclusive" Color="@(context.Item.FLG_GENERICO == true ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_GENERICO == true ? "" : "opacity:.15;")" Size="Size.Small" />
                        </MudTooltip>
                        <MudTooltip Text="En Desarrollo">
                            <MudIcon Icon="@Icons.Material.Filled.Construction" Color="@(context.Item.FLG_DESARROLLO == true ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_DESARROLLO == true ? "" : "opacity:.15;")" Size="Size.Small" />
                        </MudTooltip>
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Tipo de Estado" Sortable="false"
                            Width="@Limites.ColWidth("ESTANDAR.TIPOS_PRODUCTO","COD_TIPO_ESTADO_INICIAL",120,220)">
                <CellTemplate>@context.Item.DES_TIPO_ESTADO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Estado Inicial" Sortable="false"
                            Width="@Limites.ColWidth("ESTANDAR.TIPOS_PRODUCTO","COD_ESTADO_INICIAL",120,220)">
                <CellTemplate>
                    <EstadoChip Estado="@context.Item.DES_ESTADO" BackColor="@context.Item.DES_BACKCOLOR" ForeColor="@context.Item.DES_FORECOLOR" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin registros.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="TiposProductoModel" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    private Func<Task>? _onCambio;
    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<TiposProductoModel> _items  = new();
    private string _search = "";
    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;
    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }
    private List<TiposProductoModel> Ordenar(List<TiposProductoModel> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.COD_TIPO_PRODUCTO).ToList() : items.OrderByDescending(x => x.COD_TIPO_PRODUCTO).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_TIPO_PRODUCTO).ToList() : items.OrderByDescending(x => x.DES_TIPO_PRODUCTO).ToList(),
        _ => items
    };
    private List<TiposProductoModel> _visibles => Ordenar(Aplicar(_items, -1));
    private List<TiposProductoModel> Base(int col) => Aplicar(_items, col);

    private List<TiposProductoModel> Aplicar(List<TiposProductoModel> src, int ex)
    {
        IEnumerable<TiposProductoModel> q = src;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(x.COD_TIPO_PRODUCTO)),
                1 => q.Where(x => v.Contains(x.DES_TIPO_PRODUCTO)),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }

    private async Task Buscar()
    {
        _items = string.IsNullOrWhiteSpace(_search)
            ? await Fetch()
            : await FetchSearch(_search);
    }

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("ESTANDAR", "TiposProducto");
        await Load();
        _onCambio = async () => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        Cambios.Suscribir("ESTANDAR.TIPOS_PRODUCTO", _onCambio);
        ShortcutSvc.NuevoRequested += OnAtajoNuevo;
    }

    private async void OnAtajoNuevo() => await InvokeAsync(() => Abrir(null, CrudModo.Create));

    private async Task Load() => _items = string.IsNullOrWhiteSpace(_search) ? await Fetch() : await FetchSearch(_search);

    private async Task<List<TiposProductoModel>> Fetch()
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<TiposProductoModel>>>(
                ApiRoutes.Estandar.TiposProducto);
            return r?.Data ?? new();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(TiposProducto), nameof(Fetch));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            return new();
        }
    }

    private async Task<List<TiposProductoModel>> FetchSearch(string s)
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<TiposProductoModel>>>(
                $"{ApiRoutes.Estandar.TiposProducto}/search?search={Uri.EscapeDataString(s)}");
            return r?.Data ?? new();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(TiposProducto), nameof(FetchSearch));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            return new();
        }
    }

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create);
        return Task.CompletedTask;
    }

    private Task OnAccionGrilla(TiposProductoModel item, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        return Task.CompletedTask;
    }

    private async Task Abrir(TiposProductoModel? item, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nuevo tipo de producto",
            CrudModo.Delete => $"Eliminar · {item?.DES_TIPO_PRODUCTO}",
            _               => $"Editar · {item?.DES_TIPO_PRODUCTO}"
        };
        var dlg = await DialogService.ShowAsync<TiposProductoDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    public void Dispose()
    {
        Cambios.Desuscribir("ESTANDAR.TIPOS_PRODUCTO", _onCambio ?? (() => Task.CompletedTask));
        ShortcutSvc.NuevoRequested -= OnAtajoNuevo;
    }
}
