        _familias    = _familiasCompletas.Select(f => new ComboboxItem { Id = f.COD_FAMILIA_PRODUCTO.Trim(), Texto = f.DES_FAMILIA_PRODUCTO }).ToList();
        _subFamilias = new();
    }

    private async Task OnFamiliaChanged(string? val)
    {
        _model.COD_FAMILIA_PRODUCTO     = val;
        _model.COD_SUB_FAMILIA_PRODUCTO = null;
        _model.COD_TIPO_PRODUCTO        = null;
        _model.COD_CUBSO                = null;
        _model.COD_TIPO_VALOR_CALCULO   = null;
        _model.COD_UNIDAD_MEDIDA        = null;
        _model.COD_UNIDAD_MEDIDA_SECUNDARIA = null;
        _subFamiliasCompletas = (string.IsNullOrEmpty(val) || string.IsNullOrEmpty(_model.COD_GRUPO_PRODUCTO))
            ? new() : (await CargarSubFamilias(_model.COD_GRUPO_PRODUCTO!, val!)) ?? new();
        _subFamilias = _subFamiliasCompletas.Select(s => new ComboboxItem { Id = s.COD_SUB_FAMILIA_PRODUCTO.Trim(), Texto = s.DES_SUB_FAMILIA_PRODUCTO }).ToList();
    }

    // Al elegir/cambiar la Sub Familia (combo editable), hereda su Tipo de Producto, CUBSO,
    // Tipo de Valor de Cálculo, Unidad de Medida y Unidad de Medida Secundaria — el usuario
    // puede seguir cambiándolos después, es solo el valor sugerido.
    private void OnSubFamiliaChanged(string? val)
    {
        _model.COD_SUB_FAMILIA_PRODUCTO = val;
        var subFamiliaPadre = _subFamiliasCompletas.FirstOrDefault(s => s.COD_SUB_FAMILIA_PRODUCTO.Trim() == val);
        _model.COD_TIPO_PRODUCTO            = subFamiliaPadre?.COD_TIPO_PRODUCTO?.Trim();
        _model.COD_CUBSO                     = subFamiliaPadre?.COD_CUBSO?.Trim();
        _model.COD_TIPO_VALOR_CALCULO       = subFamiliaPadre?.COD_TIPO_VALOR_CALCULO?.Trim();
        _model.COD_UNIDAD_MEDIDA             = subFamiliaPadre?.COD_UNIDAD_MEDIDA?.Trim();
        _model.COD_UNIDAD_MEDIDA_SECUNDARIA = subFamiliaPadre?.COD_UNIDAD_MEDIDA_SECUNDARIA?.Trim();
        HeredarEstadoDeTipoProducto();
    }

    // Al elegir/cambiar el Tipo de Producto directamente (combo editable), hereda su Estado
    // Inicial — el usuario puede seguir cambiándolo después, es solo el valor sugerido.
    private void OnTipoProductoChanged(string? val)
    {
        _model.COD_TIPO_PRODUCTO = val;
        HeredarEstadoDeTipoProducto();
    }

    private async Task Submit()
    {
        _saving = true;
        var ruta = ProductosRoute.Productos;
        if (Modo == CrudModo.Delete)
        {
            var rd = await Http.DeleteAsync($"{ruta}/{Uri.EscapeDataString(_model.COD_PRODUCTO)}");
            _saving = false;
            if (rd.IsSuccessStatusCode) { Snackbar.Add("Eliminado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
            else await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(ProductosDialog), nameof(Submit), "No se pudo eliminar el registro");
            return;
        }
        _model.COD_TIPO_ESTADO = _codTipoEstado;
        // Nuevo: el SP arma el código internamente, se manda vacío (el parámetro no
        // admite NULL, pero su valor real se ignora al crear).
        // Los códigos opcionales (FK contra otras tablas) deben ir en NULL cuando no se
        // eligió nada — mandarlos como "" viola la FK (error 547) porque "" no es un
        // código válido ni NULL.
        static string? NullSiVacio(string? v) => string.IsNullOrWhiteSpace(v) ? null : v;
        var dto = new
        {
            COD_PRODUCTO = _esNuevo ? "" : _model.COD_PRODUCTO,
            _model.DES_PRODUCTO, _model.DES_DETALLADA, _model.COD_ENTIDAD_PROPIETARIA,
            COD_DISENO = NullSiVacio(_model.COD_DISENO), _model.NUM_VERSION, _model.COD_UNIDAD_MEDIDA,
            COD_UNIDAD_MEDIDA_SECUNDARIA = NullSiVacio(_model.COD_UNIDAD_MEDIDA_SECUNDARIA),
            _model.COD_GRUPO_PRODUCTO, _model.COD_FAMILIA_PRODUCTO, _model.COD_SUB_FAMILIA_PRODUCTO,
            COD_PARTIDA_ARANCELARIA = NullSiVacio(_model.COD_PARTIDA_ARANCELARIA),
            COD_TIPO_VALOR_CALCULO = NullSiVacio(_model.COD_TIPO_VALOR_CALCULO),
            _model.COD_TIPO_PRODUCTO,
            COD_CUBSO = NullSiVacio(_model.COD_CUBSO),
            _model.COD_TIPO_ESTADO, _model.COD_ESTADO
        };
        var resp = await Http.PostAsJsonAsync(ruta, dto);
        _saving = false;
        if (resp.IsSuccessStatusCode) { Snackbar.Add(_esNuevo ? "Creado." : "Modificado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(ProductosDialog), nameof(Submit));
    }

    private async Task CargarEspecificacionesTecnicas()
    {
        _cargandoEspecificaciones = true;
        _especificacionesAsignadas = new();
        _itemsPorEspec = new();

        try
        {
            // El SHOWALL de PRODUCTOS_ESPECIFICACIONES_TECNICAS ya dice qué Especificaciones
            // aplican a este Producto puntual (una fila por cada una) y trae también el tipo de
            // dato de cada una (FLG_LISTA/ENTERO/NUMERICO/CADENA/FECHA_HORA/FECHA/HORA/LOGICO/
            // COLOR) — no hace falta ir a buscar por Grupo/Familia/Sub Familia aparte.
            var rVal = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<ProductoEspecTecnicaModel>>>(
                $"{ProductosRoute.ProductosEspecificacionesTecnicas}?codProducto={Uri.EscapeDataString(_model.COD_PRODUCTO)}");
            // Esta ficha es la de "Ficha Técnica" — solo se muestran las Especificaciones
            // marcadas FLG_FICHA_TECNICA = true (las de Registro Comercial / Control de
            // Calidad se ven en sus propios paneles del simulador de Grupos de Especificación).
            var filas = (rVal?.Data ?? new()).Where(v => v.FLG_FICHA_TECNICA == true).ToList();

            // El SHOWALL ya trae DES_ESPECIFICACION_TECNICA_SINGULAR y
            // COD_ESPECIFICACION_TECNICA_PADRE — no hace falta el treelist para el nombre ni
            // para saber de qué Especificación depende cada una.
            _especificacionesAsignadas = filas.Select(v =>
            {
                var codigo = v.COD_ESPECIFICACION_TECNICA.Trim();
                var tipo = DeterminarTipo(v);
                string descripcion = !string.IsNullOrWhiteSpace(v.DES_ESPECIFICACION_TECNICA_SINGULAR)
                    ? v.DES_ESPECIFICACION_TECNICA_SINGULAR
                    : (!string.IsNullOrWhiteSpace(v.DES_ESPECIFICACION_TECNICA) ? v.DES_ESPECIFICACION_TECNICA : codigo);

                var info = new EspecInfo
                {
                    Codigo = codigo,
                    Descripcion = descripcion,
                    NumOrdenPresentacion = v.NUM_ORDEN_PRESENTACION,
                    FlgIncluirDescripcion = v.FLG_INCLUIR_DESCRIPCION,
                    CodGrupoEspecificacionTecnica = v.COD_GRUPO_ESPECIFICACION_TECNICA,
                    DesGrupoEspecificacionTecnica = v.DES_GRUPO_ESPECIFICACION_TECNICA,
                    CodEspecificacionTecnicaPadre = string.IsNullOrWhiteSpace(v.COD_ESPECIFICACION_TECNICA_PADRE) ? null : v.COD_ESPECIFICACION_TECNICA_PADRE.Trim(),
                    Tipo = tipo,
                    CanEntero = v.CAN_ENTERO,
                    CanDecimal = v.CAN_DECIMAL,
                    DesPrefijo = v.DES_PREFIJO,
                    DesSufijo = v.DES_SUFIJO,
                    FlgRange = v.FLG_RANGE == true,
                    DesUnidadMedida = v.DES_UNIDAD_MEDIDA,
                    CodSimbolo = v.COD_SIMBOLO,
                    CodItemTecnico = v.COD_ITEM_TECNICO?.ToString(),
                    ValTexto = tipo == TipoControlEspec.Cadena ? v.STR_ESPECIFICACION_TENICA : v.VAL_ESPECIFICACION_TENICA,
                    ValFecha = v.FEC_ESPECIFICACION_TENICA,
                    ValHora = v.HOR_ESPECIFICACION_TENICA,
                    ValLogico = v.LOG_ESPECIFICACION_TENICA,
                    ValMinimo = v.VAL_MINIMO,
                    ValMaximo = v.VAL_MAXIMO,
                    CodUsuarioRegistro = v.COD_USUARIO_REGISTRO,
                    CodEstacionRegistro = v.COD_ESTACION_REGISTRO,
                    FecRegistro = v.FEC_REGISTRO,
                    CodUsuarioActualizacion = v.COD_USUARIO_ACTUALIZACION,
                    CodEstacionActualizacion = v.COD_ESTACION_ACTUALIZACION,
                    FecActualizacion = v.FEC_ACTUALIZACION,
                };
                if (tipo is TipoControlEspec.Entero or TipoControlEspec.Numerico && !info.FlgRange)
                {
                    if (tipo == TipoControlEspec.Entero && int.TryParse(v.VAL_ESPECIFICACION_TENICA, out var ei)) info.ValEntero = ei;
                    if (tipo == TipoControlEspec.Numerico && decimal.TryParse(v.VAL_ESPECIFICACION_TENICA, out var ed)) info.ValDecimal = ed;
                }
                return info;
            }).ToList();

            // Orden = el del resultset (NUM_ORDEN_PRESENTACION), pero cada Especificación que
            // depende de otra (ej. MODELO depende de MARCA) se intercala justo después de su
            // padre — en vez de quedar salteada al final según su propio NUM_ORDEN_PRESENTACION —
            // para que la ficha se lea igual que la jerarquía del módulo de asignación.
            _especificacionesAsignadas = OrdenarConDependientes(_especificacionesAsignadas);

            // Los combos de las que dependen de otra (ej. MODELO depende de MARCA) necesitan
            // que el padre ya esté en _especificacionesAsignadas para poder leer su valor
            // elegido (PadreDe) — por eso este pase va DESPUÉS de armar toda la lista, no
            // dentro del Select de arriba.
            _itemsPorEspec = new();
            foreach (var espec in _especificacionesAsignadas.Where(e => e.Tipo == TipoControlEspec.Lista))
                await CargarItemsListaAsync(espec);
        }
        catch { _especificacionesAsignadas = new(); }

        _cargandoEspecificaciones = false;
    }

    private async Task GuardarEspecificaciones()
    {
        _guardandoEspecificaciones = true;
        var huboError = false;
        foreach (var espec in _especificacionesAsignadas)
        {
            var dto = new
            {
                COD_PRODUCTO = _model.COD_PRODUCTO,
                COD_ESPECIFICACION_TECNICA = espec.Codigo,
                COD_ITEM_TECNICO = espec.Tipo == TipoControlEspec.Lista && int.TryParse(espec.CodItemTecnico, out var ci) ? ci : (int?)null,
                FEC_ESPECIFICACION_TENICA = espec.Tipo is TipoControlEspec.Fecha or TipoControlEspec.FechaHora ? espec.ValFecha : null,
                HOR_ESPECIFICACION_TENICA = espec.Tipo is TipoControlEspec.Hora or TipoControlEspec.FechaHora ? espec.ValHora : null,
                LOG_ESPECIFICACION_TENICA = espec.Tipo == TipoControlEspec.Logico ? espec.ValLogico : null,
                STR_ESPECIFICACION_TENICA = espec.Tipo == TipoControlEspec.Cadena ? espec.ValTexto : null,
                VAL_ESPECIFICACION_TENICA = espec.Tipo switch
                {
                    TipoControlEspec.Entero when !espec.FlgRange => espec.ValEntero?.ToString(),
                    TipoControlEspec.Numerico when !espec.FlgRange => espec.ValDecimal?.ToString(),
                    TipoControlEspec.Color => espec.ValTexto,
                    _ => null
                },
                VAL_MINIMO = espec.Tipo is TipoControlEspec.Entero or TipoControlEspec.Numerico && espec.FlgRange ? espec.ValMinimo : null,
                VAL_MAXIMO = espec.Tipo is TipoControlEspec.Entero or TipoControlEspec.Numerico && espec.FlgRange ? espec.ValMaximo : null,
                NUM_ORDEN_PRESENTACION = espec.NumOrdenPresentacion,
                FLG_INCLUIR_DESCRIPCION = espec.FlgIncluirDescripcion,
                COD_GRUPO_ESPECIFICACION_TECNICA = espec.CodGrupoEspecificacionTecnica,
            };
            var resp = await Http.PostAsJsonAsync(ProductosRoute.ProductosEspecificacionesTecnicas, dto);
            if (!resp.IsSuccessStatusCode)
            {
                huboError = true;
                // Centralizado: mismo diálogo de error (con detalle SQL) que usa Submit() —
                // antes acá solo se acumulaba un flag y se mostraba un Snackbar genérico sin
                // el motivo real (ej. parámetro faltante en el SP).
                await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(ProductosDialog), nameof(GuardarEspecificaciones),
                    $"No se pudo guardar \"{espec.Descripcion}\"");
            }
        }
        // Recalcula DES_DETALLADA (dbo.FNC_PRODUCTO_MAKE_DESCRIPCION) con los valores recién
        // guardados — solo si no hubo errores, para no pisar la descripción con datos a medio
        // guardar. No es un fallo bloqueante: si el propio recálculo falla, ya se guardaron las
        // especificaciones igual, así que solo se registra sin mostrar diálogo de error aparte.
        if (!huboError)
        {
            try { await Http.PostAsync(ProductosRoute.ProductosActualizarDescripcionDetalle(_model.COD_PRODUCTO), null); }
            catch { }
            // Refresca la ficha (pestaña "Información Básica") con el SHOWBYID para que
            // DES_DETALLADA se vea recalculada al toque, sin cerrar y reabrir el diálogo.
            await RecargarDesdeShowbyidAsync();
        }
        _guardandoEspecificaciones = false;
        if (!huboError) Snackbar.Add("Especificaciones guardadas.", Severity.Success);
    }
}
