    // Grupos/Familias completos (no solo Id/Texto) — necesarios para recargar las
    // cascadas Familia/SubFamilia al editar un producto ya existente.
    private List<FamiliasProductoModel> _familiasCompletas = new();
    // Sub Familias completas — se usa para heredar COD_TIPO_PRODUCTO de la Sub Familia
    // elegida al crear un Producto nuevo.
