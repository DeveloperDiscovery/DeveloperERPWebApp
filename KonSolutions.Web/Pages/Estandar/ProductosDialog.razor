    // al crear un Producto nuevo, ya sea al elegir el Tipo de Producto directamente o al
    // heredarlo en cadena desde la Sub Familia.
    private List<TiposProductoModel> _tiposProductoCompletos = new();

    protected override void OnInitialized()
    {
        _esNuevo = Modo == CrudModo.Create;
        // Mapeo inicial desde el Item que pasó la grilla — se usa como fallback mientras
        // se resuelve el viaje a SHOWBYID (abajo, en OnInitializedAsync) o si ese viaje
        // falla; una vez que responde, MapearDesdeModelo() pisa estos valores con los
        // frescos de la base de datos.
        if (Item is not null) MapearDesdeModelo(Item);
        _editContext = new EditContext(_model);
    }

    /// <summary>Copia los campos editables del modelo (Item de la grilla, o la respuesta
    /// fresca de SHOWBYID) hacia _model.</summary>
    private void MapearDesdeModelo(ProductosModel m)
    {
        _model.COD_PRODUCTO                 = m.COD_PRODUCTO;
        _model.DES_PRODUCTO                 = m.DES_PRODUCTO;
        _model.DES_DETALLADA                = m.DES_DETALLADA;
        _model.COD_ENTIDAD_PROPIETARIA       = m.COD_ENTIDAD_PROPIETARIA;
        _model.COD_DISENO                   = m.COD_DISENO;
        _model.NUM_VERSION                  = m.NUM_VERSION;
        _model.COD_UNIDAD_MEDIDA            = m.COD_UNIDAD_MEDIDA?.Trim();
        _model.COD_UNIDAD_MEDIDA_SECUNDARIA = m.COD_UNIDAD_MEDIDA_SECUNDARIA?.Trim();
        _model.COD_GRUPO_PRODUCTO           = m.COD_GRUPO_PRODUCTO?.Trim();
        _model.COD_FAMILIA_PRODUCTO         = m.COD_FAMILIA_PRODUCTO?.Trim();
        _model.COD_SUB_FAMILIA_PRODUCTO     = m.COD_SUB_FAMILIA_PRODUCTO?.Trim();
        _model.COD_PARTIDA_ARANCELARIA      = m.COD_PARTIDA_ARANCELARIA;
        _model.COD_TIPO_VALOR_CALCULO       = m.COD_TIPO_VALOR_CALCULO?.Trim();
        _model.COD_TIPO_PRODUCTO            = m.COD_TIPO_PRODUCTO?.Trim();
        _model.COD_CUBSO                    = m.COD_CUBSO?.Trim();
        _model.COD_TIPO_ESTADO              = m.COD_TIPO_ESTADO;
        _model.COD_ESTADO                   = m.COD_ESTADO;
    }

    /// <summary>Trae el Producto fresco desde PROC_ESTANDAR_PRODUCTOS_SHOWBYID — se usa al
    /// abrir el diálogo (Modificar/Eliminar/Ver, nunca Crear) para no mostrar datos
    /// desactualizados de la grilla (ej. DES_DETALLADA recién recalculada por
    /// PROC_ESTANDAR_PRODUCTOS_DESCRIPCION_DETALLE_UPDATE), y otra vez después de guardar
    /// Especificaciones Técnicas, para reflejar esa misma descripción recalculada sin
    /// tener que cerrar y reabrir el diálogo.</summary>
    private async Task RecargarDesdeShowbyidAsync()
    {
        var fresco = await Http.SafeGetAsync<ProductosModel>($"{ProductosRoute.Productos}/{Uri.EscapeDataString(_model.COD_PRODUCTO)}");
        if (fresco is not null) MapearDesdeModelo(fresco);
    }

    /// <summary>Abre la Ficha Técnica (PDF) como MudDialog — NO navega de ruta (eso perdía la
    /// sesión al abrir una pestaña nueva porque el JWT vive en sessionStorage, y además volver
    /// re-montaba MainLayout recargando menú/configuración). Queda dentro del mismo diálogo
    /// de Producto, sin tocar el shell de la app.</summary>
    private async Task AbrirFichaTecnica()
    {
        var parametros = new DialogParameters { ["CodProducto"] = _model.COD_PRODUCTO };
        await DialogService.ShowAsync<FichaTecnicaProductoDialog>("Ficha Técnica",
            parametros, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
    }

    protected override async Task OnInitializedAsync()
    {
        if (!_esNuevo && Item is not null) await RecargarDesdeShowbyidAsync();

        // Un solo viaje: PROC_ESTANDAR_PRODUCTOS_LOAD_COMBOS invoca en cadena los 7
        // SHOWCOMBOX (Grupos, Unidades de Medida, Tipos de Producto, Diseños, Entidades,
        // Cubso, Estados) — la API ya resuelve el mapeo de los que no vienen aliasados
        // como Id/Texto (ver ProductosRepository.LoadcombosAsync).
        var tLoadcombos       = Http.SafeGetAsync<ProductosLoadCombosResult>(ProductosRoute.ProductosLoadcombos);
        var tTiposValorCalculo= SafeGetCombobox(KONSolutions.Web.Services.ApiRoutes.Comercial.TiposValorCalculoCombobox);
        var tFamilias         = string.IsNullOrEmpty(_model.COD_GRUPO_PRODUCTO) ? Task.FromResult<List<FamiliasProductoModel>?>(null) : CargarFamilias(_model.COD_GRUPO_PRODUCTO!);
        var tSubFamilias      = (string.IsNullOrEmpty(_model.COD_GRUPO_PRODUCTO) || string.IsNullOrEmpty(_model.COD_FAMILIA_PRODUCTO))
                                    ? Task.FromResult<List<SubFamiliasProductoModel>?>(null)
                                    : CargarSubFamilias(_model.COD_GRUPO_PRODUCTO!, _model.COD_FAMILIA_PRODUCTO!);
        var tTiposProducto    = Http.SafeGetAsync<List<TiposProductoModel>>(ProductosRoute.TiposProducto);

        await Task.WhenAll(tLoadcombos, tTiposValorCalculo, tFamilias, tSubFamilias, tTiposProducto);
        _tiposProductoCompletos = (await tTiposProducto) ?? new();

        var lc = await tLoadcombos;
        if (lc is not null)
        {
            _codTipoEstado  = lc.CodTipoEstado;
            _grupos         = lc.Grupos;
            _unidadesMedida = lc.UnidadesMedida;
            _tiposProducto  = lc.TiposProducto;
            _disenos        = lc.Disenos;
            _entidades      = lc.Entidades;
            _cubso          = lc.Cubso;
            _estados        = lc.Estados;
            if (_esNuevo && _model.COD_ESTADO is null && _estados.Any())
            {
                var def = _estados.FirstOrDefault(e => e.EsDefault) ?? _estados.First();
                _model.COD_ESTADO      = def.CodEstado;
                _model.COD_TIPO_ESTADO = _codTipoEstado;
            }
        }
        _tiposValorCalculo = await tTiposValorCalculo;

        _familiasCompletas = (await tFamilias) ?? new();
        _familias    = _familiasCompletas.Select(f => new ComboboxItem { Id = f.COD_FAMILIA_PRODUCTO.Trim(), Texto = f.DES_FAMILIA_PRODUCTO }).ToList();
        _subFamiliasCompletas = (await tSubFamilias) ?? new();
        _subFamilias = _subFamiliasCompletas.Select(s => new ComboboxItem { Id = s.COD_SUB_FAMILIA_PRODUCTO.Trim(), Texto = s.DES_SUB_FAMILIA_PRODUCTO }).ToList();

        // Al abrir "Nuevo" ya con una Sub Familia fijada por contexto, hereda su Tipo de
        // Producto, CUBSO, Tipo de Valor de Cálculo, Unidad de Medida y Unidad de Medida
        // Secundaria — todos los combos siguen editables, solo se precarga el valor.
        if (_esNuevo && !string.IsNullOrEmpty(_model.COD_SUB_FAMILIA_PRODUCTO))
        {
            var subFamiliaPadre = _subFamiliasCompletas.FirstOrDefault(s => s.COD_SUB_FAMILIA_PRODUCTO.Trim() == _model.COD_SUB_FAMILIA_PRODUCTO);
            if (subFamiliaPadre is not null)
            {
                _model.COD_TIPO_PRODUCTO            = subFamiliaPadre.COD_TIPO_PRODUCTO?.Trim();
                _model.COD_CUBSO                     = subFamiliaPadre.COD_CUBSO?.Trim();
                _model.COD_TIPO_VALOR_CALCULO       = subFamiliaPadre.COD_TIPO_VALOR_CALCULO?.Trim();
                _model.COD_UNIDAD_MEDIDA             = subFamiliaPadre.COD_UNIDAD_MEDIDA?.Trim();
                _model.COD_UNIDAD_MEDIDA_SECUNDARIA = subFamiliaPadre.COD_UNIDAD_MEDIDA_SECUNDARIA?.Trim();
                HeredarEstadoDeTipoProducto();
            }
        }

        if (!_esNuevo && !string.IsNullOrEmpty(_model.COD_PRODUCTO))
            await CargarEspecificacionesTecnicas();
    }

    // Al crear un Producto nuevo, hereda el Estado Inicial configurado en el Tipo de
    // Producto (COD_ESTADO_INICIAL) — solo si ese estado existe en la lista de Estados de
    // Productos, para no dejar un valor que no aparezca en el combo. El usuario sigue
    // pudiendo cambiarlo después, es solo el valor sugerido.
    private void HeredarEstadoDeTipoProducto()
    {
        if (!_esNuevo || string.IsNullOrEmpty(_model.COD_TIPO_PRODUCTO)) return;
        var tipoProducto = _tiposProductoCompletos.FirstOrDefault(t => t.COD_TIPO_PRODUCTO.Trim() == _model.COD_TIPO_PRODUCTO);
        if (tipoProducto?.COD_ESTADO_INICIAL is null) return;
        var estadoInicial = _estados.FirstOrDefault(e => e.CodEstado == tipoProducto.COD_ESTADO_INICIAL.Value);
        if (estadoInicial is not null)
        {
            _model.COD_ESTADO      = estadoInicial.CodEstado;
            _model.COD_TIPO_ESTADO = _codTipoEstado;
        }
    }
    private async Task<List<ComboboxItem>> SafeGetCombobox(string url) =>
        (await Http.SafeGetAsync<List<ComboboxItem>>(url)) ?? new();

