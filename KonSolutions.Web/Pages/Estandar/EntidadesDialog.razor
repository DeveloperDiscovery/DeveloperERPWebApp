        public bool Guardando { get; set; }
        public string? CodUsuarioRegistro { get; set; }
        public string? CodEstacionRegistro { get; set; }
        public DateTime? FecRegistro { get; set; }
        public string? CodUsuarioActualizacion { get; set; }
        public string? CodEstacionActualizacion { get; set; }
        public DateTime? FecActualizacion { get; set; }
    }
    private List<DocumentoIdentidadRow> _documentos = new();

    private async Task CargarDocumentosAsync()
    {
        if (_model.COD_ENTIDAD is null) return;
        var lista = await Http.SafeGetAsync<List<KONSolutions.Shared.Models.Estandar.EntidadesDocumentosIdentidad>>(
            $"{ApiRoutes.Estandar.EntidadesDocumentosIdentidad}?codEntidad={_model.COD_ENTIDAD}") ?? new();
        _documentos = lista.Select(m => new DocumentoIdentidadRow
        {
            CodTipo = m.COD_TIPO_DOCUMENTO_IDENTIDAD,
            NumDocumento = m.NUM_DOCUMENTO_IDENTIDAD,
            FecCaducidad = m.FEC_CADUCIDAD,
            EsNueva = false,
            CodUsuarioRegistro = m.COD_USUARIO_REGISTRO,
            CodEstacionRegistro = m.COD_ESTACION_REGISTRO,
            FecRegistro = m.FEC_REGISTRO,
            CodUsuarioActualizacion = m.COD_USUARIO_ACTUALIZACION,
            CodEstacionActualizacion = m.COD_ESTACION_ACTUALIZACION,
            FecActualizacion = m.FEC_ACTUALIZACION
        }).ToList();
    }

    private void AgregarDocumento() => _documentos.Add(new DocumentoIdentidadRow { EsNueva = true });

    private async Task GuardarDocumentoAsync(DocumentoIdentidadRow row)
    {
        row.Guardando = true;
        try
        {
            var dto = new
            {
                COD_ENTIDAD = _model.COD_ENTIDAD,
                COD_TIPO_DOCUMENTO_IDENTIDAD = row.CodTipo,
                NUM_DOCUMENTO_IDENTIDAD = row.NumDocumento,
                FEC_CADUCIDAD = row.FecCaducidad
            };
            // PROC_ESTANDAR_ENTIDADES_DOCUMENTOS_IDENTIDAD_INSERT es upsert — siempre POST.
            var resp = await Http.PostAsJsonAsync(ApiRoutes.Estandar.EntidadesDocumentosIdentidad, dto);
            if (resp.IsSuccessStatusCode) { row.EsNueva = false; Snackbar.Add("Guardado.", Severity.Success); }
            else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(EntidadesDialog), nameof(GuardarDocumentoAsync));
        }
        finally { row.Guardando = false; }
    }

    private async Task EliminarDocumentoAsync(DocumentoIdentidadRow row)
    {
        if (row.EsNueva) { _documentos.Remove(row); return; }
        row.Guardando = true;
        try
        {
            var resp = await Http.DeleteAsync($"{ApiRoutes.Estandar.EntidadesDocumentosIdentidad}/{_model.COD_ENTIDAD}/{row.CodTipo}");
            if (resp.IsSuccessStatusCode) { _documentos.Remove(row); Snackbar.Add("Eliminado.", Severity.Success); }
            else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(EntidadesDialog), nameof(EliminarDocumentoAsync), "No se pudo eliminar el registro");
        }
        finally { row.Guardando = false; }
    }

