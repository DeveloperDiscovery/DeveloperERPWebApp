    [Parameter] public string? CodAplicacion { get; set; }
    [Parameter] public string? CodOpcionAplicacion { get; set; }

    // FLG_DOMICILIADO por defecto true en Crear — MapearDesdeModelo reemplaza el objeto
    // completo en Editar/Ver, así que este default no pisa el valor real guardado.
    private Entidad _model = new() { FLG_DOMICILIADO = true };
    private bool _saving;
    private bool _readonly => Modo == CrudModo.Read || Modo == CrudModo.Delete;

    private List<ComboboxItem> _tiposDoc = new();
    private bool _esNuevo;
    private int _tabActiva;

