@using KONSolutions.Shared.Models.Estandar
@using ConfiguracionGeneralModel = KONSolutions.Shared.Models.Estandar.ConfiguracionGeneral
@using KONSolutions.Web.Pages.Comercial
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IDialogService DialogService
@inject ConfiguracionGeneralService CfgSvc

<MudDialog Style="width:min(1328px,95vw);">
    <TitleContent>
        <CrudDialogTitle Modo="Modo" Descripcion="@Item?.DES_NOMBRE_COMPLETO" />
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />

            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-0 pt-3" @bind-ActivePanelIndex="_tabActiva">
            <MudTabPanel Text="Información Básica">
            <div style="display:flex;gap:16px;align-items:flex-start;width:100%;">
            <div style="flex:1 1 auto;min-width:0;">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <AriaCombo TItem="ComboboxItem" Items="_tiposPersona"
                               TextFunc="@(t => t.Texto)" ValueFunc="@(t => t.Id)"
                               Value="@(_model.COD_TIPO_PERSONA?.ToString())"
                               ValueChanged="@(v => { _model.COD_TIPO_PERSONA = int.TryParse(v, out var n) ? n : null; ActualizarNombreCompleto(); LimpiarPrefijoSiNoAplica(); LimpiarDependenciaSiNoAplica(); })"
                               Label="Tipo de Persona" Disabled="_readonly" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="6">
                    @* Solo aplica a Persona Jurídica (2) — deshabilitado en Natural (1). *@
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="NUM_DUNS"
                                @bind-Value="_model.NUM_DUNS"
                                Obligatorio="false" Disabled="@(_readonly || _model.COD_TIPO_PERSONA != 2)" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <AriaCombo TItem="ComboboxItem" Items="_tiposDoc"
                               TextFunc="@(td => td.Texto)" ValueFunc="@(td => td.Id)"
                               Value="@(_model.COD_TIPO_DOCUMENTO_IDENTIDAD?.ToString())"
                               ValueChanged="@(v => _model.COD_TIPO_DOCUMENTO_IDENTIDAD = int.TryParse(v, out var n) ? n : null)"
                               Label="Tipo doc. identidad" Obligatorio="true" Disabled="_readonly" Class="mt-1 mb-3" />
                </MudItem>
                <MudItem xs="12" md="8">
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="NUM_DOCUMENTO_IDENTIDAD"
                                @bind-Value="_model.NUM_DOCUMENTO_IDENTIDAD"
                                Obligatorio="true" Disabled="_readonly" Class="mt-1 mb-3" />
                </MudItem>
                @* Solo aplican a Persona Natural (COD_TIPO_PERSONA = 1) — deshabilitados en Jurídica. *@
                <MudItem xs="6" md="3">
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="DES_PATERNO"
                                Value="@_model.DES_PATERNO"
                                ValueChanged="@(v => { _model.DES_PATERNO = v ?? ""; ActualizarNombreCompleto(); })"
                                Disabled="@(_readonly || _model.COD_TIPO_PERSONA == 2)" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="DES_MATERNO"
                                Value="@_model.DES_MATERNO"
                                ValueChanged="@(v => { _model.DES_MATERNO = v ?? ""; ActualizarNombreCompleto(); })"
                                Disabled="@(_readonly || _model.COD_TIPO_PERSONA == 2)" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="DES_NOMBRE"
                                Value="@_model.DES_NOMBRE"
                                ValueChanged="@(v => { _model.DES_NOMBRE = v ?? ""; ActualizarNombreCompleto(); })"
                                Disabled="@(_readonly || _model.COD_TIPO_PERSONA == 2)" />
                </MudItem>
                <MudItem xs="6" md="3">
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="DES_NOMBRE2"
                                Value="@_model.DES_NOMBRE2"
                                ValueChanged="@(v => { _model.DES_NOMBRE2 = v ?? ""; ActualizarNombreCompleto(); })"
                                Disabled="@(_readonly || _model.COD_TIPO_PERSONA == 2)" />
                </MudItem>
                @* Persona Natural (1): calculado y deshabilitado. Persona Jurídica (2): editable y obligatorio. *@
                <MudItem xs="12" md="6">
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="DES_NOMBRE_COMPLETO"
                                @bind-Value="_model.DES_NOMBRE_COMPLETO"
                                Disabled="@(_readonly || _model.COD_TIPO_PERSONA == 1)" Obligatorio="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    @* Habilitado para los dos tipos de persona. Antes se bloqueaba en Jurídica (2),
                       que es justamente donde el nombre comercial más se usa: no había forma de
                       cargarlo desde la pantalla. A diferencia del prefijo y de la dependencia,
                       este campo no se limpia al cambiar de tipo — aplica a los dos. *@
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="DES_COMERCIAL"
                                @bind-Value="_model.DES_COMERCIAL"
                                Disabled="@_readonly" />
                </MudItem>
                @* Solo aplica a Persona Jurídica (2) — deshabilitado y limpiado en Natural (1),
                   ver LimpiarPrefijoSiNoAplica. *@
                <MudItem xs="12" md="6">
                    <CampoTexto Tabla="ESTANDAR.ENTIDADES" Columna="DES_PREFIJO_USUARIO_COMERCIAL"
                                Label="Prefijo usuario comercial"
                                @bind-Value="_model.DES_PREFIJO_USUARIO_COMERCIAL"
                                Disabled="@(_readonly || _model.COD_TIPO_PERSONA != 2)" />
                </MudItem>
                @* Solo aplica a Persona Natural (1) — deshabilitado y limpiado en Jurídica (2),
                   ver LimpiarDependenciaSiNoAplica. Lista precargada desde
                   PROC_ESTANDAR_ENTIDADES_PARADEPENDER (ya viene filtrada a Persona Jurídica
                   por el propio SP, con nombre y prefijo, sin la ambigüedad de columnas que
                   tiene SHOWALL/SHOWBYID — ver Domain/Models/Estandar/Entidades.cs del lado API). *@
                <MudItem xs="12" md="6">
                    <AriaCombo TItem="ComboboxItem" Items="_entidadesParaDepender"
                               TextFunc="@(x => $"{x.Id} - {x.Texto}")" ValueFunc="@(x => x.Id)"
                               Value="@(_model.COD_ENTIDAD_DEPENDENCIA?.ToString())"
                               ValueChanged="@(v => _model.COD_ENTIDAD_DEPENDENCIA = decimal.TryParse(v, out var n) ? n : null)"
                               Label="Entidad dependencia"
                               Disabled="@(_readonly || _model.COD_TIPO_PERSONA != 1)" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <div class="d-flex align-center gap-1 mt-2"><MudIcon Icon="@Icons.Material.Filled.Home" Color="Color.Primary" Size="Size.Medium" />
                        <MudSwitch T="bool?" Value="_model.FLG_DOMICILIADO" ValueChanged="@(v => OnDomiciliadoChanged(v))"
                                   Label="Domiciliado" Disabled="_readonly" Color="Color.Primary" /></div>
                </MudItem>
                <MudItem xs="12" md="8">
                    @* Si es Domiciliado, País se precarga desde Configuración General, pero queda editable.
                       ItemSelected actualiza DES_PAIS (no solo COD_PAIS): TextoInicial está atado a
                       DES_PAIS, y si no se refresca, el combo remoto revierte el texto mostrado al
                       valor viejo apenas se re-renderiza tras elegir un país nuevo. *@
                    <AriaCombo TItem="ComboboxItem" Items="Enumerable.Empty<ComboboxItem>()"
                               TextFunc="@(x => $"{x.Id} – {x.Texto}")" ValueFunc="@(x => x.Id)"
                               Value="@_model.COD_PAIS" ValueChanged="@(v => _model.COD_PAIS = v ?? "")"
                               ItemSelected="@(item => _model.DES_PAIS = item?.Texto ?? "")"
                               SearchFunc="BuscarPaisAsync" MinCharacters="2"
                               TextoInicial="@(_model.DES_PAIS)"
                               Label="País" Disabled="_readonly" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <AriaCombo TItem="ComboboxItem" Items="Enumerable.Empty<ComboboxItem>()"
                               TextFunc="@(x => $"{x.Id} – {x.Texto}")" ValueFunc="@(x => x.Id)"
                               Value="@_model.COD_USUARIO_RELACIONADO" ValueChanged="@(v => _model.COD_USUARIO_RELACIONADO = v ?? "")"
                               SearchFunc="BuscarUsuarioEntidadAsync" MinCharacters="2"
                               TextoInicial="@(_model.COD_USUARIO_RELACIONADO)"
                               Label="Usuario relacionado" Disabled="_readonly" Class="mb-3" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <EstadoCombo DesTabla="ESTANDAR.ENTIDADES"
                                 @bind-Value="_model.COD_ESTADO"
                                 CodTipoEstadoChanged="@(v => _model.COD_TIPO_ESTADO = v)"
                                 Disabled="_readonly" Class="mb-3" />
                </MudItem>
            </MudGrid>
            </div>
            <div style="flex-shrink:0;padding-left:8px;border-left:1px solid rgba(0,0,0,.1);width:290px;">
                <ImagePicker Label="Logo" Image="_model.IMG_LOGO"
                             ImageChanged="@(v => _model.IMG_LOGO = v)"
                             ReadOnly="_readonly" />

                @* Tipos de Entidad: check = INSERT inmediato en ENTIDADES_TIPOS_ENTIDADES,
                   uncheck = DELETE inmediato — no espera al Guardar del formulario principal. *@
                <MudText Typo="Typo.caption" Class="mono mt-3 mb-1"
                          Style="opacity:.6;font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">Tipos de Entidad:</MudText>
                @if (_esNuevo)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Style="font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">Guarda la entidad primero para asignar tipos.</MudAlert>
                }
                else
                {
                    <div style="border:1px solid var(--line);border-radius:4px;padding:6px 8px;max-height:225px;overflow-y:auto;">
                        @foreach (var t in _tiposEntidadTodos)
                        {
                            <div class="d-flex align-center">
                                <MudSwitch T="bool"
                                           Value="@(BloquearTipoEntidad ? t.Id == CodTipoEntidadFijo : _tiposEntidadAsignados.Contains(t.Id))"
                                           ValueChanged="@(v => ToggleTipoEntidad(t.Id, v))"
                                           Disabled="@(_readonly || _tipoEntidadGuardando == t.Id || BloquearTipoEntidad)"
                                           Dense="true" Color="Color.Primary" />
                                <MudText Typo="Typo.body2" Style="font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">@t.Texto</MudText>
                            </div>
                        }
                    </div>
                }
            </div>
            </div>
            </MudTabPanel>

            <MudTabPanel Text="Documentos de Identidad">
            <div style="min-height:40vh;">
            @if (_esNuevo)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Style="font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">Guarda la entidad primero para asignar sus Documentos de Identidad.</MudAlert>
            }
            else
            {
                <div class="d-flex align-center justify-space-between mb-2">
                    <MudText Typo="Typo.caption" Class="mono" Style="opacity:.6;font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">@_documentos.Count documento(s)</MudText>
                    @if (!_readonly)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Size="Size.Small"
                                   Style="@EstiloBotonConfirmar" OnClick="AgregarDocumento">Agregar documento</MudButton>
                    }
                </div>
                @* Tabla HTML simple (sin el wrapper "overflow-x:auto" de MudSimpleTable) —
                   ese wrapper recorta también el overflow vertical (regla CSS: un eje
                   overflow:auto fuerza el otro a auto), lo que ocultaba el desplegable
                   de AriaCombo (position:absolute) apenas se abría dentro de una fila. *@
                <table class="tabla-simple-editable" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:280px;">Tipo de documento</th>
                            <th>Número de documento</th>
                            <th style="width:190px;">Fecha de caducidad</th>
                            <th style="width:130px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _documentos)
                        {
                            <tr>
                                <td>
                                    <AriaCombo TItem="ComboboxItem" Items="_tiposDoc"
                                               TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                               Value="@(row.CodTipo?.ToString())"
                                               ValueChanged="@(v => row.CodTipo = int.TryParse(v, out var n) ? n : null)"
                                               Disabled="@(!row.EsNueva || _readonly)" Class="mb-0" Style="margin-top:0;" />
                                </td>
                                <td>
                                    <div class="grilla-campo-texto">
                                        <CampoTexto Tabla="ESTANDAR.ENTIDADES_DOCUMENTOS_IDENTIDAD" Columna="NUM_DOCUMENTO_IDENTIDAD"
                                                    @bind-Value="row.NumDocumento" Disabled="_readonly" MostrarLabel="false"
                                                    Margin="Margin.None" Class="mb-0" />
                                    </div>
                                </td>
                                <td>
                                    <MudDatePicker @bind-Date="row.FecCaducidad" Variant="Variant.Outlined" Disabled="_readonly"
                                                   Margin="Margin.None" Class="mb-0" />
                                </td>
                                <td>
                                    @if (!_readonly)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                                       Disabled="@(row.Guardando || row.CodTipo is null || string.IsNullOrWhiteSpace(row.NumDocumento))"
                                                       OnClick="@(() => GuardarDocumentoAsync(row))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       Disabled="row.Guardando" OnClick="@(() => EliminarDocumentoAsync(row))" />
                                    }
                                    @if (!row.EsNueva)
                                    {
                                        <PanelAuditoria CodUsuarioRegistro="@row.CodUsuarioRegistro"
                                                        CodEstacionRegistro="@row.CodEstacionRegistro"
                                                        FecRegistro="@row.FecRegistro"
                                                        CodUsuarioActualizacion="@row.CodUsuarioActualizacion"
                                                        CodEstacionActualizacion="@row.CodEstacionActualizacion"
                                                        FecActualizacion="@row.FecActualizacion" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            </div>
            </MudTabPanel>

            <MudTabPanel Text="Medios de Contacto">
            <div style="min-height:40vh;">
            @if (_esNuevo)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Style="font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">Guarda la entidad primero para asignar sus Medios de Contacto.</MudAlert>
            }
            else
            {
                <div class="d-flex align-center justify-space-between mb-2">
                    <MudText Typo="Typo.caption" Class="mono" Style="opacity:.6;font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">@_mediosContacto.Count medio(s) de contacto</MudText>
                    @if (!_readonly)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Size="Size.Small"
                                   Style="@EstiloBotonConfirmar" OnClick="AgregarMedioContacto">Agregar medio de contacto</MudButton>
                    }
                </div>
                <table class="tabla-simple-editable" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:240px;">Tipo de medio de contacto</th>
                            <th>Dato (correo, teléfono, url, usuario...)</th>
                            <th style="width:180px;">Tipo de uso</th>
                            <th style="width:130px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _mediosContacto)
                        {
                            <tr>
                                <td>
                                    @* Ya no es clave (la clave es NUM_SECUENCIA), así que se puede editar
                                       aunque la fila no sea nueva — permite varias filas del mismo tipo. *@
                                    <AriaCombo TItem="ComboboxItem" Items="_tiposMedioContacto"
                                               TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                               Value="@(row.CodTipo?.ToString())"
                                               ValueChanged="@(v => row.CodTipo = int.TryParse(v, out var n) ? n : null)"
                                               Disabled="_readonly" Class="mb-0" Style="margin-top:0;" />
                                </td>
                                <td>
                                    <div class="grilla-campo-texto">
                                        <CampoTexto Tabla="COMERCIAL.ENTIDADES_TIPOS_MEDIO_CONTACTO" Columna="DAT_TIPO_MEDIO_CONTACTO"
                                                    @bind-Value="row.Dato" Disabled="_readonly" MostrarLabel="false"
                                                    Margin="Margin.None" Class="mb-0" />
                                    </div>
                                </td>
                                <td>
                                    <AriaCombo TItem="ComboboxItem" Items="_tiposUso"
                                               TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                                               Value="@(row.CodTipoUso)"
                                               ValueChanged="@(v => row.CodTipoUso = v)"
                                               Disabled="_readonly" Class="mb-0" Style="margin-top:0;" />
                                </td>
                                <td>
                                    @if (!_readonly)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Success"
                                                       Disabled="@(row.Guardando || row.CodTipo is null || string.IsNullOrWhiteSpace(row.Dato))"
                                                       OnClick="@(() => GuardarMedioContactoAsync(row))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       Disabled="row.Guardando" OnClick="@(() => EliminarMedioContactoAsync(row))" />
                                    }
                                    @if (!row.EsNueva)
                                    {
                                        <PanelAuditoria CodUsuarioRegistro="@row.CodUsuarioRegistro"
                                                        CodEstacionRegistro="@row.CodEstacionRegistro"
                                                        FecRegistro="@row.FecRegistro"
                                                        CodUsuarioActualizacion="@row.CodUsuarioActualizacion"
                                                        CodEstacionActualizacion="@row.CodEstacionActualizacion"
                                                        FecActualizacion="@row.FecActualizacion" />
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            </div>
            </MudTabPanel>

            @* Direcciones tiene demasiados campos (17, incluyendo el mapa de ubicación)
               para editarse en una fila de grilla como Documentos/Medios de Contacto —
               acá cada fila abre EntidadesDireccionesDialog (diálogo CRUD completo,
               mismo patrón que el resto de la app) en vez de edición in-place. *@
            <MudTabPanel Text="Direcciones">
            <div style="min-height:40vh;">
            @if (_esNuevo)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Style="font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">Guarda la entidad primero para asignar sus Direcciones.</MudAlert>
            }
            else
            {
                <div class="d-flex align-center justify-space-between mb-2">
                    <MudText Typo="Typo.caption" Class="mono" Style="opacity:.6;font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">@_direcciones.Count dirección(es)</MudText>
                    @if (!_readonly)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Size="Size.Small"
                                   Style="@EstiloBotonConfirmar" OnClick="AgregarDireccion">Agregar dirección</MudButton>
                    }
                </div>
                <table class="tabla-simple-editable" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:170px;">Tipo</th>
                            <th>Dirección</th>
                            <th style="width:170px;">Ubigeo</th>
                            <th style="width:130px;">Coordenadas</th>
                            <th style="width:130px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _direcciones)
                        {
                            <tr>
                                <td>@d.DES_TIPO_DIRECCION</td>
                                <td>@d.DES_DIRECCION</td>
                                <td>@d.DES_UBIGEO</td>
                                <td>
                                    @if (d.VAL_LATITUD is not null && d.VAL_LONGITUD is not null)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Success" Size="Size.Small" Title="Tiene coordenadas guardadas" />
                                    }
                                </td>
                                <td>
                                    @if (!_readonly)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditarDireccion(d))" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => EliminarDireccionAsync(d))" />
                                    }
                                    <PanelAuditoria CodUsuarioRegistro="@d.COD_USUARIO_REGISTRO"
                                                    CodEstacionRegistro="@d.COD_ESTACION_REGISTRO"
                                                    FecRegistro="@d.FEC_REGISTRO"
                                                    CodUsuarioActualizacion="@d.COD_USUARIO_ACTUALIZACION"
                                                    CodEstacionActualizacion="@d.COD_ESTACION_ACTUALIZACION"
                                                    FecActualizacion="@d.FEC_ACTUALIZACION" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            </div>
            </MudTabPanel>

            @* Solo aplica al Catálogo de Clientes (COD_TIPO_ENTIDAD = 'CLI', ver
               CodTipoEntidadFijo/BloquearTipoEntidad) — no tiene sentido en la grilla
               genérica de Entidades ni para otros tipos (Proveedores, Personal, etc.). *@
            @if (BloquearTipoEntidad && CodTipoEntidadFijo == "CLI")
            {
                <MudTabPanel Text="Asesores Comerciales">
                <div style="min-height:40vh;">
                @if (_esNuevo)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Style="font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">Guarda el cliente primero para asignar sus Asesores Comerciales.</MudAlert>
                }
                else
                {
                    <div class="d-flex align-center justify-space-between mb-2">
                        <MudText Typo="Typo.caption" Class="mono" Style="opacity:.6;font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);">@_asesoresComerciales.Count asesor(es) asignado(s)</MudText>
                        @if (!_readonly)
                        {
                            <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Size="Size.Small"
                                       Style="@EstiloBotonConfirmar" OnClick="AgregarAsesorComercial">Agregar asesor comercial</MudButton>
                        }
                    </div>
                    <table class="tabla-simple-editable" style="width:100%;">
                        <thead>
                            <tr>
                                <th>Asesor comercial</th>
                                <th style="width:130px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in _asesoresComerciales)
                            {
                                <tr>
                                    <td>@(a.DES_NOMBRE_COMPLETO ?? a.COD_ENTIDAD_ASESOR_COMERCIAL?.ToString())</td>
                                    <td>
                                        @if (!_readonly)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => EliminarAsesorComercialAsync(a))" />
                                        }
                                        <PanelAuditoria CodUsuarioRegistro="@a.COD_USUARIO_REGISTRO"
                                                        CodEstacionRegistro="@a.COD_ESTACION_REGISTRO"
                                                        FecRegistro="@a.FEC_REGISTRO" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                </div>
                </MudTabPanel>
            }
            </MudTabs>

            <CrudDialogActions Modo="Modo" Saving="_saving"
                               OnCancel="@(() => MudDialog.Cancel())">
                <LeftContent>
                    <PanelAuditoria CodUsuarioRegistro="@Item?.COD_USUARIO_REGISTRO"
                                    CodEstacionRegistro="@Item?.COD_ESTACION_REGISTRO"
                                    FecRegistro="@Item?.FEC_REGISTRO"
                                    CodUsuarioActualizacion="@Item?.COD_USUARIO_ACTUALIZACION"
                                    CodEstacionActualizacion="@Item?.COD_ESTACION_ACTUALIZACION"
                                    FecActualizacion="@Item?.FEC_ACTUALIZACION" />
                </LeftContent>
            </CrudDialogActions>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
