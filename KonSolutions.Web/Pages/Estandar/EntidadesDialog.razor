    // BloquearTipoEntidad es true, el panel "Tipos de Entidad" queda con ese tipo marcado
    // y TODO el panel deshabilitado (no se puede desmarcar ni marcar otro).
    [Parameter] public string? CodTipoEntidadFijo { get; set; }
    [Parameter] public bool BloquearTipoEntidad { get; set; }
