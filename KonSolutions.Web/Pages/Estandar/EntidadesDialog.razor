    private class EntidadTipoEntidadShowselectRow
    {
        public bool FLG_SELECT { get; set; }
        public decimal? COD_ENTIDAD { get; set; }
        public string COD_TIPO_ENTIDAD { get; set; } = "";
        public string DES_TIPO_ENTIDAD { get; set; } = "";
    }

    /// <summary>PROC_ESTANDAR_ENTIDADES_TIPOS_ENTIDADES_SHOWWSELECT trae en un solo llamado
    /// TODOS los tipos de entidad con FLG_SELECT indicando si ya están asignados a esta
    /// entidad — se ordenan asignados primero.</summary>
    private async Task CargarTiposEntidadAsync()
    {
        if (_model.COD_ENTIDAD is null) return;
        var filas = await Http.SafeGetAsync<List<EntidadTipoEntidadShowselectRow>>(
            $"{ApiRoutes.Estandar.EntidadesTiposEntidadesShowselect}/{_model.COD_ENTIDAD}") ?? new();
        _tiposEntidadTodos = filas
            .OrderByDescending(f => f.FLG_SELECT)
            .ThenBy(f => f.DES_TIPO_ENTIDAD)
            .Select(f => new ComboboxItem { Id = f.COD_TIPO_ENTIDAD, Texto = f.DES_TIPO_ENTIDAD })
            .ToList();
        _tiposEntidadAsignados = filas.Where(f => f.FLG_SELECT).Select(f => f.COD_TIPO_ENTIDAD).ToHashSet();
    }

    private async Task ToggleTipoEntidad(string codTipoEntidad, bool marcado)
    {
        if (_model.COD_ENTIDAD is null) return;
        _tipoEntidadGuardando = codTipoEntidad;
        try
        {
            if (marcado)
            {
                var dto = new { COD_ENTIDAD = _model.COD_ENTIDAD, COD_TIPO_ENTIDAD = codTipoEntidad };
                var resp = await Http.PostAsJsonAsync(ApiRoutes.Estandar.EntidadesTiposEntidades, dto);
                if (resp.IsSuccessStatusCode) _tiposEntidadAsignados.Add(codTipoEntidad);
                else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(EntidadesDialog), nameof(ToggleTipoEntidad));
            }
            else
            {
                var resp = await Http.DeleteAsync($"{ApiRoutes.Estandar.EntidadesTiposEntidades}/{_model.COD_ENTIDAD}/{Uri.EscapeDataString(codTipoEntidad)}");
                if (resp.IsSuccessStatusCode) _tiposEntidadAsignados.Remove(codTipoEntidad);
                else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(EntidadesDialog), nameof(ToggleTipoEntidad));
            }
        }
        finally { _tipoEntidadGuardando = null; }
    }

    /// <summary>Al marcar/desmarcar Domiciliado, hereda (o limpia) el País desde
    /// Configuración General — pedido explícito: "País se hereda de la Configuración
    /// General si es Domiciliado".</summary>
    private void OnDomiciliadoChanged(bool? v)
    {
        _model.FLG_DOMICILIADO = v;
        if (v == true)
        {
            _model.COD_PAIS = _cfg?.COD_PAIS ?? "";
            _model.DES_PAIS = _cfg?.DES_PAIS ?? "";
        }
    }

    // COD_TIPO_PERSONA: valor fijo de 2 opciones (tinyint), no viene de una tabla catálogo.
    private readonly List<ComboboxItem> _tiposPersona = new()
    {
        new() { Id = "1", Texto = "Persona Natural" },
        new() { Id = "2", Texto = "Persona Jurídica" },
    };

    /// <summary>Solo aplica para Persona Natural: DES_NOMBRE_COMPLETO se calcula y queda
    /// deshabilitado. Para Persona Jurídica el usuario lo escribe directamente.</summary>
    private void ActualizarNombreCompleto()
    {
        if (_model.COD_TIPO_PERSONA == 1)
            _model.DES_NOMBRE_COMPLETO = $"{_model.DES_PATERNO} {_model.DES_MATERNO} {_model.DES_NOMBRE} {_model.DES_NOMBRE2}".Trim();
    }

    /// <summary>DES_PREFIJO_USUARIO_COMERCIAL solo aplica a Persona Jurídica: al cambiar a
    /// Natural se limpia para no dejar un valor guardado que ya no corresponde mostrar.</summary>
    private void LimpiarPrefijoSiNoAplica()
    {
        if (_model.COD_TIPO_PERSONA != 2)
            _model.DES_PREFIJO_USUARIO_COMERCIAL = null;
    }

    /// <summary>COD_ENTIDAD_DEPENDENCIA solo aplica a Persona Natural: al cambiar a
    /// Jurídica se limpia para no dejar un valor guardado que ya no corresponde mostrar.</summary>
    private void LimpiarDependenciaSiNoAplica()
    {
        if (_model.COD_TIPO_PERSONA != 1)
            _model.COD_ENTIDAD_DEPENDENCIA = null;
    }

    private List<ComboboxItem> _entidadesParaDepender = new();

    /// <summary>Carga PROC_ESTANDAR_ENTIDADES_PARADEPENDER (ya filtrado a Persona Jurídica
    /// por el propio SP) y descarta la propia entidad — no puede depender de sí misma.</summary>
    private async Task CargarEntidadesParaDependerAsync()
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<ComboboxItem>>>(
                ApiRoutes.Estandar.EntidadesParaDepender);
            _entidadesParaDepender = (r?.Data ?? new())
                .Where(x => x.Id != _model.COD_ENTIDAD?.ToString())
                .ToList();
        }
        catch { _entidadesParaDepender = new(); }
    }

    protected override void OnInitialized()
    {
        _esNuevo = Modo == CrudModo.Create;
        if (Item is not null) MapearDesdeModelo(Item);
    }

    private void MapearDesdeModelo(Entidad m)
    {
        _model = new Entidad
        {
            COD_ENTIDAD                  = m.COD_ENTIDAD,
            COD_TIPO_PERSONA             = m.COD_TIPO_PERSONA,
            DES_PATERNO                  = m.DES_PATERNO,
            DES_MATERNO                  = m.DES_MATERNO,
            DES_NOMBRE                   = m.DES_NOMBRE,
            DES_NOMBRE2                  = m.DES_NOMBRE2,
            DES_NOMBRE_COMPLETO          = m.DES_NOMBRE_COMPLETO,
            DES_COMERCIAL                = m.DES_COMERCIAL,
            DES_PREFIJO_USUARIO_COMERCIAL = m.DES_PREFIJO_USUARIO_COMERCIAL,
            COD_ENTIDAD_DEPENDENCIA      = m.COD_ENTIDAD_DEPENDENCIA,
            COD_TIPO_DOCUMENTO_IDENTIDAD = m.COD_TIPO_DOCUMENTO_IDENTIDAD,
            NUM_DOCUMENTO_IDENTIDAD      = m.NUM_DOCUMENTO_IDENTIDAD,
            FLG_DOMICILIADO              = m.FLG_DOMICILIADO,
            COD_PAIS                     = m.COD_PAIS,
            DES_PAIS                     = m.DES_PAIS,
            NUM_DUNS                     = m.NUM_DUNS,
            COD_USUARIO_RELACIONADO      = m.COD_USUARIO_RELACIONADO,
            IMG_LOGO                     = m.IMG_LOGO,
            COD_TIPO_ESTADO              = m.COD_TIPO_ESTADO,
            COD_ESTADO                   = m.COD_ESTADO,
        };
    }

    /// <summary>Trae la Entidad fresca desde SHOWBYID — evita mostrar datos desactualizados
    /// de la grilla al Modificar/Eliminar/Ver.</summary>
    private async Task RecargarDesdeShowbyidAsync()
    {
        var fresco = await Http.SafeGetAsync<Entidad>($"{ApiRoutes.Estandar.Entidades}/{Uri.EscapeDataString(_model.COD_ENTIDAD?.ToString() ?? "")}");
        if (fresco is not null) MapearDesdeModelo(fresco);
    }
    protected override async Task OnInitializedAsync()
    {
        if (!_esNuevo && Item is not null) await RecargarDesdeShowbyidAsync();

        var tTiposDoc = Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<ComboboxItem>>>(ApiRoutes.Estandar.TiposDocumentoIdentidadCombobox);
        var tTiposMedioContacto = Http.SafeGetAsync<List<ComboboxItem>>(ApiRoutes.Comercial.TiposMedioContactoCombobox);
        // SHOWCOMBOX de TIPOS_USO no alias sus columnas como Id/Texto (igual que
        // ClasesDesarrollo), así que se trae el DTO propio y se mapea a ComboboxItem acá.
        var tTiposUso = Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<KONSolutions.Shared.Models.Estandar.TiposUso>>>(ApiRoutes.Estandar.TiposUsoCombobox);
        var tCfg = CfgSvc.GetCurrentAsync();
        var tParaDepender = CargarEntidadesParaDependerAsync();
        await Task.WhenAll(tTiposDoc, tTiposMedioContacto, tTiposUso, tCfg, tParaDepender);
        _tiposDoc = (await tTiposDoc)?.Data ?? new();
        _tiposMedioContacto = (await tTiposMedioContacto) ?? new();
        _tiposUso = ((await tTiposUso)?.Data ?? new())
            .Select(t => new ComboboxItem { Id = t.COD_TIPO_USO, Texto = t.DES_TIPO_USO }).ToList();
        _cfg = await tCfg;

        // Alta nueva con Domiciliado por defecto (true): hereda el País de Configuración General.
        if (_esNuevo && _model.FLG_DOMICILIADO == true)
        {
            _model.COD_PAIS = _cfg?.COD_PAIS ?? "";
            _model.DES_PAIS = _cfg?.DES_PAIS ?? "";
        }

        // Tipos de Entidad, Documentos de Identidad y Medios de Contacto (solo aplica en
        // Editar/Ver/Eliminar, cuando ya existe COD_ENTIDAD).
        if (!_esNuevo)
        {
            await CargarTiposEntidadAsync();
            await CargarDocumentosAsync();
            await CargarMediosContactoAsync();
            await CargarDireccionesAsync();
            if (BloquearTipoEntidad && CodTipoEntidadFijo == "CLI") await CargarAsesoresComercialesAsync();
        }
    }

    private async Task<IEnumerable<ComboboxItem>> BuscarPaisAsync(string texto, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(texto) || texto.Length < 2) return [];
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<ComboboxItem>>>(
                $"{ApiRoutes.Estandar.PaisesCombobox}?search={Uri.EscapeDataString(texto)}", ct);
            return r?.Data ?? [];
        }
        catch { return []; }
    }

    private async Task<IEnumerable<ComboboxItem>> BuscarUsuarioEntidadAsync(string texto, CancellationToken ct)
    {
        if (string.IsNullOrWhiteSpace(texto) || texto.Length < 2) return [];
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<ComboboxItem>>>(
                $"{ApiRoutes.Seguridad.UsuariosCombobox}?search={Uri.EscapeDataString(texto)}", ct);
            return r?.Data ?? [];
        }
        catch { return []; }
    }

    private async Task Submit()
    {
        _saving = true;
        if (Modo == CrudModo.Delete)
        {
            var rd = await Http.DeleteAsync($"{ApiRoutes.Estandar.Entidades}/{_model.COD_ENTIDAD}");
            _saving = false;
            if (rd.IsSuccessStatusCode) { Snackbar.Add("Eliminado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
            else await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(EntidadesDialog), nameof(Submit), "No se pudo eliminar el registro");
            return;
        }
        var esNuevo = Modo == CrudModo.Create;
        var dto = new
        {
            _model.COD_ENTIDAD, _model.COD_TIPO_PERSONA,
            _model.DES_PATERNO, _model.DES_MATERNO, _model.DES_NOMBRE, _model.DES_NOMBRE2,
            _model.DES_NOMBRE_COMPLETO, _model.DES_COMERCIAL,
            DES_PREFIJO_USUARIO_COMERCIAL = NullSiVacio(_model.DES_PREFIJO_USUARIO_COMERCIAL),
            _model.COD_ENTIDAD_DEPENDENCIA,
            _model.COD_TIPO_DOCUMENTO_IDENTIDAD, _model.NUM_DOCUMENTO_IDENTIDAD,
            _model.FLG_DOMICILIADO,
            COD_PAIS = NullSiVacio(_model.COD_PAIS),
            NUM_DUNS = NullSiVacio(_model.NUM_DUNS),
            COD_USUARIO_RELACIONADO = NullSiVacio(_model.COD_USUARIO_RELACIONADO),
            _model.COD_TIPO_ESTADO, _model.COD_ESTADO, _model.IMG_LOGO,
            // Solo en Create: el SP INSERT (upsert) asigna atómicamente este tipo si viene
            // seteado. En Update no hace falta reenviarlo — ya quedó asignado la primera vez.
            COD_TIPO_ENTIDAD = (esNuevo && BloquearTipoEntidad) ? CodTipoEntidadFijo : null
        };
        // PROC_ESTANDAR_ENTIDADES_INSERT es upsert — el Controller nunca tuvo endpoint PUT,
        // siempre se llama al mismo POST.
        var resp = await Http.PostAsJsonAsync(ApiRoutes.Estandar.Entidades, dto);
        _saving = false;
        if (resp.IsSuccessStatusCode) { Snackbar.Add(esNuevo ? "Creado." : "Modificado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(EntidadesDialog), nameof(Submit));
    }

    static string? NullSiVacio(string? v) => string.IsNullOrWhiteSpace(v) ? null : v;
}
