        _mediosContacto = lista.Select(m => new MedioContactoRow
        {
            NumSecuencia = m.NUM_SECUENCIA,
            CodTipo = m.COD_TIPO_MEDIO_CONTACTO,
            Dato = m.DAT_TIPO_MEDIO_CONTACTO,
            CodTipoUso = m.COD_TIPO_USO,
            EsNueva = false,
            CodUsuarioRegistro = m.COD_USUARIO_REGISTRO,
            CodEstacionRegistro = m.COD_ESTACION_REGISTRO,
            FecRegistro = m.FEC_REGISTRO,
            CodUsuarioActualizacion = m.COD_USUARIO_ACTUALIZACION,
            CodEstacionActualizacion = m.COD_ESTACION_ACTUALIZACION,
            FecActualizacion = m.FEC_ACTUALIZACION
        }).ToList();
    }

    private void AgregarMedioContacto() => _mediosContacto.Add(new MedioContactoRow { EsNueva = true });

    private async Task GuardarMedioContactoAsync(MedioContactoRow row)
    {
        row.Guardando = true;
        try
        {
            var dto = new
            {
                COD_ENTIDAD = _model.COD_ENTIDAD,
                NUM_SECUENCIA = row.NumSecuencia ?? 0,
                COD_TIPO_MEDIO_CONTACTO = row.CodTipo,
                DAT_TIPO_MEDIO_CONTACTO = row.Dato,
                COD_TIPO_USO = row.CodTipoUso
            };
            // PROC_COMERCIAL_ENTIDADES_TIPOS_MEDIO_CONTACTO_INSERT es upsert — siempre POST.
            // NUM_SECUENCIA se recalcula en el servidor al crear (0/null), así que tras un
            // alta se recarga la grilla completa para obtener el correlativo asignado.
            var resp = await Http.PostAsJsonAsync(ApiRoutes.Comercial.EntidadesTiposMedioContacto, dto);
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("Guardado.", Severity.Success);
                if (row.EsNueva) await CargarMediosContactoAsync(); else row.EsNueva = false;
            }
            else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(EntidadesDialog), nameof(GuardarMedioContactoAsync));
        }
        finally { row.Guardando = false; }
    }

    private async Task EliminarMedioContactoAsync(MedioContactoRow row)
    {
        if (row.EsNueva) { _mediosContacto.Remove(row); return; }
        row.Guardando = true;
        try
        {
            var resp = await Http.DeleteAsync($"{ApiRoutes.Comercial.EntidadesTiposMedioContacto}/{_model.COD_ENTIDAD}/{row.NumSecuencia}");
            if (resp.IsSuccessStatusCode) { _mediosContacto.Remove(row); Snackbar.Add("Eliminado.", Severity.Success); }
            else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(EntidadesDialog), nameof(EliminarMedioContactoAsync), "No se pudo eliminar el registro");
        }
        finally { row.Guardando = false; }
    }

