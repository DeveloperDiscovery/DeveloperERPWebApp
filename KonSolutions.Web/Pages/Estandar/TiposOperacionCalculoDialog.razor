@using CalculoModel = KONSolutions.Shared.Models.Comercial.TiposOperacionCalculo
@using CalculoRoute = KONSolutions.Web.Services.ApiRoutes.Comercial
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <CrudDialogTitle Modo="Modo" Descripcion="@_model.DES_TIPO_VALOR_CALCULO" />
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <MudNumericField @bind-Value="_model.NUM_ORDEN_PRESENTACION" Label="Orden de presentación"
                              Variant="Variant.Outlined" Disabled="_readonly" Class="mb-3" />
            <MudTextField Value="@CodTipoOperacionTexto" Label="Tipo de operación"
                          Variant="Variant.Outlined" Disabled="true" Class="mb-3" />
            <AriaCombo TItem="ComboboxItem" Items="_tiposValorCalculo"
                       TextFunc="@(t => $"{t.Id} - {t.Texto}")" ValueFunc="@(t => t.Id)"
                       @bind-Value="_model.COD_TIPO_VALOR_CALCULO"
                       Label="Tipo de valor de cálculo" Disabled="@(!_esNuevo || _readonly)" />
            <CampoTexto Tabla="COMERCIAL.TIPOS_OPERACION_CALCULO" Columna="COD_CUENTA_NATURALEZA"
                        @bind-Value="_model.COD_CUENTA_NATURALEZA"
                        Disabled="_readonly" />
            <CampoTexto Tabla="COMERCIAL.TIPOS_OPERACION_CALCULO" Columna="COD_CUENTA_CONTABLE"
                        @bind-Value="_model.COD_CUENTA_CONTABLE"
                        Disabled="_readonly" />

            <MudText Typo="Typo.caption" Class="mono mb-2" Style="opacity:.55;display:block;">CARACTERÍSTICAS</MudText>
            <div class="d-flex flex-wrap gap-4 mb-3">
                <div class="d-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Primary" Size="Size.Small" /><MudSwitch T="bool?" @bind-Value="_model.FLG_CALCULO_INVERSO" Color="Color.Primary" Disabled="_readonly" Label="Cálculo inverso" /></div>
                <div class="d-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Color="Color.Primary" Size="Size.Small" /><MudSwitch T="bool?" @bind-Value="_model.FLG_MOSTRAR_COMPROBANTE" Color="Color.Primary" Disabled="_readonly" Label="Mostrar en comprobante" /></div>
                <div class="d-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Size="Size.Small" /><MudSwitch T="bool?" @bind-Value="_model.FLG_VALOR_MOSTRAR" Color="Color.Primary" Disabled="_readonly" Label="Mostrar valor" /></div>
                <div class="d-flex align-center gap-1"><MudIcon Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Size="Size.Small" /><MudSwitch T="bool?" @bind-Value="_model.FLG_POSITIVO" Color="Color.Primary" Disabled="_readonly" Label="Positivo" /></div>
            </div>

            <CrudDialogActions Modo="Modo" Saving="_saving"
                               OnCancel="@(() => MudDialog.Cancel())">
                <LeftContent>
                    <PanelAuditoria CodUsuarioRegistro="@Item?.COD_USUARIO_REGISTRO"
                                    CodEstacionRegistro="@Item?.COD_ESTACION_REGISTRO"
                                    FecRegistro="@Item?.FEC_REGISTRO" />
                </LeftContent>
            </CrudDialogActions>
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public CalculoModel? Item { get; set; }
    [Parameter] public CrudModo Modo { get; set; } = CrudModo.Create;
    [Parameter] public string CodClaseOperacion { get; set; } = "";
    [Parameter] public string CodTipoOperacion { get; set; } = "";
    [Parameter] public string DesTipoOperacion { get; set; } = "";

    private CalculoModel _model = new();
    private bool _esNuevo, _saving;
    private bool _readonly => Modo == CrudModo.Read || Modo == CrudModo.Delete;
    private string CodTipoOperacionTexto => string.IsNullOrEmpty(DesTipoOperacion)
        ? CodTipoOperacion
        : $"{CodTipoOperacion} - {DesTipoOperacion}";

    private List<ComboboxItem> _tiposValorCalculo = new();

    protected override void OnInitialized()
    {
        _esNuevo = Modo == CrudModo.Create;
        if (Item is not null) MapearDesdeModelo(Item);
        else
        {
            _model.COD_CLASE_OPERACION = CodClaseOperacion;
            _model.COD_TIPO_OPERACION  = CodTipoOperacion;
        }
    }

    private void MapearDesdeModelo(CalculoModel m) =>
        _model = new CalculoModel
        {
            COD_CLASE_OPERACION     = m.COD_CLASE_OPERACION,
            COD_TIPO_OPERACION      = m.COD_TIPO_OPERACION,
            COD_TIPO_VALOR_CALCULO  = m.COD_TIPO_VALOR_CALCULO,
            NUM_ORDEN_PRESENTACION  = m.NUM_ORDEN_PRESENTACION,
            FLG_CALCULO_INVERSO     = m.FLG_CALCULO_INVERSO,
            FLG_MOSTRAR_COMPROBANTE = m.FLG_MOSTRAR_COMPROBANTE,
            FLG_VALOR_MOSTRAR       = m.FLG_VALOR_MOSTRAR,
            FLG_POSITIVO            = m.FLG_POSITIVO,
            COD_CUENTA_NATURALEZA   = m.COD_CUENTA_NATURALEZA,
            COD_CUENTA_CONTABLE     = m.COD_CUENTA_CONTABLE,
        };

    private async Task RecargarDesdeShowbyidAsync()
    {
        var fresco = await Http.SafeGetAsync<CalculoModel>(
            $"{CalculoRoute.TiposOperacionCalculo}/{Uri.EscapeDataString(_model.COD_CLASE_OPERACION)}/{Uri.EscapeDataString(_model.COD_TIPO_OPERACION)}/{Uri.EscapeDataString(_model.COD_TIPO_VALOR_CALCULO)}");
        if (fresco is not null) MapearDesdeModelo(fresco);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!_esNuevo && Item is not null) await RecargarDesdeShowbyidAsync();

        var r = await Http.SafeGetAsync<List<ComboboxItem>>(CalculoRoute.TiposValorCalculoCombobox);
        _tiposValorCalculo = r ?? new();
    }
    private async Task Submit()
    {
        _saving = true;
        var ruta = CalculoRoute.TiposOperacionCalculo;
        if (Modo == CrudModo.Delete)
        {
            var rd = await Http.DeleteAsync(
                $"{ruta}/{Uri.EscapeDataString(_model.COD_CLASE_OPERACION)}/{Uri.EscapeDataString(_model.COD_TIPO_OPERACION)}/{Uri.EscapeDataString(_model.COD_TIPO_VALOR_CALCULO)}");
            _saving = false;
            if (rd.IsSuccessStatusCode) { Snackbar.Add("Eliminado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
            else await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(TiposOperacionCalculoDialog), nameof(Submit), "No se pudo eliminar el registro");
            return;
        }
        var dto = new
        {
            _model.COD_CLASE_OPERACION, _model.COD_TIPO_OPERACION, _model.COD_TIPO_VALOR_CALCULO,
            _model.NUM_ORDEN_PRESENTACION, _model.FLG_CALCULO_INVERSO, _model.FLG_MOSTRAR_COMPROBANTE,
            _model.FLG_VALOR_MOSTRAR, _model.FLG_POSITIVO,
            _model.COD_CUENTA_NATURALEZA, _model.COD_CUENTA_CONTABLE
        };
        var resp = await Http.GuardarAsync(ruta, dto, _esNuevo);
        _saving = false;
        if (resp.IsSuccessStatusCode) { Snackbar.Add(_esNuevo ? "Creado." : "Modificado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(TiposOperacionCalculoDialog), nameof(Submit));
    }
}
