@using KONSolutions.Shared.Models.Estandar
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <CrudDialogTitle Modo="Modo" Descripcion="@Item?.DES_TIPO_PERSONA" />
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <MudNumericField T="byte" @bind-Value="_model.COD_TIPO_PERSONA" Label="Código"
                              Variant="Variant.Outlined" Class="mb-3"
                              Disabled="@(!_esNuevo || _readonly)" Required="@_esNuevo" />
            <CampoTexto Tabla="ESTANDAR.TIPOS_PERSONAS" Columna="DES_TIPO_PERSONA"
                        @bind-Value="_model.DES_TIPO_PERSONA"
                        Disabled="_readonly" Obligatorio="true" />
            <CrudDialogActions Modo="Modo" Saving="_saving"
                               OnCancel="@(() => MudDialog.Cancel())" />
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TipoPersona? Item { get; set; }
    [Parameter] public CrudModo Modo { get; set; } = CrudModo.Create;

    private TipoPersona _model = new();
    private bool _esNuevo, _saving;
    private bool _readonly => Modo == CrudModo.Read || Modo == CrudModo.Delete;

    protected override void OnInitialized()
    {
        _esNuevo = Modo == CrudModo.Create;
        if (Item is not null) MapearDesdeModelo(Item);
    }

    private void MapearDesdeModelo(TipoPersona m) =>
        _model = new TipoPersona { COD_TIPO_PERSONA = m.COD_TIPO_PERSONA, DES_TIPO_PERSONA = m.DES_TIPO_PERSONA };

    private async Task RecargarDesdeShowbyidAsync()
    {
        var fresco = await Http.SafeGetAsync<TipoPersona>($"{ApiRoutes.Estandar.TiposPersonas}/{_model.COD_TIPO_PERSONA}");
        if (fresco is not null) MapearDesdeModelo(fresco);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!_esNuevo && Item is not null) await RecargarDesdeShowbyidAsync();
    }
    private async Task Submit()
    {
        _saving = true;
        if (Modo == CrudModo.Delete)
        {
            var rd = await Http.DeleteAsync($"{ApiRoutes.Estandar.TiposPersonas}/{_model.COD_TIPO_PERSONA}");
            _saving = false;
            if (rd.IsSuccessStatusCode) { Snackbar.Add("Eliminado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
            else await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(TiposPersonasDialog), nameof(Submit), "No se pudo eliminar el registro");
            return;
        }
        // PROC_ESTANDAR_TIPOS_PERSONAS_INSERT es upsert (inserta o actualiza según exista el
        // código) — el Controller nunca tuvo endpoint PUT, siempre se llama al mismo POST.
        var resp = await Http.PostAsJsonAsync(ApiRoutes.Estandar.TiposPersonas, _model);
        _saving = false;
        if (resp.IsSuccessStatusCode) { Snackbar.Add(_esNuevo ? "Creado." : "Modificado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(TiposPersonasDialog), nameof(Submit));
    }
}
