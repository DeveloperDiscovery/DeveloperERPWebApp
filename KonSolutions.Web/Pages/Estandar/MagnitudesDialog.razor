@using KONSolutions.Shared.Models.Estandar
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <CrudDialogTitle Modo="Modo" Codigo="@Item?.COD_TIPO_UNIDAD_MEDIDA" Descripcion="@Item?.DES_TIPO_UNIDAD_MEDIDA" />
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <CampoTexto Tabla="ESTANDAR.TIPOS_UNIDAD_MEDIDA" Columna="COD_TIPO_UNIDAD_MEDIDA"
                        @bind-Value="_model.COD_TIPO_UNIDAD_MEDIDA"
                        Disabled="@(!_esNuevo || _readonly)" Obligatorio="@_esNuevo" />
            <CampoTexto Tabla="ESTANDAR.TIPOS_UNIDAD_MEDIDA" Columna="DES_TIPO_UNIDAD_MEDIDA"
                        @bind-Value="_model.DES_TIPO_UNIDAD_MEDIDA"
                        Disabled="_readonly" Obligatorio="true" />
            <div class="my-3">
                <ImagePicker Image="_model.IMG_ICONO" ImageChanged="@(v => _model.IMG_ICONO = v)"
                             Label="Ícono" ReadOnly="_readonly" RemoveBackground="true" />
            </div>
            <CrudDialogActions Modo="Modo" Saving="_saving"
                               OnCancel="@(() => MudDialog.Cancel())" />
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TiposUnidadMedida? Item { get; set; }
    [Parameter] public CrudModo Modo { get; set; } = CrudModo.Create;

    private TiposUnidadMedida _model = new();
    private bool _esNuevo, _saving;
    private bool _readonly => Modo == CrudModo.Read || Modo == CrudModo.Delete;

    protected override void OnInitialized()
    {
        _esNuevo = Modo == CrudModo.Create;
        if (Item is not null) MapearDesdeModelo(Item);
    }

    private void MapearDesdeModelo(TiposUnidadMedida m) =>
        _model = new TiposUnidadMedida
        {
            COD_TIPO_UNIDAD_MEDIDA = m.COD_TIPO_UNIDAD_MEDIDA,
            DES_TIPO_UNIDAD_MEDIDA = m.DES_TIPO_UNIDAD_MEDIDA,
            IMG_ICONO = m.IMG_ICONO
        };

    private async Task RecargarDesdeShowbyidAsync()
    {
        var fresco = await Http.SafeGetAsync<TiposUnidadMedida>($"{ApiRoutes.Estandar.TiposUnidadMedida}/{Uri.EscapeDataString(_model.COD_TIPO_UNIDAD_MEDIDA)}");
        if (fresco is not null) MapearDesdeModelo(fresco);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!_esNuevo && Item is not null) await RecargarDesdeShowbyidAsync();
    }
    private async Task Submit()
    {
        _saving = true;
        if (Modo == CrudModo.Delete)
        {
            var rd = await Http.DeleteAsync($"{ApiRoutes.Estandar.TiposUnidadMedida}/{Uri.EscapeDataString(_model.COD_TIPO_UNIDAD_MEDIDA)}");
            _saving = false;
            if (rd.IsSuccessStatusCode) { Snackbar.Add("Eliminado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
            else await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(MagnitudesDialog), nameof(Submit), "No se pudo eliminar el registro");
            return;
        }
        var resp = _esNuevo
            ? await Http.PostAsJsonAsync(ApiRoutes.Estandar.TiposUnidadMedida, _model)
            : await Http.PutAsJsonAsync($"{ApiRoutes.Estandar.TiposUnidadMedida}/{Uri.EscapeDataString(_model.COD_TIPO_UNIDAD_MEDIDA)}", _model);
        _saving = false;
        if (resp.IsSuccessStatusCode) { Snackbar.Add(_esNuevo ? "Creada." : "Modificada.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(MagnitudesDialog), nameof(Submit));
    }
}
