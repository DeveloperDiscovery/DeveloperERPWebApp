@page "/estandar/sub-familias-producto"
@attribute [Authorize]
@using SubFamiliasProductoModel = KONSolutions.Shared.Models.Estandar.SubFamiliasProducto
@using System.Net.Http.Json
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@inject ShortcutService ShortcutSvc
@implements IDisposable
@inject ErrorLogService ErrorLog

<PageTitle>Sub Familias de Producto · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Sub Familias de Producto" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema ESTANDAR · @_visibles.Count de @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="Buscar" Placeholder="Buscar sub familia de producto..." DebounceInterval="400" MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f=>f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <GridPrintButton Titulo="Sub Familias de Producto"
                         Headers="@(new List<string>{"Familia","Código","Descripción","Tipo Producto","Partida Arancelaria","Estado"})"
                         Rows="@(_items.Select(x=>new List<string>{
                             x.DES_FAMILIA_PRODUCTO,
                             x.COD_SUB_FAMILIA_PRODUCTO,
                             x.DES_SUB_FAMILIA_PRODUCTO,
                             x.DES_TIPO_PRODUCTO,
                             x.COD_PARTIDA_ARANCELARIA,
                             x.DES_ESTADO
                         }).ToList())" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="sub-familias-producto" style="position:relative;">
    <MudDataGrid T="SubFamiliasProductoModel" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Sortable="false" Title="Familia"
                            Width="@Limites.ColWidth("ESTANDAR.SUB_FAMILIAS_PRODUCTO","COD_FAMILIA_PRODUCTO",80,160)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_FAMILIA_PRODUCTO" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="SubFamiliasProductoModel" ItemsBase="@Base(0)" ValorDe="@(x=>x.DES_FAMILIA_PRODUCTO)"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_FAMILIA_PRODUCTO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Código"
                            Width="@Limites.ColWidth("ESTANDAR.SUB_FAMILIAS_PRODUCTO","COD_SUB_FAMILIA_PRODUCTO",60,120)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_SUB_FAMILIA_PRODUCTO" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="SubFamiliasProductoModel" ItemsBase="@Base(1)" ValorDe="@(x=>x.COD_SUB_FAMILIA_PRODUCTO)"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.COD_SUB_FAMILIA_PRODUCTO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Descripción"
                            Width="@Limites.ColWidth("ESTANDAR.SUB_FAMILIAS_PRODUCTO","DES_SUB_FAMILIA_PRODUCTO",150,350)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_SUB_FAMILIA_PRODUCTO" Activo="@(_ordenColumna == 2)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(2))" />
                        <FiltroExcelColumna T="SubFamiliasProductoModel" ItemsBase="@Base(2)" ValorDe="@(x=>x.DES_SUB_FAMILIA_PRODUCTO)"
                                            ValoresActivos="_filtros.GetValueOrDefault(2)" ValoresActivosChanged="@(v=>Filtro(2,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_SUB_FAMILIA_PRODUCTO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Tipo Producto" Width="130">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_TIPO_PRODUCTO" Activo="@(_ordenColumna == 3)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(3))" />
                        <FiltroExcelColumna T="SubFamiliasProductoModel" ItemsBase="@Base(3)" ValorDe="@(x=>x.DES_TIPO_PRODUCTO ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(3)" ValoresActivosChanged="@(v=>Filtro(3,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_TIPO_PRODUCTO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Partida Arancelaria" Width="140">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_PARTIDA_ARANCELARIA" Activo="@(_ordenColumna == 4)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(4))" />
                        <FiltroExcelColumna T="SubFamiliasProductoModel" ItemsBase="@Base(4)" ValorDe="@(x=>x.COD_PARTIDA_ARANCELARIA ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(4)" ValoresActivosChanged="@(v=>Filtro(4,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.COD_PARTIDA_ARANCELARIA</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Estado" Width="110">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_ESTADO" Activo="@(_ordenColumna == 5)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(5))" />
                        <FiltroExcelColumna T="SubFamiliasProductoModel" ItemsBase="@Base(5)" ValorDe="@(x=>x.DES_ESTADO ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(5)" ValoresActivosChanged="@(v=>Filtro(5,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>
                    @if (!string.IsNullOrEmpty(context.Item.DES_ESTADO))
                    {
                        <EstadoChip Estado="@context.Item.DES_ESTADO"
                                    BackColor="@context.Item.DES_BACKCOLOR"
                                    ForeColor="@context.Item.DES_FORECOLOR" />
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin registros.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="SubFamiliasProductoModel" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    private Func<Task>? _onCambio;
    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<SubFamiliasProductoModel> _items  = new();
    private string _search = "";
    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;
    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }
    private List<SubFamiliasProductoModel> Ordenar(List<SubFamiliasProductoModel> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.DES_FAMILIA_PRODUCTO).ToList() : items.OrderByDescending(x => x.DES_FAMILIA_PRODUCTO).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.COD_SUB_FAMILIA_PRODUCTO).ToList() : items.OrderByDescending(x => x.COD_SUB_FAMILIA_PRODUCTO).ToList(),
        2 => _ordenAscendente ? items.OrderBy(x => x.DES_SUB_FAMILIA_PRODUCTO).ToList() : items.OrderByDescending(x => x.DES_SUB_FAMILIA_PRODUCTO).ToList(),
        3 => _ordenAscendente ? items.OrderBy(x => x.DES_TIPO_PRODUCTO).ToList() : items.OrderByDescending(x => x.DES_TIPO_PRODUCTO).ToList(),
        4 => _ordenAscendente ? items.OrderBy(x => x.COD_PARTIDA_ARANCELARIA).ToList() : items.OrderByDescending(x => x.COD_PARTIDA_ARANCELARIA).ToList(),
        5 => _ordenAscendente ? items.OrderBy(x => x.DES_ESTADO).ToList() : items.OrderByDescending(x => x.DES_ESTADO).ToList(),
        _ => items
    };
    private List<SubFamiliasProductoModel> _visibles => Ordenar(Aplicar(_items, -1));
    private List<SubFamiliasProductoModel> Base(int col) => Aplicar(_items, col);

    private List<SubFamiliasProductoModel> Aplicar(List<SubFamiliasProductoModel> src, int ex)
    {
        IEnumerable<SubFamiliasProductoModel> q = src;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(x.DES_FAMILIA_PRODUCTO)),
                1 => q.Where(x => v.Contains(x.COD_SUB_FAMILIA_PRODUCTO)),
                2 => q.Where(x => v.Contains(x.DES_SUB_FAMILIA_PRODUCTO)),
                3 => q.Where(x => v.Contains(x.DES_TIPO_PRODUCTO ?? "")),
                4 => q.Where(x => v.Contains(x.COD_PARTIDA_ARANCELARIA ?? "")),
                5 => q.Where(x => v.Contains(x.DES_ESTADO ?? "")),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }

    private async Task Buscar()
    {
        _items = string.IsNullOrWhiteSpace(_search) ? await Fetch() : await FetchSearch(_search);
    }

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("ESTANDAR", "SubFamiliasProducto");
        await Load();
        _onCambio = async () => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        Cambios.Suscribir("ESTANDAR.SUB_FAMILIAS_PRODUCTO", _onCambio);
        ShortcutSvc.NuevoRequested += OnAtajoNuevo;
    }

    private async void OnAtajoNuevo() => await InvokeAsync(() => Abrir(null, CrudModo.Create));

    private async Task Load() => _items = string.IsNullOrWhiteSpace(_search) ? await Fetch() : await FetchSearch(_search);

    private async Task<List<SubFamiliasProductoModel>> Fetch()
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<SubFamiliasProductoModel>>>(
                ApiRoutes.Estandar.SubFamiliasProducto);
            return r?.Data ?? new();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(SubFamiliasProducto), nameof(Fetch));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            return new();
        }
    }

    private async Task<List<SubFamiliasProductoModel>> FetchSearch(string s)
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<SubFamiliasProductoModel>>>(
                $"{ApiRoutes.Estandar.SubFamiliasProducto}/search?search={Uri.EscapeDataString(s)}");
            return r?.Data ?? new();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(SubFamiliasProducto), nameof(FetchSearch));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            return new();
        }
    }

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create);
        return Task.CompletedTask;
    }

    private Task OnAccionGrilla(SubFamiliasProductoModel item, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        return Task.CompletedTask;
    }

    private async Task Abrir(SubFamiliasProductoModel? item, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nueva sub familia de producto",
            CrudModo.Delete => $"Eliminar · {item?.DES_SUB_FAMILIA_PRODUCTO}",
            _               => $"Editar · {item?.DES_SUB_FAMILIA_PRODUCTO}"
        };
        var dlg = await DialogService.ShowAsync<SubFamiliasProductoDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    public void Dispose()
    {
        Cambios.Desuscribir("ESTANDAR.SUB_FAMILIAS_PRODUCTO", _onCambio ?? (() => Task.CompletedTask));
        ShortcutSvc.NuevoRequested -= OnAtajoNuevo;
    }
}
