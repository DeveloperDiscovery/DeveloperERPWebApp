@using KONSolutions.Shared.Models.Estandar
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <CrudDialogTitle Modo="Modo" Descripcion="@Item?.DES_TIPO_VIA" />
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <CampoTexto Tabla="ESTANDAR.TIPOS_VIA" Columna="COD_TIPO_VIA"
                        @bind-Value="_model.COD_TIPO_VIA"
                        Disabled="@(!_esNuevo || _readonly)" Obligatorio="@_esNuevo" />
            <CampoTexto Tabla="ESTANDAR.TIPOS_VIA" Columna="DES_TIPO_VIA"
                        @bind-Value="_model.DES_TIPO_VIA"
                        Disabled="_readonly" Obligatorio="true" />
            <CrudDialogActions Modo="Modo" Saving="_saving"
                               OnCancel="@(() => MudDialog.Cancel())" />
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TiposVia? Item { get; set; }
    [Parameter] public CrudModo Modo { get; set; } = CrudModo.Create;

    private TiposVia _model = new();
    private bool _esNuevo, _saving;
    private bool _readonly => Modo == CrudModo.Read || Modo == CrudModo.Delete;

    protected override void OnInitialized()
    {
        _esNuevo = Modo == CrudModo.Create;
        if (Item is not null) MapearDesdeModelo(Item);
    }

    private void MapearDesdeModelo(TiposVia m) =>
        _model = new TiposVia { COD_TIPO_VIA = m.COD_TIPO_VIA, DES_TIPO_VIA = m.DES_TIPO_VIA };

    private async Task RecargarDesdeShowbyidAsync()
    {
        var fresco = await Http.SafeGetAsync<TiposVia>($"{ApiRoutes.Estandar.TiposVia}/{Uri.EscapeDataString(_model.COD_TIPO_VIA)}");
        if (fresco is not null) MapearDesdeModelo(fresco);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!_esNuevo && Item is not null) await RecargarDesdeShowbyidAsync();
    }
    private async Task Submit()
    {
        _saving = true;
        if (Modo == CrudModo.Delete)
        {
            var rd = await Http.DeleteAsync($"{ApiRoutes.Estandar.TiposVia}/{Uri.EscapeDataString(_model.COD_TIPO_VIA)}");
            _saving = false;
            if (rd.IsSuccessStatusCode) { Snackbar.Add("Eliminado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
            else await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(TiposViasDialog), nameof(Submit), "No se pudo eliminar el registro");
            return;
        }
        // PROC_ESTANDAR_TIPOS_VIA_INSERT es upsert — el Controller nunca tuvo endpoint PUT,
        // siempre se llama al mismo POST.
        var resp = await Http.GuardarAsync(ApiRoutes.Estandar.TiposVia, _model, _esNuevo);
        _saving = false;
        if (resp.IsSuccessStatusCode) { Snackbar.Add(_esNuevo ? "Creado." : "Modificado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(TiposViasDialog), nameof(Submit));
    }
}
