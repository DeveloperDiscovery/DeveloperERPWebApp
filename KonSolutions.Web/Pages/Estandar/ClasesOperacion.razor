        Cambios.Desuscribir("COMERCIAL.TIPOS_OPERACION_CALCULO", _onCambio2 ?? (() => Task.CompletedTask));
        Cambios.Desuscribir("COMERCIAL.TIPOS_OPERACION_CALCULO_AFECTADOS", _onCambio3 ?? (() => Task.CompletedTask));
        Cambios.Desuscribir("COMERCIAL.TIPOS_OPERACION_TIPOS_COMPROBANTE_PAGO", _onCambio4 ?? (() => Task.CompletedTask));
