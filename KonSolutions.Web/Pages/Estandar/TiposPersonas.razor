@page "/estandar/tipos-personas"
@attribute [Authorize]
@using TipoPersonaRow = KONSolutions.Shared.Models.Estandar.TipoPersona
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@inject ShortcutService ShortcutSvc
@implements IDisposable

<PageTitle>Tipos de Persona · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Tipos de Persona" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema ESTANDAR · @_visibles.Count de @_items.Count registros</MudText>
    </div>
    @* Sin SP _SEARCH — el filtro de texto es local sobre lo ya cargado. *@
    <BarraBusqueda @bind-Value="_search" OnSearch="Filtrar" MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f => f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <GridPrintButton Titulo="Tipos de Persona" Headers="@(new List<string>{"Código","Descripción"})" Rows="@(_items.Select(x => new List<string>{x.COD_TIPO_PERSONA.ToString(), x.DES_TIPO_PERSONA}).ToList())" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="tipos-personas" style="position:relative;">
    <MudDataGrid T="TipoPersonaRow" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Sortable="false" Title="Código" Width="@Limites.ColWidth("ESTANDAR.TIPOS_PERSONAS","COD_TIPO_PERSONA",60,150)" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_TIPO_PERSONA" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="TipoPersonaRow" ItemsBase="@Base(0)" ValorDe="@(x => x.COD_TIPO_PERSONA.ToString())"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v => Filtro(0, v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.COD_TIPO_PERSONA</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Descripción" Width="@Limites.ColWidth("ESTANDAR.TIPOS_PERSONAS","DES_TIPO_PERSONA",120,350)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_TIPO_PERSONA" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="TipoPersonaRow" ItemsBase="@Base(1)" ValorDe="@(x => x.DES_TIPO_PERSONA)"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v => Filtro(1, v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_TIPO_PERSONA</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b => OnAccionGrilla(item, b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin tipos de persona registrados.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="TipoPersonaRow" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    [Parameter] public string CodAplicacion { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<TipoPersonaRow> _items = new();
    private string _search = "";
    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;
    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }
    private List<TipoPersonaRow> Ordenar(List<TipoPersonaRow> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.COD_TIPO_PERSONA).ToList() : items.OrderByDescending(x => x.COD_TIPO_PERSONA).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_TIPO_PERSONA).ToList() : items.OrderByDescending(x => x.DES_TIPO_PERSONA).ToList(),
        _ => items
    };

    private List<TipoPersonaRow> Filtrados() => string.IsNullOrWhiteSpace(_search)
        ? _items
        : _items.Where(x => x.DES_TIPO_PERSONA.Contains(_search, StringComparison.OrdinalIgnoreCase)
                          || x.COD_TIPO_PERSONA.ToString().Contains(_search)).ToList();

    private List<TipoPersonaRow> _visibles => Ordenar(Aplicar(Filtrados(), -1));
    private List<TipoPersonaRow> Base(int col) => Aplicar(Filtrados(), col);

    private List<TipoPersonaRow> Aplicar(List<TipoPersonaRow> src, int ex)
    {
        IEnumerable<TipoPersonaRow> q = src;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(x.COD_TIPO_PERSONA.ToString())),
                1 => q.Where(x => v.Contains(x.DES_TIPO_PERSONA)),
                _ => q
            };
        }
        return q.ToList();
    }
    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }
    private void Filtrar() => StateHasChanged();

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("ESTANDAR", "TiposPersonas");
        await Load();
        Cambios.Suscribir("ESTANDAR.TIPOS_PERSONAS", RefrescarPorCambio);
        ShortcutSvc.NuevoRequested += OnAtajoNuevo;
    }

    private async void OnAtajoNuevo() => await InvokeAsync(() => Abrir(null, CrudModo.Create));

    private async Task Load()
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<TipoPersonaRow>>>(ApiRoutes.Estandar.TiposPersonas);
            _items = r?.Data ?? new();
        }
        catch { _items = new(); }
    }

    private Task OnAccionHeader(BotonTreeviewItem b) { if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create); return Task.CompletedTask; }
    private Task OnAccionGrilla(TipoPersonaRow item, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        return Task.CompletedTask;
    }

    private async Task Abrir(TipoPersonaRow? item, CrudModo modo)
    {
        var titulo = modo switch { CrudModo.Create => "Nuevo tipo de persona", CrudModo.Delete => $"Eliminar · {item?.DES_TIPO_PERSONA}", _ => $"Editar · {item?.DES_TIPO_PERSONA}" };
        var dlg = await DialogService.ShowAsync<TiposPersonasDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    private async Task RefrescarPorCambio() => await InvokeAsync(async () => { await Load(); StateHasChanged(); });

    public void Dispose()
    {
        Cambios.Desuscribir("ESTANDAR.TIPOS_PERSONAS", RefrescarPorCambio);
        ShortcutSvc.NuevoRequested -= OnAtajoNuevo;
    }
}
