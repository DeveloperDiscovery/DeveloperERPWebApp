@using KONSolutions.Shared.Models.Estandar
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <CrudDialogTitle Modo="Modo" Descripcion="@Item?.DES_SEXO" />
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <CampoTexto Tabla="ESTANDAR.SEXOS" Columna="COD_SEXO"
                        @bind-Value="_model.COD_SEXO"
                        Disabled="@(!_esNuevo || _readonly)" Obligatorio="@_esNuevo" />
            <CampoTexto Tabla="ESTANDAR.SEXOS" Columna="DES_SEXO"
                        @bind-Value="_model.DES_SEXO"
                        Disabled="_readonly" Obligatorio="true" />
            <CrudDialogActions Modo="Modo" Saving="_saving"
                               OnCancel="@(() => MudDialog.Cancel())" />
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Sexo? Item { get; set; }
    [Parameter] public CrudModo Modo { get; set; } = CrudModo.Create;

    private Sexo _model = new();
    private bool _esNuevo, _saving;
    private bool _readonly => Modo == CrudModo.Read || Modo == CrudModo.Delete;

    protected override void OnInitialized()
    {
        _esNuevo = Modo == CrudModo.Create;
        if (Item is not null) MapearDesdeModelo(Item);
    }

    private void MapearDesdeModelo(Sexo m) =>
        _model = new Sexo { COD_SEXO = m.COD_SEXO, DES_SEXO = m.DES_SEXO };

    private async Task RecargarDesdeShowbyidAsync()
    {
        var fresco = await Http.SafeGetAsync<Sexo>($"{ApiRoutes.Estandar.Sexos}/{Uri.EscapeDataString(_model.COD_SEXO)}");
        if (fresco is not null) MapearDesdeModelo(fresco);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!_esNuevo && Item is not null) await RecargarDesdeShowbyidAsync();
    }
    private async Task Submit()
    {
        _saving = true;
        if (Modo == CrudModo.Delete)
        {
            var rd = await Http.DeleteAsync($"{ApiRoutes.Estandar.Sexos}/{Uri.EscapeDataString(_model.COD_SEXO)}");
            _saving = false;
            if (rd.IsSuccessStatusCode) { Snackbar.Add("Eliminado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
            else await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(SexosDialog), nameof(Submit), "No se pudo eliminar el registro");
            return;
        }
        // PROC_ESTANDAR_SEXOS_INSERT es upsert (inserta o actualiza según exista el código) —
        // el Controller nunca tuvo un endpoint PUT, siempre se llama al mismo POST.
        var resp = await Http.GuardarAsync(ApiRoutes.Estandar.Sexos, _model, _esNuevo);
        _saving = false;
        if (resp.IsSuccessStatusCode) { Snackbar.Add(_esNuevo ? "Creado." : "Modificado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(SexosDialog), nameof(Submit));
    }
}
