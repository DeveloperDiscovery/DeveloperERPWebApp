@* Pestaña hija de Sucursales: ZONIFICACION.ZONIFICACION de la sucursal seleccionada. *@
@using ZonificacionModel = KONSolutions.Shared.Models.Zonificacion.Zonificacion
@using KONSolutions.Shared.Common
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject LimitesService Limites
@inject ErrorLogService ErrorLog

<div class="d-flex align-center justify-space-between pa-3" style="border-bottom:1px solid var(--line);">
    <div>
        <MudText Typo="Typo.h6">Zonificación</MudText>
        <MudText Class="mono" Style="opacity:.5;font-size:.78rem;color:var(--subtitulo-color,#6b6358);">
            @if (!string.IsNullOrWhiteSpace(CodSucursal)) { <text>Sucursal: @DesSucursal · @_items.Count zonas</text> }
            else { <text>Seleccione una sucursal arriba</text> }
        </MudText>
    </div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f=>f.Value is not null))" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   Disabled="@string.IsNullOrWhiteSpace(CodSucursal)" Size="Size.Small"
                   OnClick="@(() => Abrir(null, CrudModo.Create))">Nueva zona</MudButton>
    </div>
</div>

@if (string.IsNullOrWhiteSpace(CodSucursal))
{
    <MudText Class="pa-6 mono" Style="opacity:.4;">Seleccione una sucursal para ver su zonificación.</MudText>
}
else if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <div data-resizable-grid="sucursal-zonificacion" style="position:relative;">
    <MudDataGrid T="ZonificacionModel" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaHijo">
        <Columns>
            <TemplateColumn Sortable="false" Title="Plano" Width="70" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <HeaderTemplate><EncabezadoOrdenable Texto="Plano" /></HeaderTemplate>
                <CellTemplate>
                    @* Señal rápida de qué niveles ya tienen plano cargado — es el insumo
                       de la vista geométrica, así que conviene verlo de un vistazo. *@
                    @if (context.Item.IMG_PLANO is { Length: > 0 })
                    {
                        <GridImage Image="context.Item.IMG_PLANO" />
                    }
                    else
                    {
                        <MudTooltip Text="Sin plano cargado">
                            <MudIcon Icon="@Icons.Material.Filled.HideImage" Size="Size.Small" Style="opacity:.25;" />
                        </MudTooltip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Código"
                            Width="@Limites.ColWidth("ZONIFICACION.ZONIFICACION","COD_ZONIFICACION",90,160)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1">
                        <EncabezadoOrdenable Campo="COD_ZONIFICACION" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="ZonificacionModel" ItemsBase="@Base(0)" ValorDe="@(x=>x.COD_ZONIFICACION)"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate><span class="mono">@context.Item.COD_ZONIFICACION</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Zona"
                            Width="@Limites.ColWidth("ZONIFICACION.ZONIFICACION","DES_ZONIFICACION",150,300)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1">
                        <EncabezadoOrdenable Campo="DES_ZONIFICACION" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="ZonificacionModel" ItemsBase="@Base(1)" ValorDe="@(x=>x.DES_ZONIFICACION ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>
                    @* Sangría por profundidad real en el árbol (cadena de padres), NO por
                       NUM_NIVEL: ese campo es el piso físico, así que "3er piso" se veía
                       sangrado tres veces aunque sea una zona raíz. *@
                    <span style="@($"padding-left:{Profundidad(context.Item) * 16}px;")">
                        @context.Item.DES_ZONIFICACION
                    </span>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Zona padre" Width="140">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1">
                        <EncabezadoOrdenable Texto="Zona padre" />
                        <FiltroExcelColumna T="ZonificacionModel" ItemsBase="@Base(2)" ValorDe="@(x=>x.COD_ZONIFICACION_PADRE ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(2)" ValoresActivosChanged="@(v=>Filtro(2,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate><span class="mono" style="opacity:.7;">@context.Item.COD_ZONIFICACION_PADRE</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Tipo" Width="160">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1">
                        <EncabezadoOrdenable Campo="DES_TIPO_ZONIFICACION" Activo="@(_ordenColumna == 3)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(3))" />
                        <FiltroExcelColumna T="ZonificacionModel" ItemsBase="@Base(3)" ValorDe="@(x=>x.DES_TIPO_ZONIFICACION ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(3)" ValoresActivosChanged="@(v=>Filtro(3,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_TIPO_ZONIFICACION</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Nivel" Width="80" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <HeaderTemplate><EncabezadoOrdenable Campo="NUM_NIVEL" Activo="@(_ordenColumna == 4)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(4))" /></HeaderTemplate>
                <CellTemplate>@context.Item.NUM_NIVEL</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Medidas" Width="130" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <HeaderTemplate><EncabezadoOrdenable Texto="Medidas" /></HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.VAL_ANCHO_METROS is > 0 || context.Item.VAL_LARGO_METROS is > 0)
                    {
                        <span class="mono" style="opacity:.75;">@context.Item.VAL_ANCHO_METROS × @context.Item.VAL_LARGO_METROS m</span>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Estado" Width="120" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <HeaderTemplate><EncabezadoOrdenable Texto="Estado" /></HeaderTemplate>
                <CellTemplate>
                    @if (!string.IsNullOrWhiteSpace(context.Item.DES_ESTADO))
                    {
                        <EstadoChip Estado="@context.Item.DES_ESTADO" BackColor="@context.Item.DES_BACKCOLOR" ForeColor="@context.Item.DES_FORECOLOR" />
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false" Width="130">
                <CellTemplate>
                    @{ var z = context.Item; }
                    <div class="d-flex align-center gap-1">
                        <MudTooltip Text="Modificar">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => Abrir(z, CrudModo.Update))" />
                        </MudTooltip>
                        <MudTooltip Text="Eliminar">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => Abrir(z, CrudModo.Delete))" />
                        </MudTooltip>
                        <MudTooltip Text="Consultar">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Info"
                                           OnClick="@(() => Abrir(z, CrudModo.Read))" />
                        </MudTooltip>
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-4 mono" Style="opacity:.5;">Esta sucursal no tiene zonificación aún.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="ZonificacionModel" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
}

@code {
    [Parameter] public string CodSucursal { get; set; } = "";
    [Parameter] public string DesSucursal { get; set; } = "";

    private List<ZonificacionModel> _items = new();
    private bool _loading;
    private string _sucursalCargada = "";

    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;

    private List<ZonificacionModel> _visibles => Ordenar(Aplicar(_items, -1));
    private List<ZonificacionModel> Base(int col) => Aplicar(_items, col);

    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }

    private List<ZonificacionModel> Ordenar(List<ZonificacionModel> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.COD_ZONIFICACION).ToList()      : items.OrderByDescending(x => x.COD_ZONIFICACION).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_ZONIFICACION).ToList()      : items.OrderByDescending(x => x.DES_ZONIFICACION).ToList(),
        3 => _ordenAscendente ? items.OrderBy(x => x.DES_TIPO_ZONIFICACION).ToList() : items.OrderByDescending(x => x.DES_TIPO_ZONIFICACION).ToList(),
        4 => _ordenAscendente ? items.OrderBy(x => x.NUM_NIVEL).ToList()             : items.OrderByDescending(x => x.NUM_NIVEL).ToList(),
        // Sin orden explícito, cada hija queda debajo de su padre: el SP arma el código como
        // PADRE + correlativo, así que ordenar por código ya reproduce el recorrido del árbol.
        _ => items.OrderBy(x => x.COD_ZONIFICACION, StringComparer.Ordinal).ToList()
    };

    // Profundidad calculada una vez por carga: se consulta en cada celda, así que rehacer
    // el diccionario de padres en cada render sería gasto puro.
    private Dictionary<string, int> _profundidades = new();

    private int Profundidad(ZonificacionModel item)
        => _profundidades.GetValueOrDefault(item.COD_ZONIFICACION);

    /// <summary>Cuántos padres tiene cada zona encima. Recorre la cadena de
    /// COD_ZONIFICACION_PADRE con un tope de saltos por si quedara un ciclo en los datos.</summary>
    private void CalcularProfundidades()
    {
        var padreDe = _items.ToDictionary(x => x.COD_ZONIFICACION, x => x.COD_ZONIFICACION_PADRE);
        _profundidades = new Dictionary<string, int>(_items.Count);
        foreach (var z in _items)
        {
            var nivel = 0;
            var padre = z.COD_ZONIFICACION_PADRE;
            while (!string.IsNullOrWhiteSpace(padre) && nivel < 20 && padreDe.TryGetValue(padre, out var abuelo))
            {
                nivel++;
                padre = abuelo;
            }
            _profundidades[z.COD_ZONIFICACION] = nivel;
        }
    }

    private List<ZonificacionModel> Aplicar(List<ZonificacionModel> src, int ex)
    {
        IEnumerable<ZonificacionModel> q = src;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(x.COD_ZONIFICACION)),
                1 => q.Where(x => v.Contains(x.DES_ZONIFICACION ?? "")),
                2 => q.Where(x => v.Contains(x.COD_ZONIFICACION_PADRE ?? "")),
                3 => q.Where(x => v.Contains(x.DES_TIPO_ZONIFICACION ?? "")),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }

    // Recarga sola cuando el padre cambia de sucursal. Se compara contra la última cargada
    // para no repetir la llamada en cada render del componente.
    protected override async Task OnParametersSetAsync()
    {
        if (CodSucursal != _sucursalCargada)
        {
            _sucursalCargada = CodSucursal;
            await Load();
        }
    }

    public async Task Load()
    {
        if (string.IsNullOrWhiteSpace(CodSucursal)) { _items = new(); return; }
        _loading = true;
        try
        {
            // El SP SHOWALL exige @COD_SUCURSAL: la ruta lleva el código de la sucursal padre.
            var r = await Http.GetFromJsonAsync<ApiResponse<List<ZonificacionModel>>>(
                $"{ApiRoutes.Zonificacion.Zonificaciones}/{Uri.EscapeDataString(CodSucursal)}");
            _items = r?.Data ?? new();
            CalcularProfundidades();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(SucursalZonificacionTab), nameof(Load));
            Snackbar.Add("No se pudo cargar la zonificación. Ver detalle en el log de errores.", Severity.Error);
            _items = new();
            _profundidades = new();
        }
        _loading = false;
    }

    private async Task Abrir(ZonificacionModel? item, CrudModo modo)
    {
        if (string.IsNullOrWhiteSpace(CodSucursal)) { Snackbar.Add("Seleccione primero una sucursal.", Severity.Warning); return; }
        var titulo = modo switch
        {
            CrudModo.Create => "Nueva zona",
            CrudModo.Delete => $"Eliminar · {item?.DES_ZONIFICACION}",
            CrudModo.Read   => $"Consultar · {item?.DES_ZONIFICACION}",
            _               => $"Editar · {item?.DES_ZONIFICACION}"
        };
        var dlg = await DialogService.ShowAsync<ZonificacionDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo, ["CodSucursal"] = CodSucursal },
            // Large para que la vista previa del plano tenga ancho útil.
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }
}
