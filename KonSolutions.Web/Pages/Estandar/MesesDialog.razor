@using KONSolutions.Shared.Models.Estandar
@inject CatalogoService<Mes, MesDto> Service
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog Style="width:min(480px,95vw);">
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            @if (_isEdit || _readonly)
            {
                <MudTextField Value="@_model.NUM_MES.ToString()" Label="Código" Variant="Variant.Outlined"
                              Disabled="true" Class="mb-3" />
            }
            <CampoTexto Tabla="ESTANDAR.MESES" Columna="DES_MES"
                        @bind-Value="_model.DES_MES" Disabled="_readonly" Obligatorio="true" />

            <MudNumericField @bind-Value="_model.NUM_DIAS" Label="Días" Variant="Variant.Outlined"
                              Disabled="_readonly" Class="mb-3" Min="0" Max="31" />

            <div class="d-flex align-center justify-space-between py-1">
                <span style="font-family:var(--control-font, inherit);font-size:var(--control-size, 14px);color:var(--control-color, inherit);">Afecta al cálculo de bisiesto</span>
                <MudSwitch T="bool?" @bind-Value="_model.FLG_AFECTA_BISIESTO" Color="Color.Primary" Disabled="_readonly" />
            </div>

            <CrudDialogActions Modo="Modo" Saving="_saving" OnCancel="@(() => MudDialog.Cancel())" />
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Mes? Item { get; set; }
    [Parameter] public CrudModo Modo { get; set; } = CrudModo.Create;

    private MesDto _model = new();
    private bool _isEdit, _saving;
    private bool _readonly => Modo == CrudModo.Read || Modo == CrudModo.Delete;

    protected override void OnInitialized()
    {
        _isEdit = Modo == CrudModo.Update;
        if (Item is not null) MapearDesdeModelo(Item);
    }

    /// <summary>Copia los campos editables del modelo (Item de la grilla, o la respuesta
    /// fresca de GetByIdAsync) hacia _model.</summary>
    private void MapearDesdeModelo(Mes m) => _model = new MesDto
    {
        NUM_MES = m.NUM_MES,
        DES_MES = m.DES_MES ?? "",
        NUM_DIAS = m.NUM_DIAS,
        FLG_AFECTA_BISIESTO = m.FLG_AFECTA_BISIESTO
    };

    /// <summary>Trae el registro fresco desde GetByIdAsync — se usa al abrir el diálogo
    /// (Modificar/Eliminar/Ver, nunca Crear) para no mostrar datos desactualizados de la grilla.</summary>
    private async Task RecargarDesdeShowbyidAsync()
    {
        var fresco = await Service.GetByIdAsync(_model.NUM_MES.ToString());
        if (fresco is not null) MapearDesdeModelo(fresco);
    }

    protected override async Task OnInitializedAsync()
    {
        if (Modo != CrudModo.Create && Item is not null) await RecargarDesdeShowbyidAsync();
    }

    private async Task Submit()
    {
        _saving = true;
        if (Modo == CrudModo.Delete)
        {
            var (okd, msgd) = await Service.EliminarAsync(_model.NUM_MES.ToString());
            _saving = false;
            if (okd) { Snackbar.Add("Mes eliminado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
            else await ErrorDialogHelper.MostrarMensajeAsync(msgd, DialogService, nameof(MesesDialog));
            return;
        }
        // PROC_ESTANDAR_MESES_INSERT es upsert (siempre POST) — NUM_MES queda en 0 en un alta
        // nueva, el SP lo ignora y asigna el IDENTITY real.
        var (ok, msg) = await Service.GuardarAsync(_model);
        _saving = false;
        if (ok) { Snackbar.Add(_isEdit ? "Mes actualizado." : "Mes creado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarMensajeAsync(msg, DialogService, nameof(MesesDialog));
    }
}
