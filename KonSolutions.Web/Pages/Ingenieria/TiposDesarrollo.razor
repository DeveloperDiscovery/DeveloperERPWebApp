@page "/ingenieria/tipos-desarrollo"
@attribute [Authorize]
@using TipoDesarrolloModel = KONSolutions.Shared.Models.Ingenieria.TipoDesarrollo
@using ClaseDesarrolloModel = KONSolutions.Shared.Models.Ingenieria.ClaseDesarrollo
@using System.Net.Http.Json
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject ShortcutService ShortcutSvc
@implements IDisposable

<PageTitle>Tipos de Desarrollo · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Tipos de Desarrollo" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema INGENIERIA · @_visibles.Count de @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="@(() => Task.CompletedTask)" Placeholder="Buscar tipo de desarrollo..." DebounceInterval="300" MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f=>f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="LoadTipos" />
        @if (_claseSel is not null)
        {
            <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                             Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
        }
    </div>
</div>

<MudPaper Elevation="0" Class="pa-3 mb-3" Style="border:1px solid var(--line);">
    <AriaCombo TItem="ComboboxItem" Items="_clases"
               TextFunc="@(c => $"{c.Id} - {c.Texto}")" ValueFunc="@(c => c.Id)"
               Value="_claseSel?.Id" ValueChanged="OnClaseChanged"
               Label="Clase de desarrollo" Class="" />
</MudPaper>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="tipos-desarrollo" style="position:relative;">
    <MudDataGrid T="TipoDesarrolloModel" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Title="Código" Sortable="false" Width="120">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Código" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="TipoDesarrolloModel" ItemsBase="@Base(0)" ValorDe="@(x=>x.COD_TIPO_DESARROLLO)"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.COD_TIPO_DESARROLLO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Descripción" Sortable="false">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Descripción" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="TipoDesarrolloModel" ItemsBase="@Base(1)" ValorDe="@(x=>x.DES_TIPO_DESARROLLO)"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_TIPO_DESARROLLO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Clase de desarrollo" Sortable="false" Width="220">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Clase de desarrollo" Activo="@(_ordenColumna == 2)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(2))" />
                        <FiltroExcelColumna T="TipoDesarrolloModel" ItemsBase="@Base(2)" ValorDe="@(x=>x.DES_CLASE_DESARROLLO ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(2)" ValoresActivosChanged="@(v=>Filtro(2,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_CLASE_DESARROLLO</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false" Width="140">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent>
            <MudText Class="pa-6 mono" Style="opacity:.5;">
                @(_claseSel is null ? "Seleccione una clase de desarrollo arriba." : "Sin registros.")
            </MudText>
        </NoRecordsContent>
        <PagerContent><MudDataGridPager T="TipoDesarrolloModel" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    private Func<Task>? _onCambio;
    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<ComboboxItem>       _clases = new();
    private List<TipoDesarrolloModel> _items = new();
    private ComboboxItem?             _claseSel;
    private string _search = "";

    private List<TipoDesarrolloModel> _busqueda =>
        string.IsNullOrWhiteSpace(_search) ? _items
        : _items.Where(t => (t.COD_TIPO_DESARROLLO?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                          || (t.DES_TIPO_DESARROLLO?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;

    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }

    private List<TipoDesarrolloModel> Ordenar(List<TipoDesarrolloModel> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.COD_TIPO_DESARROLLO).ToList() : items.OrderByDescending(x => x.COD_TIPO_DESARROLLO).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_TIPO_DESARROLLO).ToList() : items.OrderByDescending(x => x.DES_TIPO_DESARROLLO).ToList(),
        2 => _ordenAscendente ? items.OrderBy(x => x.DES_CLASE_DESARROLLO).ToList() : items.OrderByDescending(x => x.DES_CLASE_DESARROLLO).ToList(),
        _ => items
    };

    private List<TipoDesarrolloModel> _visibles => Ordenar(Aplicar(_busqueda, -1));
    private List<TipoDesarrolloModel> Base(int col) => Aplicar(_busqueda, col);

    private List<TipoDesarrolloModel> Aplicar(List<TipoDesarrolloModel> src, int ex)
    {
        IEnumerable<TipoDesarrolloModel> q = src;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(x.COD_TIPO_DESARROLLO)),
                1 => q.Where(x => v.Contains(x.DES_TIPO_DESARROLLO)),
                2 => q.Where(x => v.Contains(x.DES_CLASE_DESARROLLO ?? "")),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("INGENIERIA", "TiposDesarrollo");
        try
        {
            // No se usa /combobox: el SP SHOWCOMBOX de Clases de Desarrollo devuelve las
            // columnas COD_/DES_ completas, no Id/Texto — se arma el combo desde el listado.
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<ClaseDesarrolloModel>>>(
                ApiRoutes.Ingenieria.ClasesDesarrollo);
            _clases = (r?.Data ?? new())
                .Select(c => new ComboboxItem { Id = c.COD_CLASE_DESARROLLO, Texto = c.DES_CLASE_DESARROLLO })
                .ToList();
        }
        catch { _clases = new(); }

        _claseSel = _clases.FirstOrDefault();
        if (_claseSel is not null) await LoadTipos();

        _onCambio = async () => await InvokeAsync(async () => { await LoadTipos(); StateHasChanged(); });
        Cambios.Suscribir("INGENIERIA.TIPOS_DESARROLLO", _onCambio);
        ShortcutSvc.NuevoRequested += OnAtajoNuevo;
    }

    private async void OnAtajoNuevo() => await InvokeAsync(() => Abrir(null, CrudModo.Create));

    private async Task OnClaseChanged(string? codClase)
    {
        _claseSel = _clases.FirstOrDefault(c => c.Id == codClase);
        await LoadTipos();
    }

    private async Task LoadTipos()
    {
        if (_claseSel is null) { _items = new(); return; }
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<TipoDesarrolloModel>>>(
                $"{ApiRoutes.Ingenieria.TiposDesarrollo}?codClaseDesarrollo={Uri.EscapeDataString(_claseSel.Id)}");
            _items = r?.Data ?? new();
        }
        catch { _items = new(); }
    }

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create);
        return Task.CompletedTask;
    }

    private Task OnAccionGrilla(TipoDesarrolloModel item, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        if (b.FLG_ACCION_GET    == true) return Abrir(item, CrudModo.Read);
        return Task.CompletedTask;
    }

    private async Task Abrir(TipoDesarrolloModel? item, CrudModo modo)
    {
        if (_claseSel is null) return;
        var dlg = await DialogService.ShowAsync<TipoDesarrolloDialog>(
            modo switch
            {
                CrudModo.Create => "Nuevo tipo de desarrollo",
                CrudModo.Delete => $"Eliminar · {item?.DES_TIPO_DESARROLLO}",
                CrudModo.Read   => $"Consultar · {item?.DES_TIPO_DESARROLLO}",
                _               => $"Editar · {item?.DES_TIPO_DESARROLLO}"
            },
            new DialogParameters
            {
                ["Item"] = item,
                ["Modo"] = modo,
                ["CodClaseDesarrollo"] = _claseSel.Id,
                ["DesClaseDesarrollo"] = _claseSel.Texto
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await LoadTipos();
    }

    public void Dispose()
    {
        Cambios.Desuscribir("INGENIERIA.TIPOS_DESARROLLO", _onCambio ?? (() => Task.CompletedTask));
        ShortcutSvc.NuevoRequested -= OnAtajoNuevo;
    }
}
