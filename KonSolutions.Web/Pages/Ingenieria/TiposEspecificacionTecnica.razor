@page "/ingenieria/tipos-especificacion-tecnica"
@attribute [Authorize]
@using TiposEspecificacionTecnicaModel = KONSolutions.Shared.Models.Ingenieria.TiposEspecificacionTecnica
@using System.Net.Http.Json
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@implements IDisposable
@inject ErrorLogService ErrorLog

<PageTitle>Tipos de Especificación Técnica · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Tipos de Especificación Técnica" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema INGENIERIA · @_visibles.Count de @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="Buscar" Placeholder="Buscar tipo de especificación técnica..." DebounceInterval="400" MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f=>f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="tipos-especificacion-tecnica" style="position:relative;">
    <MudDataGrid T="TiposEspecificacionTecnicaModel" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Sortable="false" Title="Código"
                            Width="@Limites.ColWidth("INGENIERIA.TIPOS_ESPECIFICACION_TECNICA","COD_TIPO_ESPECIFICACION_TECNICA",60,120)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_TIPO_ESPECIFICACION_TECNICA" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="TiposEspecificacionTecnicaModel" ItemsBase="@Base(0)" ValorDe="@(x=>x.COD_TIPO_ESPECIFICACION_TECNICA)"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.COD_TIPO_ESPECIFICACION_TECNICA</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Descripción"
                            Width="@Limites.ColWidth("INGENIERIA.TIPOS_ESPECIFICACION_TECNICA","DES_TIPO_ESPECIFICACION_TECNICA",150,350)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_TIPO_ESPECIFICACION_TECNICA" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="TiposEspecificacionTecnicaModel" ItemsBase="@Base(1)" ValorDe="@(x=>x.DES_TIPO_ESPECIFICACION_TECNICA)"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_TIPO_ESPECIFICACION_TECNICA</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Tipo de Dato" Width="220">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Tipo de Dato" Activo="@(_ordenColumna == 2)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(2))" />
                        <FiltroExcelColumna T="TiposEspecificacionTecnicaModel" ItemsBase="@Base(2)" ValorDe="@(x=>TipoDatoTexto(x))"
                                            ValoresActivos="_filtros.GetValueOrDefault(2)" ValoresActivosChanged="@(v=>Filtro(2,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@TipoDatoTexto(context.Item)</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Opciones" Sortable="false" CellStyle="text-align:center;" HeaderStyle="text-align:center;" Width="90">
                <CellTemplate>
                    <div class="d-flex align-center justify-center gap-2">
                        <MudTooltip Text="Es lista">
                            <MudIcon Icon="@Icons.Material.Filled.List" Color="@(context.Item.FLG_LISTA == true ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_LISTA == true ? "" : "opacity:.15;")" Size="Size.Small" />
                        </MudTooltip>
                        <MudTooltip Text="Es color">
                            <MudIcon Icon="@Icons.Material.Filled.Palette" Color="@(context.Item.FLG_COLOR == true ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_COLOR == true ? "" : "opacity:.15;")" Size="Size.Small" />
                        </MudTooltip>
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Orden" Width="80">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="NUM_ORDEN_PRESENTACION" Activo="@(_ordenColumna == 3)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(3))" />
                        <FiltroExcelColumna T="TiposEspecificacionTecnicaModel" ItemsBase="@Base(3)" ValorDe="@(x=>x.NUM_ORDEN_PRESENTACION?.ToString() ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(3)" ValoresActivosChanged="@(v=>Filtro(3,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.NUM_ORDEN_PRESENTACION</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <div @onclick:stopPropagation="true">
                        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                         Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" />
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin registros.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="TiposEspecificacionTecnicaModel" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    private Func<Task>? _onCambio;
    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<TiposEspecificacionTecnicaModel> _items  = new();
    private string _search = "";
    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;
    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }
    private List<TiposEspecificacionTecnicaModel> Ordenar(List<TiposEspecificacionTecnicaModel> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.COD_TIPO_ESPECIFICACION_TECNICA).ToList() : items.OrderByDescending(x => x.COD_TIPO_ESPECIFICACION_TECNICA).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_TIPO_ESPECIFICACION_TECNICA).ToList() : items.OrderByDescending(x => x.DES_TIPO_ESPECIFICACION_TECNICA).ToList(),
        2 => _ordenAscendente ? items.OrderBy(x => TipoDatoTexto(x)).ToList() : items.OrderByDescending(x => TipoDatoTexto(x)).ToList(),
        3 => _ordenAscendente ? items.OrderBy(x => x.NUM_ORDEN_PRESENTACION).ToList() : items.OrderByDescending(x => x.NUM_ORDEN_PRESENTACION).ToList(),
        _ => items
    };
    private List<TiposEspecificacionTecnicaModel> _visibles => Ordenar(Aplicar(_items, -1));
    private List<TiposEspecificacionTecnicaModel> Base(int col) => Aplicar(_items, col);

    private List<TiposEspecificacionTecnicaModel> Aplicar(List<TiposEspecificacionTecnicaModel> src, int ex)
    {
        IEnumerable<TiposEspecificacionTecnicaModel> q = src;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(x.COD_TIPO_ESPECIFICACION_TECNICA)),
                1 => q.Where(x => v.Contains(x.DES_TIPO_ESPECIFICACION_TECNICA)),
                2 => q.Where(x => v.Contains(TipoDatoTexto(x))),
                3 => q.Where(x => v.Contains(x.NUM_ORDEN_PRESENTACION?.ToString() ?? "")),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }

    private static string TipoDatoTexto(TiposEspecificacionTecnicaModel x)
    {
        var partes = new List<string>();
        if (x.FLG_ENTERO == true) partes.Add("Entero");
        if (x.FLG_NUMERICO == true) partes.Add("Numérico");
        if (x.FLG_CADENA == true) partes.Add("Cadena");
        if (x.FLG_FECHA_HORA == true) partes.Add("Fecha/Hora");
        if (x.FLG_FECHA == true) partes.Add("Fecha");
        if (x.FLG_HORA == true) partes.Add("Hora");
        if (x.FLG_LOGICO == true) partes.Add("Lógico");
        return string.Join(", ", partes);
    }

    private async Task Buscar()
    {
        _items = string.IsNullOrWhiteSpace(_search) ? await Fetch() : await FetchSearch(_search);
    }

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("INGENIERIA", "TiposEspecificacionTecnica");
        await Load();
        _onCambio = async () => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        Cambios.Suscribir("INGENIERIA.TIPOS_ESPECIFICACION_TECNICA", _onCambio);
    }

    private async Task Load() => _items = string.IsNullOrWhiteSpace(_search) ? await Fetch() : await FetchSearch(_search);

    private async Task<List<TiposEspecificacionTecnicaModel>> Fetch()
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<TiposEspecificacionTecnicaModel>>>(
                ApiRoutes.Ingenieria.TiposEspecificacionTecnica);
            return r?.Data ?? new();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(TiposEspecificacionTecnica), nameof(Fetch));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            return new();
        }
    }

    private async Task<List<TiposEspecificacionTecnicaModel>> FetchSearch(string s)
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<TiposEspecificacionTecnicaModel>>>(
                $"{ApiRoutes.Ingenieria.TiposEspecificacionTecnica}/search?search={Uri.EscapeDataString(s)}");
            return r?.Data ?? new();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(TiposEspecificacionTecnica), nameof(FetchSearch));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            return new();
        }
    }

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create);
        return Task.CompletedTask;
    }

    private Task OnAccionGrilla(TiposEspecificacionTecnicaModel item, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        if (b.FLG_ACCION_GET    == true) return Abrir(item, CrudModo.Read);
        return Task.CompletedTask;
    }

    private async Task Abrir(TiposEspecificacionTecnicaModel? item, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nuevo tipo de especificación técnica",
            CrudModo.Delete => $"Eliminar · {item?.DES_TIPO_ESPECIFICACION_TECNICA}",
            CrudModo.Read   => $"Consultar · {item?.DES_TIPO_ESPECIFICACION_TECNICA}",
            _               => $"Editar · {item?.DES_TIPO_ESPECIFICACION_TECNICA}"
        };
        var dlg = await DialogService.ShowAsync<TiposEspecificacionTecnicaDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    public void Dispose() => Cambios.Desuscribir("INGENIERIA.TIPOS_ESPECIFICACION_TECNICA", _onCambio ?? (() => Task.CompletedTask));
}
