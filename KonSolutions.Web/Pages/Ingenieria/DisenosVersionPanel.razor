@* Grilla de versiones de un diseño (INGENIERIA.DISENOS_VERSION).
   Componente reutilizable: lo usan tanto el tab "Versiones" dentro de la pantalla de
   Diseños como la pantalla suelta del sub módulo (DisenosVersion.razor). Por eso recibe
   el diseño por parámetro en vez de resolverlo por su cuenta. *@
@using DisenoVersionModel = KONSolutions.Shared.Models.Ingenieria.DisenoVersion
@using System.Net.Http.Json
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog

<div class="d-flex align-center gap-3 pa-3 grid-header-compacto">
    <div class="grid-header-titulo">
        <MudText Typo="Typo.h6">Versiones</MudText>
        <MudText Class="mono" Style="opacity:.6;font-size:.78rem;">
            @(string.IsNullOrWhiteSpace(CodDiseno)
                ? "Ningún diseño seleccionado"
                : $"Diseño: {CodDiseno}{(string.IsNullOrWhiteSpace(DesDiseno) ? "" : $" – {DesDiseno}")} · {_visibles.Count} de {_items.Count}")
        </MudText>
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="@(() => Task.CompletedTask)" Placeholder="Buscar versión..." DebounceInterval="300" MaxWidth="719px" Class="grid-header-search" />
    @* Solo se muestra cuando el contenedor pasa OnVolver (dentro del tab de Diseños); la
       pantalla suelta del sub módulo (DisenosVersion.razor) no lo necesita. Mismo formato
       que GridRefreshButton/GridClearFiltersButton (Configuración General → Botones de
       Diálogo y Acciones de Cabecera): grid-header-btn + color configurable. *@
    @if (OnVolver.HasDelegate)
    {
        <MudTooltip Text="Volver a Diseños">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Class="grid-header-btn"
                           Style="background-color:var(--boton-backcolor,var(--ink));color:var(--boton-forecolor,var(--paper));border-radius:10px;"
                           OnClick="@(() => OnVolver.InvokeAsync())" />
        </MudTooltip>
    }
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f=>f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="CargarAsync" />
        @if (!string.IsNullOrWhiteSpace(CodDiseno))
        {
            <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                             Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
        }
    </div>
</div>

<div data-resizable-grid="disenos-version" data-default-height="360" style="position:relative;">
<MudDataGrid T="DisenoVersionModel" Items="_visibles" Dense="true" Hover="true" Striped="true"
             Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaHijo">
    <Columns>
        <TemplateColumn Title="Versión" Sortable="false" Width="90">
            <HeaderTemplate>
                @* Texto explícito: el Diccionario de Etiquetas todavía no tiene rótulo
                   para estas columnas y la cabecera salía en blanco. *@
                <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Versión" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                    <FiltroExcelColumna T="DisenoVersionModel" ItemsBase="@Base(0)" ValorDe="@(x=>x.NUM_VERSION?.ToString() ?? "")"
                                        ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                </div>
            </HeaderTemplate>
            <CellTemplate>@context.Item.NUM_VERSION</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Descripción" Sortable="false">
            <HeaderTemplate>
                <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Descripción" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                    <FiltroExcelColumna T="DisenoVersionModel" ItemsBase="@Base(1)" ValorDe="@(x=>x.DES_VERSION ?? "")"
                                        ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                </div>
            </HeaderTemplate>
            <CellTemplate>@context.Item.DES_VERSION</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Clase de desarrollo" Sortable="false" Width="200">
            <HeaderTemplate>
                <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Clase de desarrollo" Activo="@(_ordenColumna == 2)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(2))" />
                    <FiltroExcelColumna T="DisenoVersionModel" ItemsBase="@Base(2)" ValorDe="@(x=>x.DES_CLASE_DESARROLLO ?? x.COD_CLASE_DESARROLLO ?? "")"
                                        ValoresActivos="_filtros.GetValueOrDefault(2)" ValoresActivosChanged="@(v=>Filtro(2,v))" />
                </div>
            </HeaderTemplate>
            <CellTemplate>@(context.Item.DES_CLASE_DESARROLLO ?? context.Item.COD_CLASE_DESARROLLO)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Tipo de desarrollo" Sortable="false" Width="200">
            <HeaderTemplate>
                <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Tipo de desarrollo" Activo="@(_ordenColumna == 3)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(3))" />
                    <FiltroExcelColumna T="DisenoVersionModel" ItemsBase="@Base(3)" ValorDe="@(x=>x.DES_TIPO_DESARROLLO ?? x.COD_TIPO_DESARROLLO ?? "")"
                                        ValoresActivos="_filtros.GetValueOrDefault(3)" ValoresActivosChanged="@(v=>Filtro(3,v))" />
                </div>
            </HeaderTemplate>
            <CellTemplate>@(context.Item.DES_TIPO_DESARROLLO ?? context.Item.COD_TIPO_DESARROLLO)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Ruta de producción" Sortable="false" Width="200">
            <HeaderTemplate>
                <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Ruta de producción" Activo="@(_ordenColumna == 4)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(4))" />
                    <FiltroExcelColumna T="DisenoVersionModel" ItemsBase="@Base(4)" ValorDe="@(x=>x.DES_RUTA_PRODUCCION ?? x.COD_RUTA_PRODUCCION ?? "")"
                                        ValoresActivos="_filtros.GetValueOrDefault(4)" ValoresActivosChanged="@(v=>Filtro(4,v))" />
                </div>
            </HeaderTemplate>
            <CellTemplate>@(context.Item.DES_RUTA_PRODUCCION ?? context.Item.COD_RUTA_PRODUCCION)</CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Estado" Sortable="false" Width="130">
            <HeaderTemplate>
                <div class="d-flex align-center gap-1"><EncabezadoOrdenable Texto="Estado" Activo="@(_ordenColumna == 5)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(5))" />
                    <FiltroExcelColumna T="DisenoVersionModel" ItemsBase="@Base(5)" ValorDe="@(x=>x.DES_ESTADO ?? "")"
                                        ValoresActivos="_filtros.GetValueOrDefault(5)" ValoresActivosChanged="@(v=>Filtro(5,v))" />
                </div>
            </HeaderTemplate>
            <CellTemplate>
                @if (!string.IsNullOrEmpty(context.Item.DES_ESTADO))
                {
                    <EstadoChip Estado="@context.Item.DES_ESTADO" BackColor="@context.Item.DES_BACKCOLOR" ForeColor="@context.Item.DES_FORECOLOR" />
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Acciones" Sortable="false" Width="140">
            <CellTemplate>
                @{ var item = context.Item; }
                <div @onclick:stopPropagation="true">
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" />
                </div>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <NoRecordsContent>
        <MudText Class="pa-6 mono" Style="opacity:.5;">
            @(string.IsNullOrWhiteSpace(CodDiseno)
                ? "Seleccione un diseño para ver sus versiones."
                : "Este diseño todavía no tiene versiones.")
        </MudText>
    </NoRecordsContent>
    <PagerContent><MudDataGridPager T="DisenoVersionModel" /></PagerContent>
</MudDataGrid>
<div class="grid-resize-handle"></div>
</div>

@code {
    [Parameter, EditorRequired] public string CodDiseno { get; set; } = "";
    [Parameter] public string? DesDiseno { get; set; }

    /// <summary>Códigos de la opción del SUB MÓDULO (Diseños Versión), no los del módulo
    /// contenedor — así los botones respetan los permisos configurados para el sub módulo.</summary>
    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    /// <summary>Botón "Volver" en la cabecera — presente solo cuando el contenedor lo
    /// conecta (el tab de Versiones dentro de Diseños).</summary>
    [Parameter] public EventCallback OnVolver { get; set; }

    private List<DisenoVersionModel> _items = new();
    private string _search = "";
    private string _codDisenoCargado = "";

    private List<DisenoVersionModel> _busqueda =>
        string.IsNullOrWhiteSpace(_search) ? _items
        : _items.Where(v => (v.NUM_VERSION?.ToString().Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                         || (v.DES_VERSION?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                         || (v.DES_OBSERVACIONES?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;

    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }

    private List<DisenoVersionModel> Ordenar(List<DisenoVersionModel> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.NUM_VERSION).ToList() : items.OrderByDescending(x => x.NUM_VERSION).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_VERSION).ToList() : items.OrderByDescending(x => x.DES_VERSION).ToList(),
        2 => _ordenAscendente ? items.OrderBy(x => x.DES_CLASE_DESARROLLO ?? x.COD_CLASE_DESARROLLO).ToList() : items.OrderByDescending(x => x.DES_CLASE_DESARROLLO ?? x.COD_CLASE_DESARROLLO).ToList(),
        3 => _ordenAscendente ? items.OrderBy(x => x.DES_TIPO_DESARROLLO ?? x.COD_TIPO_DESARROLLO).ToList() : items.OrderByDescending(x => x.DES_TIPO_DESARROLLO ?? x.COD_TIPO_DESARROLLO).ToList(),
        4 => _ordenAscendente ? items.OrderBy(x => x.DES_RUTA_PRODUCCION ?? x.COD_RUTA_PRODUCCION).ToList() : items.OrderByDescending(x => x.DES_RUTA_PRODUCCION ?? x.COD_RUTA_PRODUCCION).ToList(),
        5 => _ordenAscendente ? items.OrderBy(x => x.DES_ESTADO).ToList() : items.OrderByDescending(x => x.DES_ESTADO).ToList(),
        _ => items
    };

    private List<DisenoVersionModel> _visibles => Ordenar(Aplicar(_busqueda, -1));
    private List<DisenoVersionModel> Base(int col) => Aplicar(_busqueda, col);

    private List<DisenoVersionModel> Aplicar(List<DisenoVersionModel> src, int ex)
    {
        IEnumerable<DisenoVersionModel> q = src;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(x.NUM_VERSION?.ToString() ?? "")),
                1 => q.Where(x => v.Contains(x.DES_VERSION ?? "")),
                2 => q.Where(x => v.Contains(x.DES_CLASE_DESARROLLO ?? x.COD_CLASE_DESARROLLO ?? "")),
                3 => q.Where(x => v.Contains(x.DES_TIPO_DESARROLLO ?? x.COD_TIPO_DESARROLLO ?? "")),
                4 => q.Where(x => v.Contains(x.DES_RUTA_PRODUCCION ?? x.COD_RUTA_PRODUCCION ?? "")),
                5 => q.Where(x => v.Contains(x.DES_ESTADO ?? "")),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }

    // Recarga cuando el contenedor cambia de diseño (p.ej. otra fila en la grilla de Diseños).
    protected override async Task OnParametersSetAsync()
    {
        if (CodDiseno != _codDisenoCargado)
        {
            _codDisenoCargado = CodDiseno;
            LimpiarFiltros();
            await CargarAsync();
        }
    }

    /// <summary>Recarga pública: la usa el contenedor tras crear/editar desde otra pantalla.</summary>
    public async Task CargarAsync()
    {
        if (string.IsNullOrWhiteSpace(CodDiseno)) { _items = new(); return; }
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<DisenoVersionModel>>>(
                $"{ApiRoutes.Ingenieria.DisenosVersion}?codDiseno={Uri.EscapeDataString(CodDiseno)}");
            _items = r?.Data ?? new();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(DisenosVersionPanel), nameof(CargarAsync));
            Snackbar.Add("No se pudieron cargar las versiones. Ver detalle en el log de errores.", Severity.Error);
            _items = new();
        }
        StateHasChanged();
    }

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create);
        return Task.CompletedTask;
    }

    // Botón "Ayuda Memoria" — bitácora libre de la versión
    // (INGENIERIA.DISENOS_VERSIONES_MEMORIAS).
    private static bool EsBotonAyudaMemoria(BotonTreeviewItem b)
    {
        if (string.Equals(b.DES_METODO, "AyudaMemoria", StringComparison.OrdinalIgnoreCase)) return true;
        var n = ((b.DES_BOTON_OPCION ?? b.DES_ALIAS ?? "") + " " + (b.DES_TOOLTIPTEXT ?? "")).ToUpperInvariant();
        return n.Contains("MEMORIA");
    }

    private async Task AbrirAyudaMemoria(DisenoVersionModel item)
    {
        var dlg = await DialogService.ShowAsync<DisenosVersionesMemoriasDialog>(
            "Ayuda Memoria",
            new DialogParameters { ["Item"] = item },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        await dlg.Result;
    }

    // Regla general de la app: una versión ANULADA ('ANU') queda congelada — solo consulta.
    // Ayuda Memoria sí se abre: el diálogo se pone en solo lectura por dentro.
    private Task OnAccionGrilla(DisenoVersionModel item, BotonTreeviewItem b)
    {
        if (EstadoAlias.EsAnulado(item.COD_ESTADO_ALIAS) && b.FLG_ACCION_GET != true && !EsBotonAyudaMemoria(b))
        {
            Snackbar.Add("La versión está anulada: solo se permite consultarla.", Severity.Warning);
            return Task.CompletedTask;
        }
        if (EsBotonAyudaMemoria(b)) return AbrirAyudaMemoria(item);
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        if (b.FLG_ACCION_GET    == true) return Abrir(item, CrudModo.Read);
        return Task.CompletedTask;
    }

    private async Task Abrir(DisenoVersionModel? item, CrudModo modo)
    {
        if (string.IsNullOrWhiteSpace(CodDiseno)) { Snackbar.Add("Seleccione primero un diseño.", Severity.Info); return; }

        var dlg = await DialogService.ShowAsync<DisenosVersionDialog>(
            modo switch
            {
                CrudModo.Create => "Nueva versión",
                CrudModo.Delete => $"Eliminar · versión {item?.NUM_VERSION}",
                CrudModo.Read   => $"Consultar · versión {item?.NUM_VERSION}",
                _               => $"Editar · versión {item?.NUM_VERSION}"
            },
            new DialogParameters
            {
                ["Item"]      = item,
                ["Modo"]      = modo,
                ["CodDiseno"] = CodDiseno,
                ["DesDiseno"] = DesDiseno
            },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await CargarAsync();
    }
}
