    .p-ok{background:rgba(34,197,94,.15);color:var(--ok)} .p-warn{background:rgba(245,158,11,.15);color:var(--warn)} .p-crit{background:rgba(239,68,68,.15);color:var(--crit)} .p-info{background:rgba(56,189,248,.15);color:var(--info)}

