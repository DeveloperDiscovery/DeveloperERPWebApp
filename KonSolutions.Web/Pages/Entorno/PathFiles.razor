@page "/entorno/path-files"
@attribute [Authorize]
@using KONSolutions.Shared.Models.Entorno
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@inject ShortcutService ShortcutSvc
@implements IDisposable
@inject ErrorLogService ErrorLog

<PageTitle>Rutas de archivos · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Rutas de archivos" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema ENTORNO · @_visibles.Count de @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="Filtrar" MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f=>f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <GridPrintButton Titulo="Rutas de archivos"
            Headers="@(new List<string>{"Key","Ruta"})"
            Rows="@(_items.Select(x=>new List<string>{x.COD_KEY_PATHFILE,x.DES_KEY_PATHFILE}).ToList())" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="pathfiles" style="position:relative;">
    <MudDataGrid T="PathFile" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Sortable="false" Title="Key" Width="@Limites.ColWidth("ENTORNO.PATHFILES","COD_KEY_PATHFILE",100,180)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_KEY_PATHFILE" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="PathFile" ItemsBase="@Base(0)" ValorDe="@(x=>x.COD_KEY_PATHFILE)"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate><span class="mono">@context.Item.COD_KEY_PATHFILE</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Ruta" Width="@Limites.ColWidth("ENTORNO.PATHFILES","DES_KEY_PATHFILE",200,480)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_KEY_PATHFILE" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="PathFile" ItemsBase="@Base(1)" ValorDe="@(x=>x.DES_KEY_PATHFILE)"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate><span class="mono">@context.Item.DES_KEY_PATHFILE</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Servidor" Width="150">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_KEY_IP" Activo="@(_ordenColumna == 2)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(2))" />
                        <FiltroExcelColumna T="PathFile" ItemsBase="@Base(2)" ValorDe="@(x=>x.DES_KEY_IP ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(2)" ValoresActivosChanged="@(v=>Filtro(2,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@(context.Item.DES_KEY_IP ?? "—")</CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Rotación" Sortable="false" CellStyle="text-align:center;" HeaderStyle="text-align:center;" Width="150">
                <CellTemplate>
                    <div class="d-flex align-center justify-center gap-2">
                        <MudTooltip Text="Año">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarViewMonth" Color="@(context.Item.FLG_YEAR == true ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_YEAR == true ? "" : "opacity:.2;")" Size="Size.Small" />
                        </MudTooltip>
                        <MudTooltip Text="Mes">
                            <MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="@(context.Item.FLG_MONTH == true ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_MONTH == true ? "" : "opacity:.2;")" Size="Size.Small" />
                        </MudTooltip>
                        <MudTooltip Text="Semana">
                            <MudIcon Icon="@Icons.Material.Filled.ViewWeek" Color="@(context.Item.FLG_WEEK == true ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_WEEK == true ? "" : "opacity:.2;")" Size="Size.Small" />
                        </MudTooltip>
                        <MudTooltip Text="Día">
                            <MudIcon Icon="@Icons.Material.Filled.Today" Color="@(context.Item.FLG_DAY == true ? Color.Success : Color.Error)"
                                     Style="@(context.Item.FLG_DAY == true ? "" : "opacity:.2;")" Size="Size.Small" />
                        </MudTooltip>
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Estado" Width="110">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_ESTADO" Activo="@(_ordenColumna == 3)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(3))" />
                        <FiltroExcelColumna T="PathFile" ItemsBase="@Base(3)" ValorDe="@(x=>x.DES_ESTADO ?? "")"
                                            ValoresActivos="_filtros.GetValueOrDefault(3)" ValoresActivosChanged="@(v=>Filtro(3,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>
                    <EstadoChip Estado="@context.Item.DES_ESTADO"
                                BackColor="@context.Item.DES_BACKCOLOR"
                                ForeColor="@context.Item.DES_FORECOLOR" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin registros.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="PathFile" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    private Func<Task>? _onCambio;
    [Parameter] public string CodAplicacion { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<PathFile> _items = new();
    private string _search = "";
    private readonly Dictionary<int,HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;
    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }
    private List<PathFile> Ordenar(List<PathFile> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.COD_KEY_PATHFILE).ToList() : items.OrderByDescending(x => x.COD_KEY_PATHFILE).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_KEY_PATHFILE).ToList() : items.OrderByDescending(x => x.DES_KEY_PATHFILE).ToList(),
        2 => _ordenAscendente ? items.OrderBy(x => x.DES_KEY_IP).ToList() : items.OrderByDescending(x => x.DES_KEY_IP).ToList(),
        3 => _ordenAscendente ? items.OrderBy(x => x.DES_ESTADO).ToList() : items.OrderByDescending(x => x.DES_ESTADO).ToList(),
        _ => items
    };
    private List<PathFile> _visibles => Ordenar(Aplicar(_items, -1));
    private List<PathFile> Base(int col) => Aplicar(_items, col);

    private List<PathFile> Aplicar(List<PathFile> src, int ex)
    {
        IEnumerable<PathFile> q = src;
        foreach (var (c,v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(x.COD_KEY_PATHFILE)),
                1 => q.Where(x => v.Contains(x.DES_KEY_PATHFILE)),
                2 => q.Where(x => v.Contains(x.DES_KEY_IP ?? "")),
                3 => q.Where(x => v.Contains(x.DES_ESTADO ?? "")),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }
    private async Task Filtrar() => _items = string.IsNullOrWhiteSpace(_search)
        ? await Fetch() : await FetchSearch(_search);

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("ENTORNO", "PathFiles");
        await Load();
        _onCambio = async () => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        Cambios.Suscribir("ENTORNO.PATHFILES", _onCambio);
        ShortcutSvc.NuevoRequested += OnAtajoNuevo;
    }

    private async void OnAtajoNuevo() => await InvokeAsync(() => Abrir(null, CrudModo.Create));

    private async Task Load() { _items = string.IsNullOrWhiteSpace(_search) ? await Fetch() : await FetchSearch(_search); }
    private async Task<List<PathFile>> Fetch()
    {
        try { var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<PathFile>>>(ApiRoutes.Entorno.PathFiles); return r?.Data ?? new(); }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(PathFiles), nameof(Fetch));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            return new();
        }
    }
    private async Task<List<PathFile>> FetchSearch(string s)
    {
        try { var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<PathFile>>>($"{ApiRoutes.Entorno.PathFiles}/search?search={Uri.EscapeDataString(s)}"); return r?.Data ?? new(); }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(PathFiles), nameof(FetchSearch));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            return new();
        }
    }

    private Task OnAccionHeader(BotonTreeviewItem b) { if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create); return Task.CompletedTask; }
    private Task OnAccionGrilla(PathFile item, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_GET    == true) return Abrir(item, CrudModo.Read);
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        return Task.CompletedTask;
    }

    private async Task Abrir(PathFile? item, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nueva ruta",
            CrudModo.Read   => $"Ver · {item?.DES_KEY_PATHFILE}",
            CrudModo.Delete => $"Eliminar · {item?.DES_KEY_PATHFILE}",
            _               => $"Editar · {item?.DES_KEY_PATHFILE}"
        };
        var dlg = await DialogService.ShowAsync<PathFilesDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    public void Dispose()
    {
        Cambios.Desuscribir("ENTORNO.PATHFILES", _onCambio ?? (() => Task.CompletedTask));
        ShortcutSvc.NuevoRequested -= OnAtajoNuevo;
    }
}
