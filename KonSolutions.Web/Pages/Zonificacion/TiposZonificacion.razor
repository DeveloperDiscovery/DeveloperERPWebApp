@page "/zonificacion/tipos-zonificacion"
@attribute [Authorize]
@using TiposZonificacionModel = KONSolutions.Shared.Models.Zonificacion.TiposZonificacion
@inject HttpClient Http
@inject ConfigService ConfigSvc
@inject IDialogService DialogService
@inject AccessLogService AccessLog
@inject ISnackbar Snackbar
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@inject ShortcutService ShortcutSvc
@implements IDisposable
@inject ErrorLogService ErrorLog

<PageTitle>Tipos de Zonificación · @ConfigSvc.Current.NombreApp</PageTitle>

<div class="d-flex align-center gap-3 mb-4 grid-header-compacto">
    <div class="grid-header-titulo">
        <TituloPagina Fallback="Tipos de Zonificación" CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion" />
        <MudText Class="mono" Style="opacity:.5;font-size:.82rem;color:var(--subtitulo-color,#6b6358);">Schema ZONIFICACION · @_visibles.Count de @_items.Count registros</MudText>
    </div>
    <BarraBusqueda @bind-Value="_search" OnSearch="Buscar" Placeholder="Buscar tipo de zonificación..." DebounceInterval="400" MaxWidth="719px" Class="grid-header-search" />
    <GridClearFiltersButton OnClear="LimpiarFiltros" HasFilters="@(_filtros.Any(f=>f.Value is not null))" />
    <div class="grid-header-divider"></div>
    <div class="d-flex gap-2">
        <GridRefreshButton OnRefresh="Load" />
        <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                         Zona="@AccionesBotones.ZonaBotones.Header" OnAccion="OnAccionHeader" />
    </div>
</div>

<MudPaper Elevation="0" Style="border:1px solid var(--line);">
    <div data-resizable-grid="tipos-zonificacion" style="position:relative;">
    <MudDataGrid T="TiposZonificacionModel" Items="_visibles" Dense="true" Hover="true" Striped="true"
                 Height="100%" FixedHeader="true" RowsPerPage="@ConfigSvc.Current.FilasPorPaginaUnica">
        <Columns>
            <TemplateColumn Title="Ícono" Sortable="false" Width="70" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <HeaderTemplate><EncabezadoOrdenable Texto="Ícono" /></HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.IMG_ICONO is { Length: > 0 })
                    {
                        <GridImage Image="context.Item.IMG_ICONO" />
                    }
                    else
                    {
                        <MudTooltip Text="Sin ícono">
                            <MudIcon Icon="@Icons.Material.Filled.HideImage" Size="Size.Small" Style="opacity:.25;" />
                        </MudTooltip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Código"
                            Width="@Limites.ColWidth("ZONIFICACION.TIPOS_ZONIFICACION","COD_TIPO_ZONIFICACION",70,120)" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="COD_TIPO_ZONIFICACION" Activo="@(_ordenColumna == 0)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(0))" />
                        <FiltroExcelColumna T="TiposZonificacionModel" ItemsBase="@Base(0)" ValorDe="@(x=>x.COD_TIPO_ZONIFICACION)"
                                            ValoresActivos="_filtros.GetValueOrDefault(0)" ValoresActivosChanged="@(v=>Filtro(0,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate><span class="mono">@context.Item.COD_TIPO_ZONIFICACION</span></CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" Title="Tipo de Zonificación"
                            Width="@Limites.ColWidth("ZONIFICACION.TIPOS_ZONIFICACION","DES_TIPO_ZONIFICACION",150,300)">
                <HeaderTemplate>
                    <div class="d-flex align-center gap-1"><EncabezadoOrdenable Campo="DES_TIPO_ZONIFICACION" Activo="@(_ordenColumna == 1)" Ascendente="_ordenAscendente" OnClick="@(() => ToggleOrden(1))" />
                        <FiltroExcelColumna T="TiposZonificacionModel" ItemsBase="@Base(1)" ValorDe="@(x=>x.DES_TIPO_ZONIFICACION)"
                                            ValoresActivos="_filtros.GetValueOrDefault(1)" ValoresActivosChanged="@(v=>Filtro(1,v))" />
                    </div>
                </HeaderTemplate>
                <CellTemplate>@context.Item.DES_TIPO_ZONIFICACION</CellTemplate>
            </TemplateColumn>
            @* Qué tipos de zona llevan mapa. Es lo que decide qué aparece en el selector de
               pisos del Mapa de Piso, así que conviene verlo en el listado. *@
            <TemplateColumn Sortable="false" Title="Mapa" Width="90" CellStyle="text-align:center;" HeaderStyle="text-align:center;">
                <HeaderTemplate><EncabezadoOrdenable Texto="Mapa" /></HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.FLG_MAPEABLE == true)
                    {
                        <MudTooltip Text="Se dibuja en el Mapa de Piso">
                            <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" Color="Color.Primary" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="No se dibuja en el Mapa de Piso">
                            <MudIcon Icon="@Icons.Material.Filled.Map" Size="Size.Small" Style="opacity:.2;" />
                        </MudTooltip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Acciones" Sortable="false">
                <CellTemplate>
                    @{ var item = context.Item; }
                    <AccionesBotones CodAplicacion="@CodAplicacion" CodOpcionAplicacion="@CodOpcionAplicacion"
                                     Zona="@AccionesBotones.ZonaBotones.Grilla" OnAccion="@(b=>OnAccionGrilla(item,b))" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <NoRecordsContent><MudText Class="pa-6 mono" Style="opacity:.5;">Sin registros.</MudText></NoRecordsContent>
        <PagerContent><MudDataGridPager T="TiposZonificacionModel" /></PagerContent>
    </MudDataGrid>
    <div class="grid-resize-handle"></div>
    </div>
</MudPaper>

@code {
    private Func<Task>? _onCambio;
    [Parameter] public string CodAplicacion       { get; set; } = "";
    [Parameter] public string CodOpcionAplicacion { get; set; } = "";

    private List<TiposZonificacionModel> _items = new();
    private string _search = "";
    private readonly Dictionary<int, HashSet<string>?> _filtros = new();
    private int? _ordenColumna;
    private bool _ordenAscendente = true;

    private void ToggleOrden(int columna)
    {
        if (_ordenColumna == columna) _ordenAscendente = !_ordenAscendente;
        else { _ordenColumna = columna; _ordenAscendente = true; }
        StateHasChanged();
    }

    private List<TiposZonificacionModel> Ordenar(List<TiposZonificacionModel> items) => _ordenColumna switch
    {
        0 => _ordenAscendente ? items.OrderBy(x => x.COD_TIPO_ZONIFICACION).ToList() : items.OrderByDescending(x => x.COD_TIPO_ZONIFICACION).ToList(),
        1 => _ordenAscendente ? items.OrderBy(x => x.DES_TIPO_ZONIFICACION).ToList() : items.OrderByDescending(x => x.DES_TIPO_ZONIFICACION).ToList(),
        _ => items
    };

    private List<TiposZonificacionModel> _visibles => Ordenar(Aplicar(_items, -1));
    private List<TiposZonificacionModel> Base(int col) => Aplicar(_items, col);

    private List<TiposZonificacionModel> Aplicar(List<TiposZonificacionModel> src, int ex)
    {
        IEnumerable<TiposZonificacionModel> q = src;
        foreach (var (c, v) in _filtros)
        {
            if (c == ex || v is null) continue;
            q = c switch
            {
                0 => q.Where(x => v.Contains(x.COD_TIPO_ZONIFICACION)),
                1 => q.Where(x => v.Contains(x.DES_TIPO_ZONIFICACION)),
                _ => q
            };
        }
        return q.ToList();
    }

    private void Filtro(int c, HashSet<string>? v) { _filtros[c] = v; StateHasChanged(); }
    private void LimpiarFiltros() { foreach (var k in _filtros.Keys.ToList()) _filtros[k] = null; StateHasChanged(); }

    // El SP _SEARCH de esta tabla arranca con "WHERE 1 = 1 OR (...)", así que ignora el
    // texto y siempre devuelve todo — por eso se filtra en memoria y no se llama al SP.
    private Task Buscar() { StateHasChanged(); return Task.CompletedTask; }

    protected override async Task OnInitializedAsync()
    {
        await AccessLog.LogNavegacionAsync("ZONIFICACION", "TiposZonificacion");
        await Load();
        _onCambio = async () => await InvokeAsync(async () => { await Load(); StateHasChanged(); });
        Cambios.Suscribir("ZONIFICACION.TIPOS_ZONIFICACION", _onCambio);
        ShortcutSvc.NuevoRequested += OnAtajoNuevo;
    }

    private async void OnAtajoNuevo() => await InvokeAsync(() => Abrir(null, CrudModo.Create));

    private async Task Load()
    {
        try
        {
            var r = await Http.GetFromJsonAsync<KONSolutions.Shared.Common.ApiResponse<List<TiposZonificacionModel>>>(
                ApiRoutes.Zonificacion.TiposZonificacion);
            var todos = r?.Data ?? new();
            _items = string.IsNullOrWhiteSpace(_search)
                ? todos
                : todos.Where(x => x.COD_TIPO_ZONIFICACION.Contains(_search, StringComparison.OrdinalIgnoreCase)
                                || x.DES_TIPO_ZONIFICACION.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, nameof(TiposZonificacion), nameof(Load));
            Snackbar.Add("No se pudo cargar la información. Ver detalle en el log de errores.", Severity.Error);
            _items = new();
        }
    }

    private Task OnAccionHeader(BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_POST == true) return Abrir(null, CrudModo.Create);
        return Task.CompletedTask;
    }

    private Task OnAccionGrilla(TiposZonificacionModel item, BotonTreeviewItem b)
    {
        if (b.FLG_ACCION_GET    == true) return Abrir(item, CrudModo.Read);
        if (b.FLG_ACCION_PUT    == true) return Abrir(item, CrudModo.Update);
        if (b.FLG_ACCION_DELETE == true) return Abrir(item, CrudModo.Delete);
        return Task.CompletedTask;
    }

    private async Task Abrir(TiposZonificacionModel? item, CrudModo modo)
    {
        var titulo = modo switch
        {
            CrudModo.Create => "Nuevo tipo de zonificación",
            CrudModo.Delete => $"Eliminar · {item?.DES_TIPO_ZONIFICACION}",
            CrudModo.Read   => $"Consultar · {item?.DES_TIPO_ZONIFICACION}",
            _               => $"Editar · {item?.DES_TIPO_ZONIFICACION}"
        };
        var dlg = await DialogService.ShowAsync<TiposZonificacionDialog>(titulo,
            new DialogParameters { ["Item"] = item, ["Modo"] = modo },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = false });
        if ((await dlg.Result) is { Canceled: false }) await Load();
    }

    public void Dispose()
    {
        Cambios.Desuscribir("ZONIFICACION.TIPOS_ZONIFICACION", _onCambio ?? (() => Task.CompletedTask));
        ShortcutSvc.NuevoRequested -= OnAtajoNuevo;
    }
}
