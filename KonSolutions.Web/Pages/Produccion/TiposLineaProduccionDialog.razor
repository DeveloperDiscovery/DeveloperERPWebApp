@using TiposLineaProduccionModel = KONSolutions.Shared.Models.Produccion.TiposLineaProduccion
@using TiposLineaProduccionRoute = KONSolutions.Web.Services.ApiRoutes.Produccion
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject ErrorLogService ErrorLog
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <CrudDialogTitle Modo="Modo" Descripcion="@Item?.DES_TIPO_LINEA_PRODUCCION" />
    </TitleContent>
    <DialogContent>
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <div class="d-flex" style="gap:16px;">
                <div style="flex:1;min-width:0;">
                    <CampoTexto Tabla="PRODUCCION.TIPOS_LINEA_PRODUCCION" Columna="COD_TIPO_LINEA_PRODUCCION"
                                @bind-Value="_model.COD_TIPO_LINEA_PRODUCCION"
                                Disabled="@(!_esNuevo || _readonly)" Obligatorio="@_esNuevo" />
                    <CampoTexto Tabla="PRODUCCION.TIPOS_LINEA_PRODUCCION" Columna="DES_TIPO_LINEA_PRODUCCION"
                                @bind-Value="_model.DES_TIPO_LINEA_PRODUCCION"
                                Disabled="_readonly" Obligatorio="true" />
                    <div class="d-flex align-center justify-space-between py-1">
                        <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.PrecisionManufacturing" Color="Color.Primary" Size="Size.Medium" /><MudText Typo="Typo.body2">Producción</MudText></div>
                        <MudSwitch T="bool?" @bind-Value="_model.FLG_PRODUCCION" Color="Color.Primary" Disabled="_readonly" />
                    </div>
                    <div class="d-flex align-center justify-space-between py-1">
                        <div class="d-flex align-center gap-2"><MudIcon Icon="@Icons.Material.Filled.Factory" Color="Color.Primary" Size="Size.Medium" /><MudText Typo="Typo.body2">Planta Propia</MudText></div>
                        <MudSwitch T="bool?" @bind-Value="_model.FLG_PLANTA_PROPIA" Color="Color.Primary" Disabled="_readonly" />
                    </div>
                </div>
                <div style="flex-shrink:0;padding-left:8px;border-left:1px solid rgba(0,0,0,.1);">
                    <ImagePicker Image="_model.IMG_PICTURE" ImageChanged="@(v => _model.IMG_PICTURE = v)" Label="Icono" ReadOnly="_readonly" />
                </div>
            </div>
            <CrudDialogActions Modo="Modo" Saving="_saving"
                               OnCancel="@(() => MudDialog.Cancel())" />
        </EditForm>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TiposLineaProduccionModel? Item { get; set; }
    [Parameter] public CrudModo Modo { get; set; } = CrudModo.Create;

    private TiposLineaProduccionModel _model = new();
    private bool _esNuevo, _saving;
    private bool _readonly => Modo == CrudModo.Read || Modo == CrudModo.Delete;

    protected override void OnInitialized()
    {
        _esNuevo = Modo == CrudModo.Create;
        if (Item is not null) MapearDesdeModelo(Item);
    }

    /// <summary>Copia los campos editables del modelo (Item de la grilla, o la respuesta
    /// fresca de SHOWBYID) hacia _model.</summary>
    private void MapearDesdeModelo(TiposLineaProduccionModel m)
    {
        _model.COD_TIPO_LINEA_PRODUCCION = m.COD_TIPO_LINEA_PRODUCCION;
        _model.DES_TIPO_LINEA_PRODUCCION = m.DES_TIPO_LINEA_PRODUCCION;
        _model.FLG_PRODUCCION = m.FLG_PRODUCCION;
        _model.FLG_PLANTA_PROPIA = m.FLG_PLANTA_PROPIA;
        _model.IMG_PICTURE = m.IMG_PICTURE;
    }

    /// <summary>Trae el registro fresco desde SHOWBYID — se usa al abrir el diálogo
    /// (Modificar/Eliminar/Ver, nunca Crear) para no mostrar datos desactualizados de la grilla.</summary>
    private async Task RecargarDesdeShowbyidAsync()
    {
        var fresco = await Http.SafeGetAsync<TiposLineaProduccionModel>($"{TiposLineaProduccionRoute.TiposLineaProduccion}/{Uri.EscapeDataString(_model.COD_TIPO_LINEA_PRODUCCION)}");
        if (fresco is not null) MapearDesdeModelo(fresco);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!_esNuevo && Item is not null) await RecargarDesdeShowbyidAsync();
    }
    private async Task Submit()
    {
        _saving = true;
        var ruta = TiposLineaProduccionRoute.TiposLineaProduccion;
        if (Modo == CrudModo.Delete)
        {
            var rd = await Http.DeleteAsync($"{ruta}/{Uri.EscapeDataString(_model.COD_TIPO_LINEA_PRODUCCION)}");
            _saving = false;
            if (rd.IsSuccessStatusCode) { Snackbar.Add("Eliminado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
            else await ErrorDialogHelper.MostrarAsync(rd, ErrorLog, DialogService, nameof(TiposLineaProduccionDialog), nameof(Submit), "No se pudo eliminar el registro");
            return;
        }
        var dto = new { _model.COD_TIPO_LINEA_PRODUCCION, _model.DES_TIPO_LINEA_PRODUCCION,
                        _model.FLG_PRODUCCION, _model.FLG_PLANTA_PROPIA, _model.IMG_PICTURE };
        var resp = await Http.GuardarAsync(ruta, dto, _esNuevo);
        _saving = false;
        if (resp.IsSuccessStatusCode) { Snackbar.Add(_esNuevo ? "Creado." : "Modificado.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
        else await ErrorDialogHelper.MostrarAsync(resp, ErrorLog, DialogService, nameof(TiposLineaProduccionDialog), nameof(Submit));
    }
}
