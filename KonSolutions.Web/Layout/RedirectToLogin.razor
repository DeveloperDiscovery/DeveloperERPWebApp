@inject NavigationManager Navigation

@code {
    // Redirige al login en OnInitialized (no durante el render),
    // evitando el NullReferenceException de navegar mientras se dibuja.
    protected override void OnInitialized()
    {
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        var target = string.IsNullOrWhiteSpace(returnUrl) || returnUrl.StartsWith("login")
            ? "login"
            : $"login?returnUrl={Uri.EscapeDataString(returnUrl)}";
        Navigation.NavigateTo(target, forceLoad: false);
    }
}
