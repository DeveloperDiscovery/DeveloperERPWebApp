            await ErrorLog.LogAsync(ex, "MainLayout", nameof(CargarFotoUsuario));
        }
    }

    private async Task CargarFavoritos()
    {
        if (string.IsNullOrWhiteSpace(_codUsuario)) { _favoritos = new(); return; }
        try
        {
            var apps = _opciones.Select(o => o.COD_APLICACION).Distinct().ToList();
            // Todas las apps en paralelo en lugar de secuencial (N+1 → 1 ronda)
            var tareas = apps.Select(app => FavoritoService.GetAsync(_codUsuario, app.ToString())).ToList();
            var resultados = await Task.WhenAll(tareas);
            var favs = new List<OpcionMenu>();
            foreach (var lista in resultados)
            {
                foreach (var f in lista)
                {
                    var op = _opciones.FirstOrDefault(o =>
                        o.COD_APLICACION.ToString() == f.COD_APLICACION &&
                        o.COD_OPCION_APLICACION.ToString() == f.COD_OPCION_APLICACION);
                    if (op is not null) favs.Add(op);
                }
            }
            _favoritos = favs
                .DistinctBy(o => o.COD_OPCION_APLICACION)
                .ToList();

            // Deja el set de favoritos disponible para las pantallas de menú (circular/tiles)
            // que se abren automáticamente al login — así no vuelven a pedirlos por su cuenta.
            FavoritosCache.Establecer(_favoritos.Select(o => (o.COD_APLICACION.ToString(), o.COD_OPCION_APLICACION.ToString())));
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, "MainLayout", nameof(CargarFavoritos));
        }
    }

    private bool EsFavorito(OpcionMenu op) =>
        _favoritos.Any(f => f.COD_APLICACION == op.COD_APLICACION && f.COD_OPCION_APLICACION == op.COD_OPCION_APLICACION);

    private void MostrarMenuOpcion(MouseEventArgs e, OpcionMenu op)
    {
        Console.WriteLine($"[TRACE] {DateTime.Now:HH:mm:ss.fff} — MostrarMenuOpcion: {op.DES_OPCION_APLICACION} (antes _ctxOpen={_ctxOpen})");
        _ctxOpcion = op; _ctxEsFavorito = EsFavorito(op);
        (_ctxX, _ctxY) = CoordenadasMenuContextual(e);
        _ctxOpen = true;
    }

    /// <summary>
    /// Este menú contextual usa position:fixed dentro de #app, que tiene transform:scale()
    /// aplicado por el zoom propio de la app. Un ancestro con transform se vuelve el
    /// "containing block" de sus descendientes fixed (spec CSS), así que las coordenadas
    /// de e.ClientX/Y (reales del viewport) hay que dividirlas entre el factor de zoom
    /// para que el div quede alineado bajo el cursor en cualquier nivel de zoom.
    /// </summary>
    private (double x, double y) CoordenadasMenuContextual(MouseEventArgs e)
    {
        var scale = _zoomPct / 100.0;
        return scale > 0 ? (e.ClientX / scale, e.ClientY / scale) : (e.ClientX, e.ClientY);
    }

    // ── Árbol jerárquico del menú (MDL/CRP/BTN/SPR) ──
    // Cache en memoria del estado expandido para reaccionar sin esperar la
    // llamada async de MenuEstadoService en cada render; se sincroniza al togglear.
    private readonly HashSet<string> _carpetasExpandidas = new();

    // ── Búsqueda del menú lateral ──
    private string _busquedaMenu = "";

    /// <summary>Poda el árbol dejando solo ramas donde el nodo o algún descendiente coincide con la búsqueda.</summary>
    private List<NodoMenu> _arbolMenuFiltrado
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_busquedaMenu)) return _arbolMenu;
            return FiltrarNodos(_arbolMenu, _busquedaMenu);
        }
    }

    private static List<NodoMenu> FiltrarNodos(List<NodoMenu> nodos, string busqueda)
    {
        var resultado = new List<NodoMenu>();
        foreach (var n in nodos)
        {
            var hijosFiltrados = FiltrarNodos(n.Hijos, busqueda);
            var coincide = (n.DES_OPCION_APLICACION ?? "").Contains(busqueda, StringComparison.OrdinalIgnoreCase);
            if (coincide || hijosFiltrados.Count > 0)
            {
                resultado.Add(new NodoMenu
                {
                    COD_OPCION_APLICACION      = n.COD_OPCION_APLICACION,
                    COD_APLICACION             = n.COD_APLICACION,
                    DES_APLICACION             = n.DES_APLICACION,
                    DES_OPCION_APLICACION      = n.DES_OPCION_APLICACION,
                    DES_FORMULARIO             = n.DES_FORMULARIO,
                    COD_TIPO_OPCION_APLICACION = n.COD_TIPO_OPCION_APLICACION,
                    DES_BACKCOLOR_APLICACION   = n.DES_BACKCOLOR_APLICACION,
                    DES_FORECOLOR_APLICACION   = n.DES_FORECOLOR_APLICACION,
                    IMG_ICONO_APLICACION       = n.IMG_ICONO_APLICACION,
                    DES_BACKCOLOR_OPCION       = n.DES_BACKCOLOR_OPCION,
                    DES_FORECOLOR_OPCION       = n.DES_FORECOLOR_OPCION,
                    IMG_ICONO_OPCION           = n.IMG_ICONO_OPCION,
                    Hijos                      = coincide ? n.Hijos : hijosFiltrados
                });
            }
        }
        return resultado;
    }

    /// <summary>Todas las carpetas del árbol filtrado, para que se muestren expandidas mientras se busca.</summary>
    private HashSet<string> _carpetasExpandidasFiltro
    {
        get
        {
            var set = new HashSet<string>();
            void Visitar(IEnumerable<NodoMenu> nodos)
            {
                foreach (var n in nodos)
                {
                    if (n.EsCarpeta) set.Add(n.COD_OPCION_APLICACION);
                    Visitar(n.Hijos);
                }
            }
            Visitar(_arbolMenuFiltrado);
            return set;
        }
    }

    // RenderNodo se reemplazó por un componente recursivo separado (NodoMenuItem.razor),
    // ya que mezclar HTML directo dentro de un RenderFragment construido a mano en C#
    // no es sintaxis Razor válida en archivos .razor.

    private async Task CargarEstadoCarpetasAsync()
    {
        try
        {
            // Recorre el árbol completo y consulta el estado persistido de cada carpeta.
            async Task Visitar(IEnumerable<NodoMenu> nodos)
            {
                foreach (var n in nodos)
                {
                    if (n.EsCarpeta && await MenuEstado.EstaExpandidaAsync(n.COD_OPCION_APLICACION))
                        _carpetasExpandidas.Add(n.COD_OPCION_APLICACION);
                    await Visitar(n.Hijos);
                }
            }
            await Visitar(_arbolMenu);
        }
        catch (Exception ex)
        {
            await ErrorLog.LogAsync(ex, "MainLayout", nameof(CargarEstadoCarpetasAsync));
        }
    }

    private async Task ToggleCarpeta(string codOpcionAplicacion)
    {
        var expandida = !_carpetasExpandidas.Remove(codOpcionAplicacion);
        if (expandida) _carpetasExpandidas.Add(codOpcionAplicacion);
        Console.WriteLine($"[TRACE] {DateTime.Now:HH:mm:ss.fff} — MENU LATERAL - ToggleCarpeta: {codOpcionAplicacion} → {(expandida ? "EXPANDIDA" : "COLAPSADA")}");
        await MenuEstado.ToggleAsync(codOpcionAplicacion);
        StateHasChanged();
    }

    private void MostrarMenuFavorito(MouseEventArgs e, OpcionMenu op)
    {
        _ctxOpcion = op; _ctxEsFavorito = true;
        (_ctxX, _ctxY) = CoordenadasMenuContextual(e);
        _ctxOpen = true;
    }

    private async Task AgregarFavorito()
    {
        _ctxOpen = false;
        if (_ctxOpcion is null || string.IsNullOrWhiteSpace(_codUsuario)) return;
        await ErrorLog.TraceAsync($"FAVORITOS - Agregar: [{_ctxOpcion.COD_APLICACION}] {_ctxOpcion.DES_OPCION_APLICACION} (usuario={_codUsuario})");
        var ok = await FavoritoService.AgregarAsync(_codUsuario,
            _ctxOpcion.COD_APLICACION.ToString(), _ctxOpcion.COD_OPCION_APLICACION.ToString());
        if (ok)
        {
            // Ya sabemos exactamente qué opción se agregó — actualizar en memoria evita
            // recargar TODAS las apps del menú (antes: N llamadas HTTP en paralelo, una por
            // cada aplicación, solo para reflejar el cambio de una fila).
            if (!_favoritos.Any(o => o.COD_OPCION_APLICACION == _ctxOpcion.COD_OPCION_APLICACION))
                _favoritos.Add(_ctxOpcion);
            FavoritosCache.Establecer(_favoritos.Select(o => (o.COD_APLICACION.ToString(), o.COD_OPCION_APLICACION.ToString())));
            Snackbar.Add("Agregado a favoritos.", Severity.Success);
        }
        else Snackbar.Add("No se pudo agregar a favoritos.", Severity.Error);
    }

    private async Task QuitarFavorito()
    {
        _ctxOpen = false;
        if (_ctxOpcion is null || string.IsNullOrWhiteSpace(_codUsuario)) return;
        await ErrorLog.TraceAsync($"FAVORITOS - Quitar: [{_ctxOpcion.COD_APLICACION}] {_ctxOpcion.DES_OPCION_APLICACION} (usuario={_codUsuario})");
        var ok = await FavoritoService.QuitarAsync(_codUsuario,
            _ctxOpcion.COD_APLICACION.ToString(), _ctxOpcion.COD_OPCION_APLICACION.ToString());
        if (ok)
        {
            _favoritos.RemoveAll(o => o.COD_OPCION_APLICACION == _ctxOpcion.COD_OPCION_APLICACION);
            FavoritosCache.Establecer(_favoritos.Select(o => (o.COD_APLICACION.ToString(), o.COD_OPCION_APLICACION.ToString())));
            Snackbar.Add("Quitado de favoritos.", Severity.Success);
        }
        else Snackbar.Add("No se pudo quitar de favoritos.", Severity.Error);
    }
}
