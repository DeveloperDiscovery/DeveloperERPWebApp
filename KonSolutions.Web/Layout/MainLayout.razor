    private KONSolutions.Shared.Models.Estandar.ConfiguracionUsuario? _miConfigUsuario;
    private List<KONSolutions.Shared.Models.Estandar.TipoMenuOpciones> _tiposMenu = new();
    private bool _esZurdo => ConfigSvc.Current.EsZurdo;

    private async Task CargarConfiguracionUsuarioAsync()
    {
        try
        {
            var tCfg   = CfgUsuarioSvc.GetMiConfiguracionAsync();
            var tTipos = TiposMenuSvc.GetAllAsync();
            await Task.WhenAll(tCfg, tTipos);
            _miConfigUsuario = tCfg.Result;
            _tiposMenu       = tTipos.Result;

            await ConfigSvc.AplicarUsuarioAsync(_miConfigUsuario);
            if (ConfigSvc.Current.ZoomWebUsuario is > 0)
                _zoomPct = ConfigSvc.Current.ZoomWebUsuario!.Value;

            // Aplica el estilo de menú (lateral/circular/tiles) guardado por el usuario
            var estiloGuardado = EstiloDesdeCod(_miConfigUsuario?.COD_TIPO_MENU_OPCIONES);
            if (estiloGuardado is not null)
                _estiloMenu = estiloGuardado.Value;

            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    /// <summary>Persiste el zoom actual como preferencia del usuario, sin tocar sus otros campos.</summary>
    private async Task GuardarZoomUsuarioAsync()
    {
        try
        {
            var cfg = _miConfigUsuario ?? new KONSolutions.Shared.Models.Estandar.ConfiguracionUsuario { COD_USUARIO = _codUsuario };
            cfg.TAS_ZOOM_WEB = _zoomPct;
            _miConfigUsuario = cfg;
            await CfgUsuarioSvc.SaveAsync(cfg);
        }
        catch { }
    }

    /// <summary>Persiste el estilo de menú elegido como preferencia del usuario, para que se
    /// vuelva a aplicar automáticamente la próxima vez que inicie sesión.</summary>
    private async Task GuardarEstiloMenuUsuarioAsync(EstiloMenu estilo)
    {
        try
        {
            var tipo = TipoMenuPorEstilo(estilo);
            if (tipo is null) return; // sin catálogo configurado para este estilo, no hay nada que guardar
            var cfg = _miConfigUsuario ?? new KONSolutions.Shared.Models.Estandar.ConfiguracionUsuario { COD_USUARIO = _codUsuario };
            cfg.COD_TIPO_MENU_OPCIONES = tipo.COD_TIPO_MENU_OPCIONES;
            _miConfigUsuario = cfg;
            await CfgUsuarioSvc.SaveAsync(cfg);
        }
        catch { }
    }

    /// <summary>Deduce el EstiloMenu (Lateral/Circular/Tiles) a partir de la descripción del
    /// tipo de menú en el catálogo ESTANDAR.TIPOS_MENU_OPCIONES, por palabra clave.</summary>
    private static EstiloMenu? EstiloDesdeDescripcion(string? des)
    {
        var n = (des ?? "").ToUpperInvariant();
        if (n.Contains("CIRCULAR")) return EstiloMenu.Circular;
        if (n.Contains("TILE"))     return EstiloMenu.Tiles;
        if (n.Contains("LATERAL"))  return EstiloMenu.Lateral;
        return null;
    }

    private EstiloMenu? EstiloDesdeCod(string? cod)
    {
        if (string.IsNullOrWhiteSpace(cod)) return null;
        var t = _tiposMenu.FirstOrDefault(x => x.COD_TIPO_MENU_OPCIONES == cod);
        return EstiloDesdeDescripcion(t?.DES_TIPO_MENU_OPCIONES);
    }

    private KONSolutions.Shared.Models.Estandar.TipoMenuOpciones? TipoMenuPorEstilo(EstiloMenu e)
        => _tiposMenu.FirstOrDefault(t => EstiloDesdeDescripcion(t.DES_TIPO_MENU_OPCIONES) == e);

    /// <summary>Ícono base64 del catálogo para este estilo de menú, si existe (para mostrarlo
    /// en el selector de estilo del menú de usuario, en vez del ícono fijo de Material).</summary>
    private string? IconoBase64PorEstilo(EstiloMenu e)
    {
        var t = TipoMenuPorEstilo(e);
        return t?.IMG_ICONO is { Length: > 0 } bytes ? Convert.ToBase64String(bytes) : null;
    }

    private async Task CargarConfiguracionGeneralAsync()
    {
        try
        {
            var cfg = await CfgGeneralSvc.GetCurrentAsync();
            if (cfg is null) return;
            if (!string.IsNullOrWhiteSpace(cfg.DES_NOMBRE_EMPRESA))
                _nombreEmpresa = cfg.DES_NOMBRE_EMPRESA;
            if (!string.IsNullOrWhiteSpace(cfg.DES_NOMBRE_APLICACION))
            {
                _nombreApp = cfg.DES_NOMBRE_APLICACION;
            }
            if (cfg.IMG_LOGO_EMPRESA is { Length: > 0 })
                _logoEmpresa = Convert.ToBase64String(cfg.IMG_LOGO_EMPRESA);
            if (cfg.IMG_LOGO_APLICACION is { Length: > 0 })
            {
                _logoApp = Convert.ToBase64String(cfg.IMG_LOGO_APLICACION);
                try { await JS.InvokeVoidAsync("cursorBusy.setIcono", _logoApp); } catch { }
            }

            // Aplica TODA la Configuración General (colores de grilla, foco, fuentes, etc.)
            // al AppConfig y la persiste — antes esto solo pasaba si el usuario entraba
            // manualmente a la pantalla "Configuración General" y grababa; con localStorage
            // recién limpiado (o un navegador/equipo nuevo) la app arrancaba con los
            // valores por defecto hasta esa visita manual. Ahora se aplica ya al arrancar.
            ConfigService.MapearDesdeConfiguracionGeneral(cfg, ConfigSvc.Current);
            await ConfigSvc.SaveAsync(ConfigSvc.Current);

            // Actualizar el splash con los datos reales de la BD mientras sigue cargando
            await InvokeAsync(StateHasChanged);

            // Aplicar colores de la BD al MudTheme para que afecten a todos los
            // componentes MudBlazor (botones, selects, chips, etc.)
            var primary      = string.IsNullOrWhiteSpace(cfg.DES_COLOR_PRIMARY)             ? "#b8472d"  : cfg.DES_COLOR_PRIMARY.Trim();
            var secondary    = string.IsNullOrWhiteSpace(cfg.DES_COLOR_SECONDARY)           ? "#4a4a32"  : cfg.DES_COLOR_SECONDARY.Trim();
            var backColor    = string.IsNullOrWhiteSpace(cfg.DES_BACKCOLOR)                 ? "#efe9df"  : cfg.DES_BACKCOLOR.Trim();
            var font         = string.IsNullOrWhiteSpace(cfg.DES_TYPOGRAPHY_CONTROLS_FONT)  ? "Archivo"  : cfg.DES_TYPOGRAPHY_CONTROLS_FONT.Trim();
            _envBack = string.IsNullOrWhiteSpace(cfg.DES_BACKCOLOR_ENVIRONMENT)      ? "#1a1714" : cfg.DES_BACKCOLOR_ENVIRONMENT.Trim();
            _envFore = string.IsNullOrWhiteSpace(cfg.DES_FORECOLOR_ENVIRONMENT)      ? "#ffffff" : cfg.DES_FORECOLOR_ENVIRONMENT.Trim();
            _envFont = string.IsNullOrWhiteSpace(cfg.DES_TYPOGRAPHY_ENVIRONMENT_FONT)? font      : cfg.DES_TYPOGRAPHY_ENVIRONMENT_FONT.Trim();
            var envBack = _envBack;
            var envFore = _envFore;
            var envFont = _envFont;
            // Sincronizar --paper con el color de fondo real de la BD
            // para que los labels outlined siempre tapen el borde con el color correcto
            try { await JS.InvokeVoidAsync("eval", $"document.documentElement.style.setProperty('--paper','{backColor}')"); } catch { }

            _theme = new MudTheme
            {
                PaletteLight = new PaletteLight
                {
                    Primary           = primary,
                    Secondary         = secondary,
                    Background        = backColor,
                    Surface           = "#ffffff",
                    AppbarBackground  = envBack,
                    AppbarText        = envFore,
                    DrawerBackground  = envBack,
                    DrawerText        = envFore,
                    DrawerIcon        = envFore,
                },
                Typography = new Typography
                {
                    Default = new Default { FontFamily = new[] { font,    "sans-serif" } },
                    H6      = new H6      { FontFamily = new[] { envFont, "sans-serif" } },
                    Body1   = new Body1   { FontFamily = new[] { font,    "sans-serif" } },
                    Body2   = new Body2   { FontFamily = new[] { font,    "sans-serif" } },
                }
            };
            if (!string.IsNullOrWhiteSpace(cfg.DES_CULTURE))
            {
                try
                {
                    var stored = await LocalStorage.GetItemAsStringAsync("app-culture");
                    if (stored != cfg.DES_CULTURE)
                    {
                        // Guardar y recargar para que Program.cs aplique el culture antes del primer render
                        await LocalStorage.SetItemAsStringAsync("app-culture", cfg.DES_CULTURE);
                        await JS.InvokeVoidAsync("location.reload");
                        return;
                    }
                    // Ya está aplicado desde Program.cs; refuerzo en memoria por si acaso,
                    // fijando también CurrentCulture del hilo actual (no solo el default
                    // para hilos nuevos), igual que en Program.cs.
                    KONSolutions.Web.Services.CultureHelper.Aplicar(cfg.DES_CULTURE);
                }
                catch { }
            }
        }
        catch { }
    }

    private async Task CargarFotoUsuario()
    {
