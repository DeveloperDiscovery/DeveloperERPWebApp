                         @ondblclick="@(() => AbrirZoomLogo(_logoEmpresa))" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Business"
                             Style="color:#b8472d;flex-shrink:0;font-size:4rem;" />
                }
                <span class="sidebar-logo-text">@(!string.IsNullOrEmpty(_nombreEmpresa) ? _nombreEmpresa : _nombreApp)</span>
                <MudTooltip Text="@(_apiActiva ? "API activa" : "API no disponible")" Placement="Placement.Right">
                    <span style="width:9px;height:9px;border-radius:50%;flex-shrink:0;
                                 background:@(_apiActiva ? "#48bb78" : "#fc8181");
                                 box-shadow:0 0 5px @(_apiActiva ? "#48bb78" : "#fc8181");
                                 display:inline-block;margin-left:2px;" />
                </MudTooltip>
            </div>

            @* Contenido scrollable *@
            <div class="sidebar-scroll">

                @* Favoritos — ocultos del sidebar, se gestionan desde el Workspace *@

                @* Búsqueda — solo tiene sentido con el sidebar fijado (expandido) *@
                @if (_pinned)
                {
                    <div style="padding:4px 10px 8px;">
                        <MudTextField T="string" Value="_busquedaMenu" ValueChanged="@((string v) => _busquedaMenu = v)"
                                      Placeholder="Buscar... (Ctrl+K)" Variant="Variant.Text" Margin="Margin.Dense"
                                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                      Immediate="true" Clearable="true" OnClearButtonClick="@(() => _busquedaMenu = "")"
                                      UserAttributes="@(new Dictionary<string,object> { ["id"] = "sidebar-search-input" })"
                                      Style="background:rgba(255,255,255,.06);border-radius:4px;color:var(--env-fore,#fff);" />
                    </div>
                }

                @* Opciones dinámicas de la BD agrupadas por aplicación.
                   Cada grupo lleva un encabezado con el nombre e ícono de la app. *@
                @foreach (var grupo in _arbolMenuFiltrado.GroupBy(n => n.COD_APLICACION))
                {
                    var primerNodo = grupo.First();
                    var codApp    = grupo.Key;
                    var desApp    = (primerNodo.DES_APLICACION ?? codApp).ToUpperInvariant();
                    var appColaps = string.IsNullOrWhiteSpace(_busquedaMenu) && _appsColapsadas.Contains(codApp);
                    <div class="sidebar-section @(appColaps ? "colapsada" : "")"
                         style="display:flex;align-items:center;gap:6px;"
                         @onclick="@(() => ToggleApp(codApp))"
                         @oncontextmenu="@(() => { })" @oncontextmenu:preventDefault="true">
                        <MudIcon Icon="@IconoAplicacion(desApp)"
                                 Style="font-size:.95rem;opacity:.75;flex-shrink:0;" />
                        <span class="item-text" style="flex:1;">@desApp</span>
                        <span class="item-text section-chevron">▼</span>
                    </div>
                    @if (!appColaps)
                    {
                        @foreach (var nodo in grupo)
                        {
                            <NodoMenuItem Nodo="nodo" Expandido="_pinned"
                                          CarpetasExpandidas="@(string.IsNullOrWhiteSpace(_busquedaMenu) ? _carpetasExpandidas : _carpetasExpandidasFiltro)"
                                          OnAbrirOpcion="AbrirTabOpcion"
                                          OnMenuContextual="@(t => MostrarMenuOpcion(t.Item1, t.Item2))"
                                          OnToggleCarpeta="ToggleCarpeta" />
                        }
                    }
                }

                @* Menú estático de desarrollo — solo si ya terminó de cargar el menú
                   dinámico y resultó vacío (sin permisos reales), no durante la carga inicial *@
                @if (_menuCargado && !_opciones.Any())
                {
                    @* SEGURIDAD *@
                    <div class="@_classSeg" @onclick="ToggleSeccionSeg">
                        <span>SEGURIDAD</span>
                        <span class="section-chevron">▼</span>
                    </div>
                    @if (!_seccionesColapsadas.Contains("SEG"))
                    {
                        @SidebarGrupo("Usuarios",              Icons.Material.Filled.People,              "/seguridad/usuarios")
                        @SidebarGrupo("Perfiles",              Icons.Material.Filled.Badge,               "/seguridad/perfiles")
                        @SidebarGrupo("Roles",                 Icons.Material.Filled.AdminPanelSettings,  "/seguridad/roles")
                        @SidebarGrupo("Aplicaciones",          Icons.Material.Filled.Apps,                "/seguridad/aplicaciones")
                        @SidebarGrupo("Opciones Aplicaciones", Icons.Material.Filled.AccountTree,         "/seguridad/opciones-aplicaciones")
                        @SidebarGrupo("Opciones Menú",         Icons.Material.Filled.Interests,           "/seguridad/opciones-menu")
                        @SidebarGrupo("Complejidad contraseña",Icons.Material.Filled.Password,            "/seguridad/complejidad-password")
                        @SidebarGrupo("Botones Estándar",      Icons.Material.Filled.SmartButton,         "/seguridad/botones-estandar")
                        @SidebarGrupo("Asignación de Roles",   Icons.Material.Filled.GroupAdd,            "/seguridad/asignacion-roles")
                    }

                    @* ESTÁNDAR *@
                    <div class="@_classEst" @onclick="ToggleSeccionEst">
                        <span>ESTÁNDAR</span>
                        <span class="section-chevron">▼</span>
                    </div>
                    @if (!_seccionesColapsadas.Contains("EST"))
                    {
                        @SidebarGrupo("Tipos de Estados", Icons.Material.Filled.Label,    "/estandar/tipos-estados")
                        @SidebarGrupo("Estados Estándar", Icons.Material.Filled.Style,    "/estandar/estados-estandar")
                        @SidebarGrupo("Tipos de Motivos", Icons.Material.Filled.Category, "/estandar/tipos-motivos")
                    }

                    @* SISTEMA *@
                    <div class="@_classSis" @onclick="ToggleSeccionSis">
                        <span>SISTEMA</span>
                        <span class="section-chevron">▼</span>
                    </div>
                    @if (!_seccionesColapsadas.Contains("SIS"))
                    {
                        @SidebarGrupo("Visor de Logs",  Icons.Material.Filled.BugReport, "/developer/logviewer")
                        @SidebarGrupo("Configuración",  Icons.Material.Filled.Settings,  "/seguridad/configuracion")
                    }
                }

            </div>

            <div id="sidebarResizeHandle" class="sidebar-resize-handle"></div>
        </div>

        @* ── Contenido principal ── *@
        <div class="main-content @(_estiloMenu == EstiloMenu.Circular ? "circular" : _estiloMenu == EstiloMenu.Tiles ? "tiles" : _pinned ? "expanded" : "") @(_esZurdo ? "zurdo" : "")">

            @* AppBar — derecha: logo aplicación; izquierda en modo circular/tiles: empresa *@
            <div class="app-bar">
                @if (_estiloMenu != EstiloMenu.Lateral)
                {
                    @if (!string.IsNullOrEmpty(_logoEmpresa))
                    {
                        <img src="data:image/png;base64,@_logoEmpresa"
                             style="width:28px;height:28px;object-fit:contain;border-radius:4px;flex-shrink:0;background:#fff;padding:2px;cursor:zoom-in;"
                             @ondblclick="@(() => AbrirZoomLogo(_logoEmpresa))" />
                    }
                    <span style="font-family:'Archivo',sans-serif;font-weight:800;letter-spacing:.08em;font-size:clamp(.6rem,1.8vw,1.1rem);color:var(--env-fore,#fff);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1;min-width:0;">
                        @(!string.IsNullOrEmpty(_nombreEmpresa) ? _nombreEmpresa : _nombreApp)
                    </span>
                }
                <MudSpacer />

                @* ── Notificaciones pendientes: un ícono por COD_TIPO_NOTIFICACION con badge de conteo ──
                   Respeta la Configuración de Usuario "Notificaciones activas" (FLG_NOTIFICACION_ACTIVA). ── *@
                @if (ConfigSvc.Current.NotificacionesActivas && _notifResumen.Count > 0)
                {
                    <div class="d-flex align-center gap-1"
                         style="@($"--notif-foco-back:{ConfigSvc.Current.FocoFondo};--notif-foco-fore:{ConfigSvc.Current.FocoTexto};")">
                        @foreach (var tipo in _notifResumen)
                        {
                            <div class="notif-icon-item" title="@tipo.DES_TIPO_NOTIFICACION"
                                 @onclick="@(() => ToggleNotifPanel(tipo.COD_TIPO_NOTIFICACION))">
                                @if (IconoBase64(tipo.IMG_ICONO) is { } src)
                                {
                                    <img src="@src" style="width:54px;height:54px;object-fit:contain;" alt="@tipo.DES_TIPO_NOTIFICACION" />
                                }
                                else
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Notifications" Style="font-size:54px;" />
                                }
                                <span class="notif-badge">@tipo.NUM_NOTIFICACIONES</span>

                                @* El panel es hijo del ícono clickeado (no del grupo completo) para que
                                   se posicione siempre debajo de ESE ícono, sin importar cuántos haya. *@
                                @if (_notifTipoAbierto == tipo.COD_TIPO_NOTIFICACION)
                                {
                                    <MudPaper Elevation="6" Class="notif-panel" @onclick:stopPropagation="true"
                                              Style="background:var(--env-back,#1a1714);border:1px solid rgba(255,255,255,.12);">
                                        <div class="notif-panel-head">
                                            <span>@tipo.DES_TIPO_NOTIFICACION</span>
                                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                                           Style="color:inherit;" OnClick="@(() => _notifTipoAbierto = null)" />
                                        </div>
                                        <div class="notif-panel-list">
                                            @foreach (var n in _notifDetalle.Where(n => n.COD_TIPO_NOTIFICACION == tipo.COD_TIPO_NOTIFICACION))
                                            {
                                                @* PROC_NOTIFICACIONES_APROBACIONES_SHOWBYID trae la ficha completa
                                                   (fecha, vencimiento, estado, cargo/área, historial) para CUALQUIER
                                                   notificación, no solo las de aprobación — para un mensaje simple el
                                                   historial trae una sola acción "LEIDO" en vez del flujo de firmas.
                                                   Por eso todas abren el mismo diálogo rico, sin distinguir por FLG_APROBACION. *@
                                                var fotoNotif = FotoSvc.ObtenerCacheada(n.COD_USUARIO_NOTIFICADOR);
                                                <div class="notif-panel-item"
                                                     style="cursor:pointer;display:flex;align-items:center;gap:8px;"
                                                     @onclick="@(() => AbrirNotificacionAprobacion(n.NUM_NOTIFICACION))">
                                                    <div class="notif-panel-item-avatar">
                                                        @if (fotoNotif is not null)
                                                        {
                                                            <img src="@($"data:image/png;base64,{fotoNotif}")" alt="" />
                                                        }
                                                        else
                                                        {
                                                            <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size:1.1rem;opacity:.4;" />
                                                        }
                                                    </div>
                                                    <div style="flex:1;min-width:0;">
                                                        <div class="notif-panel-item-titulo">@n.DES_NOTIFICACION</div>
                                                        <div class="notif-panel-item-detalle">@n.DES_INFORMACION</div>
                                                        @if (!string.IsNullOrWhiteSpace(n.DES_USUARIO))
                                                        {
                                                            <div class="notif-panel-item-usuario">@n.DES_USUARIO</div>
                                                        }
                                                    </div>
                                                    @if (n.DES_TIEMPO_RESTANTE is not null)
                                                    {
                                                        var colorTiempo = n.DES_TIEMPO_RESTANTE > 0 ? "#2e7d32" : n.DES_TIEMPO_RESTANTE == 0 ? "#1565c0" : "#c62828";
                                                        <div style="@($"flex-shrink:0;display:flex;align-items:center;gap:3px;font-size:.7rem;font-weight:600;white-space:nowrap;color:{colorTiempo};")">
                                                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Size="Size.Small" Style="@($"font-size:.9rem;color:{colorTiempo};")" />
                                                            @(n.DES_TIEMPO_RESTANTE >= 0
                                                                ? $"{n.DES_TIEMPO_RESTANTE}d"
                                                                : $"venció hace {Math.Abs(n.DES_TIEMPO_RESTANTE.Value)}d")
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </MudPaper>
                                }
                            </div>
                        }
                    </div>
                    <div style="width:1px;height:24px;background:rgba(255,255,255,.14);flex-shrink:0;"></div>
                    @if (_notifTipoAbierto is not null)
                    {
                        <div style="position:fixed;inset:0;z-index:1150;" @onclick="@(() => _notifTipoAbierto = null)"></div>
                    }
                }

                @if (!string.IsNullOrEmpty(_logoApp))
                {
                    <img src="data:image/png;base64,@_logoApp"
                         style="height:32px;object-fit:contain;border-radius:4px;flex-shrink:0;cursor:zoom-in;" alt="app"
                         @ondblclick="@(() => AbrirZoomLogo(_logoApp))" />
                }
            </div>

            @* Contenido — padding-bottom:40px reserva el espacio de la status-bar (position:fixed,
               fuera de este flex column); flex:1 lo hace variable, sin cálculos de píxeles ni JS. *@
            <div style="padding:24px 24px 40px;flex:1 1 auto;min-height:0;display:flex;flex-direction:column;overflow:hidden;">
                <WorkspaceTabHost>
                    @Body
                </WorkspaceTabHost>
            </div>
        </div>

        @* ── Barra de estado inferior (ancho completo, fuera del área de tabs) ── *@
        <div class="status-bar">

            @* Sección izquierda: foto + nombre + texto de rol (abre menú usuario) *@
            <div class="d-flex align-center gap-2" style="cursor:pointer;user-select:none;"
                 @onclick="ToggleUserMenu">
                @if (_fotoUsuario is not null)
                {
                    <MudAvatar Size="Size.Small" Style="flex-shrink:0;">
                        <MudImage Src="@($"data:image/png;base64,{_fotoUsuario}")" />
                    </MudAvatar>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.AccountCircle"
                             Style="color:var(--env-fore,#fff);opacity:.55;font-size:1.6rem;flex-shrink:0;" />
                }
                <div class="d-flex flex-column" style="line-height:1.15;overflow:hidden;min-width:0;">
                    <span style="font-size:.78rem;color:var(--env-fore,#fff);font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@_codUsuario</span>
                </div>
                <MudIcon Icon="@(_userMenuOpen ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)"
                         Style="color:var(--env-fore,#fff);opacity:.5;font-size:1rem;flex-shrink:0;" />
            </div>

            @* Reloj de cuenta regresiva hasta el bloqueo por inactividad — el texto lo escribe
               directamente inactividad.js (sin round-trips a Blazor cada segundo). *@
            <MudTooltip Text="Tiempo restante hasta el bloqueo automático por inactividad">
                <div id="reloj-inactividad" class="d-flex align-center gap-1" style="display:none;">
                    <MudIcon Icon="@Icons.Material.Filled.LockClock"
                             Style="color:var(--env-fore,#fff);opacity:.5;font-size:1rem;flex-shrink:0;" />
                    <span class="mono" style="font-size:.75rem;color:var(--env-fore,#fff);opacity:.6;min-width:38px;"></span>
                </div>
            </MudTooltip>

            @* Reloj de cuenta regresiva del token de sesión (JWT) — mismo patrón que el de
               inactividad: el texto lo escribe sesionToken.js directo, sin round-trip a Blazor
               cada segundo. El deadline (epoch ms) se envía una sola vez desde OnAfterRenderAsync. *@
            <MudTooltip Text="Tiempo restante de la sesión (token)">
                <div id="reloj-token" class="d-flex align-center gap-1" style="display:none;">
                    <MudIcon Icon="@Icons.Material.Filled.Timer"
                             Style="color:var(--env-fore,#fff);opacity:.5;font-size:1rem;flex-shrink:0;" />
                    <span class="mono" style="font-size:.75rem;color:var(--env-fore,#fff);opacity:.6;min-width:38px;"></span>
                </div>
            </MudTooltip>

            @* Separador vertical *@
            <div style="width:1px;height:24px;background:var(--env-fore,#fff);opacity:.25;flex-shrink:0;margin:0 4px;"></div>

            @* Sección derecha del usuario: ícono de rol + selector + pin *@
            <div class="d-flex align-center gap-1" style="flex-shrink:0;">
                <MudIcon Icon="@Icons.Material.Filled.ManageAccounts"
                         Style="color:var(--env-fore,#fff);opacity:.7;font-size:1.2rem;flex-shrink:0;" />
                @if (MenuService.TieneVariosRoles)
                {
                    <MudSelect T="string" Value="@MenuService.RolActivo" ValueChanged="OnCambiarRol"
                               Dense="true" Margin="Margin.Dense" Variant="Variant.Text"
                               Style="max-width:200px;"
                               Class="env-role-select"
                               PopoverClass="env-roles-popover">
                        @foreach (var rol in MenuService.Roles)
                        {
                            <MudSelectItem T="string" Value="@rol.COD_ROL_USUARIO">@(rol.DES_ROL_USUARIO ?? rol.COD_ROL_USUARIO)</MudSelectItem>
                        }
                    </MudSelect>
                }
                <MudIconButton Icon="@(_pinned ? Icons.Material.Filled.PushPin : Icons.Material.Outlined.PushPin)"
                               Style="@($"color:var(--env-fore,#fff);opacity:{(_pinned?"1":".45")};padding:4px;box-shadow:none !important;outline:none !important;")"
                               Size="Size.Small"
                               title="@(_pinned ? "Desfijar menú" : "Fijar menú")"
                               OnClick="TogglePin" />
            </div>

            @* ── Zoom control (estilo Chrome) — pegado a la derecha ── *@
            <div class="zoom-control">
                <span class="zoom-btn" title="Reducir zoom" @onclick="ZoomOut">−</span>
                <span class="zoom-pct" title="Restablecer zoom (100%)" @onclick="ZoomReset">@_zoomPct%</span>
                <span class="zoom-btn" title="Aumentar zoom" @onclick="ZoomIn">+</span>
            </div>
        </div>

        @* Menú contextual del usuario (abre hacia arriba desde el footer) *@
        @if (_userMenuOpen)
        {
            <div style="position:fixed;inset:0;z-index:1249;" @onclick="@(() => _userMenuOpen = false)"></div>
            <div style="position:fixed;left:16px;bottom:44px;z-index:1250;">
                <MudPaper Elevation="6" Class="py-1" Style="min-width:220px;background:var(--menu-back, var(--ink));border:1px solid rgba(255,255,255,.12);">
                    <MudListItem T="string" Style="color:var(--menu-fore, var(--paper));" OnClick="@(async () => { _userMenuOpen=false; await OpenCambiarPassword(); })">
                        <div class="d-flex align-center gap-2" style="text-align:left;">
                            <MudIcon Icon="@Icons.Material.Filled.Password" Size="Size.Small" Style="color:inherit;" />
                            <span>Cambiar contraseña</span>
                        </div>
                    </MudListItem>
                    <MudListItem T="string" Style="color:var(--menu-fore, var(--paper));" OnClick="@(async () => { _userMenuOpen=false; await BloquearPantalla(); })">
                        <div class="d-flex align-center gap-2" style="text-align:left;">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="color:inherit;" />
                            <span>Bloquear pantalla</span>
                        </div>
                    </MudListItem>
                    <MudDivider Style="border-color:rgba(255,255,255,.15);" />
                    <MudListItem T="string" Style="color:var(--menu-fore, var(--paper));" OnClick="@(() => { _userMenuOpen=false; AbrirTabPorRuta("/configuracion-usuario"); })">
                        <div class="d-flex align-center gap-2" style="text-align:left;">
                            <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Small" Style="color:inherit;" />
                            <span>Configuración de Usuarios</span>
                        </div>
                    </MudListItem>
                    <MudDivider Style="border-color:rgba(255,255,255,.15);" />
                    <MudListItem T="string" Style="color:var(--menu-fore, var(--paper));" OnClick="@(() => _estiloMenuSubmenuOpen = !_estiloMenuSubmenuOpen)">
                        <div class="d-flex align-center gap-2" style="text-align:left;">
                            <MudIcon Icon="@Icons.Material.Filled.Palette" Size="Size.Small" Style="color:inherit;" />
                            <span>Estilo de menú</span>
                            <MudSpacer />
                            <MudIcon Icon="@(_estiloMenuSubmenuOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" Style="color:inherit;opacity:.6;" />
                        </div>
                    </MudListItem>
                    @if (_estiloMenuSubmenuOpen)
                    {
                        <MudListItem T="string" Style="color:var(--menu-fore, var(--paper));padding-left:32px;" OnClick="@(() => CambiarEstiloMenu(EstiloMenu.Lateral))">
