@* ── Toasts de notificaciones nuevas, estilo Outlook de escritorio (esquina inferior
   derecha, apiladas) ── *@
@if (_toasts.Count > 0)
{
    <div class="toast-outlook-host">
        @foreach (var t in _toasts)
        {
            <div class="toast-outlook">
                <div class="toast-outlook-head">
                    @if (t.IMG_ICONO is { Length: > 0 })
                    {
                        <img src="@($"data:image/png;base64,{Convert.ToBase64String(t.IMG_ICONO)}")" class="toast-outlook-appicon" alt="" />
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Notifications" Style="font-size:1rem;opacity:.6;" />
                    }
                    <span style="flex:1;font-size:.74rem;font-weight:600;opacity:.7;">@(t.DES_TIPO_NOTIFICACION ?? "Notificación")</span>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => CerrarToast(t))" />
                </div>
                <div class="toast-outlook-body" @onclick="@(() => VerToast(t))">
                    <div class="toast-outlook-avatar-col">
                        <div class="toast-outlook-avatar">
                            @{
                                var fotoToast = FotoSvc.ObtenerCacheada(t.COD_USUARIO_NOTIFICADOR);
                            }
                            @* Siempre la FOTO del usuario notificador (el ícono del tipo ya
                               está en la cabecera del toast); mientras carga, silueta genérica. *@
                            @if (fotoToast is not null)
                            {
                                <img src="@($"data:image/png;base64,{fotoToast}")" alt="" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Person" Style="font-size:1.8rem;opacity:.4;" />
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(t.DES_USUARIO))
                        {
                            <div class="toast-outlook-usuario">@t.DES_USUARIO</div>
                        }
                    </div>
                    <div style="flex:1;min-width:0;">
                        <div class="toast-outlook-titulo">@t.DES_NOTIFICACION</div>
                        @if (!string.IsNullOrWhiteSpace(t.DES_INFORMACION))
                        {
                            <div class="toast-outlook-msg">@t.DES_INFORMACION</div>
                        }
                    </div>
                </div>
                <div class="toast-outlook-actions">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => CerrarToast(t))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" OnClick="@(() => VerToast(t))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => CerrarToast(t))" />
                </div>
            </div>
        }
    </div>
}

@code {
