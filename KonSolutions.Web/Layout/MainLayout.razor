    private void CambiarEstiloMenu(EstiloMenu nuevo)
    {
        _userMenuOpen = false;
        if (_estiloMenu == nuevo) return;
        _ = GuardarEstiloMenuUsuarioAsync(nuevo);

        // Cerrar el tab fijo del estilo anterior (si tenía uno)
        var rutaAnterior = RutaDeEstilo(_estiloMenu);
        if (rutaAnterior is not null)
        {
            var tabAnterior = TabService.Tabs.FirstOrDefault(t => t.Ruta == rutaAnterior);
            if (tabAnterior is not null) { tabAnterior.EsCerrable = true; TabService.Cerrar(tabAnterior.Id); }
        }

        _estiloMenu = nuevo;

        // Abrir el tab fijo del nuevo estilo (si aplica)
        var rutaNueva = RutaDeEstilo(_estiloMenu);
        if (rutaNueva is not null)
        {
            var info = WorkspaceRegistry.PorRuta(rutaNueva)!;
            TabService.Abrir(info.Titulo, info.Icono, info.ComponentType, info.Ruta, esCerrable: false, alInicio: true);
        }
    }

