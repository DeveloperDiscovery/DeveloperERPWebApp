    /// <summary>
    /// La ruta de una opción es directamente su DES_FORMULARIO (ya viene como ruta
    /// completa desde el SP, ej. "/seguridad/usuarios") — no requiere conversión.
    /// </summary>
    private string RutaDeOpcion(OpcionMenu op) => op.DES_FORMULARIO ?? "";

    private void AbrirTabPorRuta(string ruta)
    {
        var info = WorkspaceRegistry.PorRuta(ruta);
        if (info is null)
        {
            // ruta siempre viene con dato aquí (botones estáticos del sidebar) →
            // si no resuelve a ninguna pantalla, es un error de configuración, no "vacío".
            TabService.Abrir(ruta, Icons.Material.Filled.ErrorOutline,
                typeof(KONSolutions.Web.Pages.Shared.PaginaError), $"/error-pantalla{ruta}",
                new Dictionary<string, object> { ["Titulo"] = ruta, ["Ruta"] = ruta });
            return;
        }
        TabService.Abrir(info.Titulo, info.Icono, info.ComponentType, info.Ruta);
    }

    private async Task AbrirTabOpcion(OpcionMenu op)
    {
        if (op.FLG_EXIGE_PASSWORD == true)
        {
            var ok = await KONSolutions.Web.Services.AccesoOpcionHelper.ConfirmarAccesoAsync(DialogService, AuthService, ConfigSvc);
            if (!ok) return;
        }

        await ErrorLog.TraceAsync($"MENU LATERAL - AbrirOpcion: [{op.COD_APLICACION}] {op.DES_OPCION_APLICACION} → {op.DES_FORMULARIO}");
        var ruta = RutaDeOpcion(op);
        var info = WorkspaceRegistry.PorRuta(ruta);
        if (info is not null)
        {
            // Se pasan los códigos de aplicación/opción para que la pantalla pueda
            // resolver sus propios botones de acción dinámicos vía AccionesBotones.
            var parametros = new Dictionary<string, object>
            {
                ["CodAplicacion"] = op.COD_APLICACION,
                ["CodOpcionAplicacion"] = op.COD_OPCION_APLICACION
            };
            TabService.Abrir(info.Titulo, info.Icono, info.ComponentType, info.Ruta, parametros,
                iconoImagenBase64: op.IMG_ICONO_OPCION);
        }
        else
        {
            // Sin pantalla registrada para esa ruta. Antes se consultaba una metadata de
            // pantallas dinámicas que nunca se terminó de implementar; al retirarla, una
            // opción sin pantalla cae directamente en "en construcción", que es lo que
            // realmente está pasando.
            AbrirEnConstruccion(op);
        }
    }

    /// <summary>
    /// DES_FORMULARIO vacío → "Página en construcción" (opción sin pantalla asignada aún).
    /// DES_FORMULARIO con dato pero que no resuelve a ninguna pantalla registrada ni a
    /// metadata dinámica → "Página de error" (configuración inválida).
    /// </summary>
    private void AbrirEnConstruccion(OpcionMenu op)
    {
        var titulo = op.DES_OPCION_APLICACION ?? op.COD_OPCION_APLICACION ?? "";
        var ruta = RutaDeOpcion(op);
        if (string.IsNullOrWhiteSpace(ruta))
        {
            TabService.Abrir(titulo, Icons.Material.Filled.Construction,
                typeof(KONSolutions.Web.Pages.Shared.PaginaEnConstruccion),
                $"/en-construccion/{op.COD_APLICACION}/{op.COD_OPCION_APLICACION}",
                new Dictionary<string, object>
                {
                    ["Titulo"] = titulo,
                    ["CodAplicacion"] = op.COD_APLICACION ?? "",
                    ["CodOpcionAplicacion"] = op.COD_OPCION_APLICACION ?? ""
                });
        }
        else
        {
            TabService.Abrir(titulo, Icons.Material.Filled.ErrorOutline,
                typeof(KONSolutions.Web.Pages.Shared.PaginaError),
                $"/error-pantalla/{op.COD_APLICACION}/{op.COD_OPCION_APLICACION}",
                new Dictionary<string, object>
                {
                    ["Titulo"] = titulo,
                    ["Ruta"] = ruta,
                    ["CodAplicacion"] = op.COD_APLICACION ?? "",
                    ["CodOpcionAplicacion"] = op.COD_OPCION_APLICACION ?? ""
                });
        }
    }

