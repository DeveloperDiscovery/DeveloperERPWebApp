        _cargaPct = pct;
        StateHasChanged();
    }
    private static bool _startupLogoutDone = false;
    private bool _apiActiva = true;
    private System.Threading.Timer? _healthTimer;
    private System.Threading.Timer? _notifTimer;
    private List<NotificacionResumenTipo> _notifResumen = new();
    private List<NotificacionFlujoItem> _notifDetalle = new();
    private string? _notifTipoAbierto;
    // Notificaciones ya vistas (para detectar cuáles son NUEVAS entre un refresco y el
    // siguiente, y disparar el toast emergente solo para esas — nunca en la primera carga).
    private readonly HashSet<int> _notifVistas = new();
    private bool _notifPrimeraCarga = true;
    private List<OpcionMenu> _favoritos  = new();
    private string           _rol        = "";
    private string           _codUsuario = "";
    private string           _codPerfilUsuario = "";
    private bool             _ctxOpen;
    private bool             _userMenuOpen;
    private bool             _estiloMenuSubmenuOpen;

    private void ToggleUserMenu() { _userMenuOpen = !_userMenuOpen; StateHasChanged(); }

    /// <summary>Refresca el layout (posición del sidebar, etc.) cuando otra pestaña
    /// (p.ej. Configuración de Usuario) guarda cambios que aplican de inmediato.</summary>
    private void OnConfigChanged()
    {
        // Si el usuario acaba de activar "Notificaciones activas" (Configuración de Usuario)
        // y todavía no hay nada cargado, refresca de inmediato en vez de esperar el timer.
        if (ConfigSvc.Current.NotificacionesActivas && _notifResumen.Count == 0)
            _ = CargarNotificacionesAsync();
        _ = ActualizarTecladoVirtualAsync();
        InvokeAsync(StateHasChanged);
    }

    private bool   _mostrandoTransicion;
    private string _transicionMensaje = "Abriendo...";
    private void OnTransicionMostrar(string mensaje)
    {
        _transicionMensaje = mensaje;
        _mostrandoTransicion = true;
        InvokeAsync(StateHasChanged);
    }
    private void OnTransicionOcultar()
