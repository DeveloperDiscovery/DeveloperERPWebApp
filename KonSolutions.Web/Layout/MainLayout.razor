    private async Task OpenCambiarPassword()
    {
        try
        {
            var codUsuario = await GetCodUsuarioActualAsync();
            if (string.IsNullOrWhiteSpace(codUsuario)) { Snackbar.Add("No se pudo obtener la sesión del usuario.", Severity.Warning); return; }
            string? codComplejidad = null;
            var codPerfil = _codPerfilUsuario;
            if (string.IsNullOrWhiteSpace(codPerfil))
            {
