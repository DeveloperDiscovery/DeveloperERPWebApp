    protected override async Task OnInitializedAsync()
    {
        ConfigSvc.OnChange += OnConfigChanged;
        TransicionSvc.OnMostrar += OnTransicionMostrar;
        TransicionSvc.OnOcultar += OnTransicionOcultar;
        TabService.OnChange += OnTabsCambiaron;
        MenuService.IconosActualizados += OnIconosMenuActualizados;

        var sw = System.Diagnostics.Stopwatch.StartNew();
        string Ts() => $"{DateTime.Now:yyyy-MM-dd HH:mm:ss.fff} (+{sw.ElapsedMilliseconds}ms)";

        KONSolutions.Web.Services.JwtMessageHandler.SplashActivo = true;
        try
        {
            await ErrorLog.TraceAsync($"INICIO CARGA MENU — {DateTime.Now:yyyy-MM-dd HH:mm:ss.fff}");

            // Solo en la primera carga de la sesión de navegador: fuerza login.
            //
            // conservarCacheMenu: este logout corría ANTES de cada login y borraba la caché
            // del árbol de menú, así que el stale-while-revalidate de MenuService (pintar el
            // menú al instante desde localStorage y refrescar en segundo plano) nunca se
            // usaba en el login — todos pagaban la carga completa y bloqueante. Sigue
            // limpiándose en el logout real (botón "Cerrar sesión") y al cambiar de rol.
            if (!_startupLogoutDone)
            {
                _startupLogoutDone = true;
                await AuthService.LogoutAsync(conservarCacheMenu: true);
            }

            Etapa("Cargando configuración general...", 10);

            // Restaurar pin y config en paralelo (ambas son locales/rápidas)
            var pinTask = LocalStorage.GetItemAsync<bool>("sidebarPinned").AsTask();
            var cfgTask = ConfigSvc.LoadAsync();
            await Task.WhenAll(pinTask, cfgTask);
            try { _pinned = pinTask.Result; } catch { }
            await ConfigSvc.AplicarAsync();
            await ErrorLog.TraceAsync($"CARGA DE MENU - ConfigSvc.LoadAsync + AplicarAsync", Ts());
            Etapa("Verificando sesión...", 20);

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true) { _menuCargado = true; KONSolutions.Web.Services.JwtMessageHandler.SplashActivo = false; return; }
            await ErrorLog.TraceAsync($"CARGA DE MENU - GetAuthenticationStateAsync", Ts());

            var sesion = await AuthService.GetSesionAsync();
            if (sesion is null) { _menuCargado = true; KONSolutions.Web.Services.JwtMessageHandler.SplashActivo = false; return; }
            await ErrorLog.TraceAsync($"CARGA DE MENU - AuthService.GetSesionAsync", Ts());

            _rol              = sesion.DES_ROL_USUARIO ?? sesion.COD_ROL_USUARIO ?? "";
            _codUsuario       = sesion.COD_USUARIO ?? "";
            _codPerfilUsuario = sesion.COD_PERFIL_USUARIO ?? "";

            // Cargar logo/nombre ya disponibles para mostrarlos en el splash
            try
            {
                var cfg = ConfigSvc.Current;
                _nombreApp = string.IsNullOrWhiteSpace(cfg.NombreApp) ? "Cargando..." : cfg.NombreApp;
                _logoApp   = cfg.LogoApp;
            }
            catch { }
            StateHasChanged();

            // Menú + Foto + ConfiguracionGeneral + ConfiguracionUsuario — se lanzan todas en
            // paralelo (misma performance que antes), pero se van "esperando" en orden para
            // poder mostrar la etapa correspondiente en el splash mientras se resuelven.
            var tMenu           = MenuService.CargarAsync();
            var tFoto           = CargarFotoUsuario();
            var tCfgGeneral     = CargarConfiguracionGeneralAsync();
            var tCfgUsuario     = CargarConfiguracionUsuarioAsync();
            var tEtiquetas      = EtiquetasSvc.CargarAsync();

            Etapa("Cargando configuración general...", 35);
            await tCfgGeneral;
            Etapa("Cargando configuración de usuario...", 50);
            await tCfgUsuario;

            // tCfgGeneral y tCfgUsuario corren en PARALELO (arrancan antes de este punto);
            // aunque se esperen en este orden, el orden real en que cada una escribe
            // ConfigSvc.Current.FilasPorPaginaUnica depende de la latencia de red de cada
            // una, no del orden de estos "await" — sin esto, la Configuración General podía
            // terminar de escribir DESPUÉS que la de Usuario y pisar su preferencia. Se
            // reafirma acá, ya con ambas resueltas, para que la del usuario gane siempre.
            if (_miConfigUsuario?.NUM_ROWS_PAGE is > 0)
            {
                ConfigSvc.Current.FilasPorPaginaUnica = _miConfigUsuario.NUM_ROWS_PAGE.Value;
                ConfigSvc.Current.FilasPorPaginaPadre = _miConfigUsuario.NUM_ROWS_PAGE.Value;
                ConfigSvc.Current.FilasPorPaginaHijo  = _miConfigUsuario.NUM_ROWS_PAGE.Value;
            }

            Etapa("Cargando menú...", 65);
            await tMenu;
            await tFoto;
            await ErrorLog.TraceAsync($"CARGA DE MENU - MenuService.CargarAsync + CargarFotoUsuario (paralelo)", Ts());

            _opciones    = MenuService.GetOpciones();
            _arbolMenu   = MenuService.GetArbolMenu();

            Etapa("Cargando Diccionario de Etiquetas...", 75);
            await tEtiquetas;
            await ErrorLog.TraceAsync($"CARGA DE MENU - EtiquetasSvc.CargarAsync", Ts());

            Etapa("Cargando accesos y favoritos...", 85);
            // Estado carpetas + favoritos dependen del menú ya cargado
            await Task.WhenAll(
                CargarEstadoCarpetasAsync(),
                CargarFavoritos()
            );
            await ErrorLog.TraceAsync($"CARGA DE MENU - CargarEstadoCarpetasAsync + CargarFavoritos (paralelo)", Ts());

            Etapa("Listo", 100);
            _menuCargado = true;
            KONSolutions.Web.Services.JwtMessageHandler.SplashActivo = false;
            _revelandoPersiana = true;
            StateHasChanged();
            _ = OcultarPersianaAsync();

            // Límites se cargan en segundo plano sin bloquear la UI
            _ = SafeRun(() => Limites.CargarAsync());

            TabService.AbrirWorkspace("Workspace", Icons.Material.Filled.Dashboard,
                typeof(KONSolutions.Web.Pages.Workspace), "/");

            // Si el usuario tiene guardado un estilo de menú distinto al lateral (por
            // defecto), abre también su tab fijo — antes que Workspace, como los demás.
            if (_estiloMenu != EstiloMenu.Lateral)
            {
                var rutaEstiloGuardado = RutaDeEstilo(_estiloMenu);
                if (rutaEstiloGuardado is not null)
                {
                    var infoEstilo = WorkspaceRegistry.PorRuta(rutaEstiloGuardado)!;
                    TabService.Abrir(infoEstilo.Titulo, infoEstilo.Icono, infoEstilo.ComponentType, infoEstilo.Ruta,
                        esCerrable: false, alInicio: true);
                }
            }

            // Config: inactividad y refresco automático
            try
            {
                var cfg = ConfigSvc.Current;
                if (cfg.RefrescoAutomatico && cfg.ControlCambiosActivo)
                    Cambios.Iniciar(cfg.RefrescoIntervaloSegs);

                // El Diccionario de Etiquetas se cargó una sola vez arriba (tEtiquetas) — se
                // vuelve a cargar solo cuando ENTORNO.DICCIONARIO_ETIQUETAS cambia (editado por
                // este usuario u otro, incluso en otra pestaña), sin esperar a un nuevo login.
                Cambios.Suscribir("ENTORNO.DICCIONARIO_ETIQUETAS", RefrescarEtiquetasPorCambio);

                // Menú de Opciones — se recarga solo (saltando la caché de 60 min) cuando
                // un admin agrega/modifica/reordena opciones o botones desde el Treeview,
                // sin esperar a que la caché venza ni a un nuevo login.
                Cambios.Suscribir("SEGURIDAD.APLICACIONES_OPCIONES", RefrescarMenuPorCambio);
                Cambios.Suscribir("SEGURIDAD.APLICACIONES_OPCIONES_BOTONES", RefrescarMenuPorCambio);
                // NUM_MINUTOS_LOCKOUT_SCREEN de Configuración de Usuario prevalece sobre la Configuración General
                var minutosBloqueo = cfg.BloqueoMinutosUsuario ?? cfg.BloqueoMinutos;
                if (cfg.BloqueoActivo && minutosBloqueo > 0)
                {
                    _selfRef = DotNetObjectReference.Create(this);
                    try { await JS.InvokeVoidAsync("inactividad.iniciar", _selfRef, minutosBloqueo); } catch { }
                }

                var expiraToken = await ((JwtAuthStateProvider)AuthStateProvider).GetExpiracionTokenAsync();
                if (expiraToken is not null)
                {
                    try { await JS.InvokeVoidAsync("sesionToken.iniciar", expiraToken.Value.ToUnixTimeMilliseconds()); } catch { }
                }
            }
            catch { }

            await ErrorLog.TraceAsync($"FIN CARGA MENU — {DateTime.Now:yyyy-MM-dd HH:mm:ss.fff} — Total: {sw.ElapsedMilliseconds}ms");
        }
        catch (Exception ex)
        {
            await ErrorLog.TraceAsync($"FIN CARGA MENU (con error) — {DateTime.Now:yyyy-MM-dd HH:mm:ss.fff} — Total: {sw.ElapsedMilliseconds}ms", ex.Message);
            _rol = ""; _opciones = new(); _menuCargado = true;
            KONSolutions.Web.Services.JwtMessageHandler.SplashActivo = false;
        }
    }

    private static async Task SafeRun(Func<Task> fn) { try { await fn(); } catch { } }

    // Evita que el timer de 2 min dispare otra ronda mientras la anterior sigue en vuelo.
    private bool _verificandoApi;

    private async Task VerificarApi()
    {
        if (_verificandoApi) return;
        _verificandoApi = true;
        try
        {
            var resp = await Http.GetAsync("health");
            _apiActiva = resp.IsSuccessStatusCode;
        }
        catch { _apiActiva = false; }
        finally { _verificandoApi = false; }
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await VerificarApi();
            _healthTimer = new System.Threading.Timer(
                async _ => await VerificarApi(),
                null,
                TimeSpan.FromMinutes(2),
                TimeSpan.FromMinutes(2));

            await CargarNotificacionesAsync();
            // 20s (antes 2 min): con el polling más corto, las notificaciones nuevas
            // se detectan casi al instante y disparan el toast estilo Outlook.
            _notifTimer = new System.Threading.Timer(
                async _ => await CargarNotificacionesAsync(),
                null,
                TimeSpan.FromSeconds(20),
                TimeSpan.FromSeconds(20));
        }
        if (firstRender && !_bloqueoRestaurado)
        {
            _bloqueoRestaurado = true;
            try
            {
                var bloqueada = await LocalStorage.GetItemAsync<bool>("sesionBloqueada");
                if (bloqueada)
                {
                    await LocalStorage.RemoveItemAsync("sesionBloqueada");
                    await AuthService.LogoutAsync();
                    Navigation.NavigateTo("/login", forceLoad: true);
                }
            }
            catch { }

            try { await JS.InvokeVoidAsync("eval", _jsResizeSidebar); } catch { }
            try
            {
                _selfRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("shortcuts.iniciar", _selfRef);
            }
            catch { }
            try { await JS.InvokeVoidAsync("gridResize.init"); } catch { }
            try { await JS.InvokeVoidAsync("virtualKeyboard.init"); } catch { }
            await ActualizarTecladoVirtualAsync();
        }
    }

    /// <summary>
    /// Habilita el teclado virtual solo si los 3 flags están en true:
    /// Configuración General AND Opción (pantalla activa) AND Configuración de Usuario.
    /// </summary>
    private async Task ActualizarTecladoVirtualAsync()
    {
        var general = ConfigSvc.Current.TecladoVirtual;
        var usuario = ConfigSvc.Current.TecladoVirtualUsuario;

        // Flag de la opción/pantalla activa (por sus parámetros CodAplicacion/CodOpcionAplicacion).
        bool opcion = false;
        string? ca = null, co = null;
        bool? opcionFlag = null;
        var activaId = TabService.GetActiveTabId(0);
        var tab = TabService.Tabs.FirstOrDefault(t => t.Id == activaId);
        if (tab is not null
            && tab.Parametros.TryGetValue("CodAplicacion", out var caObj)
            && tab.Parametros.TryGetValue("CodOpcionAplicacion", out var coObj))
        {
            ca = caObj?.ToString(); co = coObj?.ToString();
            opcionFlag = MenuService.TecladoVirtualOpcion(ca, co);
            opcion = opcionFlag == true;
        }

        var habilitado = general && usuario && opcion;

        // LOG TEMPORAL de diagnóstico del teclado virtual (quitar cuando funcione).
        Console.WriteLine($"[TECLADO-VIRTUAL] general={general} usuario={usuario} " +
            $"opcion={opcion} (flagOpcionBD={(opcionFlag.HasValue ? opcionFlag.ToString() : "null")}) " +
            $"tab='{tab?.Titulo}' CodApp='{ca}' CodOpc='{co}' => HABILITADO={habilitado}");

        try { await JS.InvokeVoidAsync("virtualKeyboard.setHabilitado", habilitado); } catch { }
    }

    private const string _jsResizeSidebar = @"(function() {
        var handle  = document.getElementById('sidebarResizeHandle');
        var sidebar = document.getElementById('sidebar-main');
        if (!handle || !sidebar) return;
        // Solo actualiza la variable CSS --sidebar-w; NUNCA pone inline style.width
        // (el inline style sobreescribe las clases CSS y el sidebar no se contrae).
        function guardarAncho(w) {
            document.documentElement.style.setProperty('--sidebar-w', w);
            try { localStorage.setItem('sidebarWidth', w); } catch(e) {}
        }
        try {
            var saved = localStorage.getItem('sidebarWidth');
            if (saved) document.documentElement.style.setProperty('--sidebar-w', saved);
        } catch(e) {}
        // Pointer Events + setPointerCapture en vez de mousedown/mousemove/mouseup en
        // document: una vez capturado el puntero, TODOS los eventos posteriores (incluso
        // si el mouse pasa sobre otro elemento con mayor z-index/stacking, como items del
        // menú o el propio contenido) siguen llegando al handle — elimina de raíz cualquier
        // problema de otro elemento 'robándose' el arrastre a mitad de camino.
        var dragging = false, startX = 0, startW = 0;
        handle.style.touchAction = 'none';
        handle.addEventListener('pointerdown', function(e) {
            dragging = true;
            startX = e.clientX;
            startW = sidebar.offsetWidth;
            handle.classList.add('arrastrando');
            sidebar.style.transition = 'none';
            document.body.style.userSelect = 'none';
            try { handle.setPointerCapture(e.pointerId); } catch (err) {}
            e.preventDefault();
        });
        handle.addEventListener('pointermove', function(e) {
            if (!dragging) return;
            // e.clientX es posición real de pantalla; startW es pre-escala (offsetWidth).
            // Con el zoom propio de la app (transform:scale en #app, ver appZoom.js) activo,
            // el mismo desplazamiento real de mouse representa MÁS píxeles pre-escala cuanto
            // menor sea el zoom (y viceversa) — sin esto, arrastrar no responde bien salvo
            // exactamente al 100%. Mismo patrón que usa gridResize en index.html.
            var scale = (window.appZoom && window.appZoom.currentScale) || 1;
            var delta = (e.clientX - startX) / scale;
            var w = Math.min(Math.max(startW + delta, 180), 560) + 'px';
            // Durante el arrastre sí ponemos inline style para suavidad visual
            sidebar.style.width = w;
            document.documentElement.style.setProperty('--sidebar-w', w);
        });
        function finalizarArrastre(e) {
            if (!dragging) return;
            dragging = false;
            handle.classList.remove('arrastrando');
            sidebar.style.transition = '';
            document.body.style.userSelect = '';
            var w = sidebar.offsetWidth + 'px';
            // Limpiamos el inline style y dejamos que la clase CSS controle el ancho
            sidebar.style.width = '';
            guardarAncho(w);
            if (e && e.pointerId !== undefined) {
                try { handle.releasePointerCapture(e.pointerId); } catch (err) {}
            }
        }
        handle.addEventListener('pointerup', finalizarArrastre);
        handle.addEventListener('pointercancel', finalizarArrastre);
        // Salvaguarda: si el pointerup no llega a dispararse (ej. el foco saltó a otra
        // pestaña al abrir una nueva), esto evita que 'dragging' quede pegado en true con
        // user-select bloqueado indefinidamente.
        window.addEventListener('blur', function () { finalizarArrastre(); });

        // ── Ajuste automático del nombre en el header del sidebar ──
        // En vez de calcularlo con CSS calc()/clamp() (frágil: no reacciona igual en todos
        // los navegadores y se puede pasar de rosca truncando con '...'), medimos el ancho
        // real disponible en JS y vamos bajando el tamaño de letra de a 1px hasta que el
        // texto entre completo — así nunca queda cortado, sea cual sea el ancho del sidebar.
        var textoNombre = document.querySelector('.sidebar-logo-text');
        function ajustarFontNombre() {
            if (!textoNombre || !textoNombre.offsetParent) return; // oculto (sidebar sin pin)
            var maxPx = 22, minPx = 10;
            textoNombre.style.fontSize = maxPx + 'px';
            var intentos = maxPx - minPx;
            while (textoNombre.scrollWidth > textoNombre.clientWidth && intentos-- > 0) {
                maxPx -= 1;
                textoNombre.style.fontSize = maxPx + 'px';
            }
        }
        if (textoNombre) {
            var ro = new ResizeObserver(function () { ajustarFontNombre(); });
            ro.observe(sidebar);
            ro.observe(textoNombre);
            // Reintento corto tras el primer render (fuentes web / logo cargando pueden
            // cambiar el layout un instante después de este script).
            setTimeout(ajustarFontNombre, 50);
            setTimeout(ajustarFontNombre, 300);
        }
    })();";

