    public void Dispose()
    {
        ConfigSvc.OnChange -= OnConfigChanged;
        TransicionSvc.OnMostrar -= OnTransicionMostrar;
        TransicionSvc.OnOcultar -= OnTransicionOcultar;
        TabService.OnChange -= OnTabsCambiaron;
        Cambios.Desuscribir("ENTORNO.DICCIONARIO_ETIQUETAS", RefrescarEtiquetasPorCambio);
        Cambios.Desuscribir("SEGURIDAD.APLICACIONES_OPCIONES", RefrescarMenuPorCambio);
        Cambios.Desuscribir("SEGURIDAD.APLICACIONES_OPCIONES_BOTONES", RefrescarMenuPorCambio);
        MenuService.IconosActualizados -= OnIconosMenuActualizados;
        _healthTimer?.Dispose();
        _notifTimer?.Dispose();
    }

    // Experimento: los íconos del menú lateral llegan aparte (ver MenuService), sin bloquear
    // el primer render del árbol (ya visible solo con texto) — al llegar, se reconstruye
    // _arbolMenu igual que en los demás puntos que ya lo refrescan (cambio de rol, etc.).
    private void OnIconosMenuActualizados()
    {
        _arbolMenu = MenuService.GetArbolMenu();
        InvokeAsync(StateHasChanged);
    }

    private Task RefrescarEtiquetasPorCambio() => EtiquetasSvc.CargarAsync(forzar: true);

    private async Task RefrescarMenuPorCambio()
    {
        await MenuService.ForzarRecargaAsync();
        _opciones = MenuService.GetOpciones();
        _arbolMenu = MenuService.GetArbolMenu();
        await InvokeAsync(StateHasChanged);
    }

    // Al cambiar de pestaña/pantalla activa, recalcular si el teclado virtual va habilitado.
    private void OnTabsCambiaron() => _ = ActualizarTecladoVirtualAsync();

    /// <summary>Notificaciones pendientes del usuario — resumen por tipo (íconos + badge del
    /// AppBar) y detalle (lista al hacer clic en un ícono). Se refresca cada 2 minutos.</summary>
    // Evita que el timer de 20s dispare otra ronda mientras la anterior sigue en vuelo
    // (red lenta, muchos toasts a procesar) — sin esto, los sondeos se apilan.
    private bool _cargandoNotificaciones;

    private async Task CargarNotificacionesAsync()
    {
        // Sin sesión no se sondea: este layout también se renderiza en la pantalla de login,
        // y el timer de 20s arranca en OnAfterRenderAsync(firstRender) sin comprobar si hay
        // usuario autenticado. Sin esta guarda el endpoint se llamaba cada 20s sin token y
        // devolvía 401 en bucle — de acá venía el ruido de "Requires an authenticated user"
        // en consola, y además daba señales falsas de sesión perdida.
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            _notifResumen = new(); _notifDetalle = new();
            return;
        }

        // Respeta la Configuración de Usuario "Notificaciones activas" — si el usuario las
        // desactivó, ni siquiera se consulta el SP (ahorra la llamada cada 2 minutos).
        if (!ConfigSvc.Current.NotificacionesActivas)
        {
            _notifResumen = new(); _notifDetalle = new();
            return;
        }
        if (_cargandoNotificaciones) return;
        _cargandoNotificaciones = true;
        try
        {
            var r = await NotifSvc.GetPendientesAsync();
            _notifResumen = r.Resumen;
            _notifDetalle = r.Notificaciones;

            // Precargar (una sola vez por usuario, cacheado en memoria) la foto de cada
            // usuario notificador. La respuesta del polling ya NO trae la imagen; se pide
            // aparte al endpoint dedicado y se reutiliza en toasts y lista.
            _ = FotoSvc.PrecargarVariosAsync(_notifDetalle.Select(n => n.COD_USUARIO_NOTIFICADOR))
                       .ContinueWith(async t =>
                       {
                           if (t.Result) await InvokeAsync(StateHasChanged);
                       });

            // Detectar notificaciones nuevas (no vistas en el refresco anterior) y avisar
            // con un toast — igual que el aviso emergente de Outlook al llegar un correo.
            var nuevas = _notifDetalle.Where(n => !_notifVistas.Contains(n.NUM_NOTIFICACION)).ToList();
            foreach (var n in _notifDetalle) _notifVistas.Add(n.NUM_NOTIFICACION);

            if (!_notifPrimeraCarga)
                foreach (var n in nuevas)
                    MostrarToastNotificacion(n);
            _notifPrimeraCarga = false;
        }
        catch { }
        finally { _cargandoNotificaciones = false; }
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Tarjetas propias estilo "toast" de Outlook de escritorio (esquina inferior
    /// derecha): ícono del tipo de notificación a modo de avatar, título/mensaje, y una
    /// fila de botones (Descartar / Ver / Cerrar) — en vez del Snackbar genérico.</summary>
    private readonly List<NotificacionFlujoItem> _toasts = new();
    private const int MaxToastsVisibles = 3;

    private void MostrarToastNotificacion(NotificacionFlujoItem n)
    {
        _toasts.Insert(0, n);
        while (_toasts.Count > MaxToastsVisibles) _toasts.RemoveAt(_toasts.Count - 1);
        StateHasChanged();
        // Asegurar que la foto del notificador esté disponible para ESTE toast: si aún
        // no está cacheada, se descarga y se re-renderiza el toast con la foto ya puesta.
        _ = CargarFotoToastAsync(n);
        _ = AutoCerrarToastAsync(n);
    }

    private async Task CargarFotoToastAsync(NotificacionFlujoItem n)
    {
        if (await FotoSvc.PrecargarAsync(n.COD_USUARIO_NOTIFICADOR))
            await InvokeAsync(StateHasChanged);
    }

    private async Task AutoCerrarToastAsync(NotificacionFlujoItem n)
    {
        await Task.Delay(8000);
        await InvokeAsync(() => { CerrarToast(n); });
    }

    private void CerrarToast(NotificacionFlujoItem n)
    {
        _toasts.Remove(n);
        StateHasChanged();
    }

    private void VerToast(NotificacionFlujoItem n)
    {
        CerrarToast(n);
        _ = AbrirNotificacionAprobacion(n.NUM_NOTIFICACION);
    }

    private static string? IconoBase64(byte[]? bytes) =>
        bytes is { Length: > 0 } ? $"data:image/png;base64,{Convert.ToBase64String(bytes)}" : null;

    private void AbrirNotifPanel(string codTipo) => _notifTipoAbierto = codTipo;

    private void ToggleNotifPanel(string codTipo) => _notifTipoAbierto = _notifTipoAbierto == codTipo ? null : codTipo;

    /// <summary>
    /// Carga los datos ANTES de abrir el diálogo (con el cursor "ocupado" mientras tanto) —
    /// así el diálogo nace ya completo y solo se ve la animación de entrada de MudBlazor
    /// ("crece" una sola vez), en vez de aparecer chico/vacío 3-4 segundos y recién
    /// después completarse de golpe.
    /// </summary>
    private async Task AbrirNotificacionAprobacion(int numNotificacion)
    {
        _notifTipoAbierto = null;
        try { await JS.InvokeVoidAsync("cursorBusy.show"); } catch { }
        var data = await AprobSvc.GetByIdAsync(numNotificacion);
        try { await JS.InvokeVoidAsync("cursorBusy.hide"); } catch { }

        var parameters = new DialogParameters { ["Data"] = data };
        await DialogService.ShowAsync<KONSolutions.Web.Pages.Entorno.NotificacionAprobacionDialog>(
            "", parameters, new DialogOptions
            {
                // CloseButton=false: MudBlazor le agregaba su propia barra de título vacía
                // (solo para el botón X) encima de nuestra cabecera propia, dejando un
                // margen en blanco arriba. El cierre ahora vive en la cabecera del diálogo.
                CloseButton = false, MaxWidth = MaxWidth.False, FullWidth = false,
                Position = DialogPosition.Center, BackdropClick = false, CloseOnEscapeKey = false
            });
    }

    /// <summary>
    /// Atajos de teclado globales (ver wwwroot/js/shortcuts.js):
    /// Ctrl+K busca en el menú, Ctrl+W cierra la pestaña activa, Esc cierra menús/paneles abiertos.
    /// Ctrl+N / Ctrl+S / Delete / F2 se reenvían via ShortcutService a la página CRUD activa (si está suscrita).
    /// </summary>
    [JSInvokable]
    public async Task OnAtajoTeclado(string atajo)
    {
        switch (atajo)
        {
            case "ctrl+k":
                _pinned = true;
                StateHasChanged();
                await Task.Delay(30); // deja que el campo de búsqueda se renderice antes de enfocarlo
                try { await JS.InvokeVoidAsync("shortcuts.focusSidebarSearch"); } catch { }
                break;

            case "ctrl+w":
                var activa = TabService.GetActiveTabId(0);
                if (activa is not null) TabService.Cerrar(activa);
                break;

            case "esc":
                if (_userMenuOpen) { _userMenuOpen = false; StateHasChanged(); }
                else if (_ctxOpen)  { _ctxOpen = false; StateHasChanged(); }
                break;

            case "ctrl+n":     ShortcutSvc.RaiseNuevo();     break;
            case "ctrl+s":     ShortcutSvc.RaiseGuardar();   break;
            case "delete":     ShortcutSvc.RaiseEliminar();  break;
            case "f2":         ShortcutSvc.RaiseConsultar(); break;
        }
    }

    /// <summary>
    /// Cambia el rol activo: recarga botones/opciones para el nuevo rol, reconstruye
    /// el menú lateral, y cierra todas las pestañas abiertas salvo el Workspace
    /// (las pantallas abiertas con el rol anterior ya no son válidas).
    /// </summary>
    private bool _cambiandoRol = false;

    private async Task OnCambiarRol(string codRolUsuario)
    {
        if (codRolUsuario == MenuService.RolActivo) return;

        await ErrorLog.TraceAsync($"CAMBIO DE ROL - De: [{MenuService.RolActivo}] → A: [{codRolUsuario}]");
        _cambiandoRol = true;
        StateHasChanged();

        await MenuService.CambiarRolAsync(codRolUsuario);
        _opciones = MenuService.GetOpciones();
        _arbolMenu = MenuService.GetArbolMenu();
        await CargarEstadoCarpetasAsync();

        var rolElegido = MenuService.Roles.FirstOrDefault(r => r.COD_ROL_USUARIO == codRolUsuario);
        _rol = rolElegido?.DES_ROL_USUARIO ?? codRolUsuario;

        TabService.CerrarTodasMenosFijas();

        // Si estaba en modo circular/tiles, forzar cierre y reapertura para que cargue
        // los ítems del nuevo rol (el tab fijo no se cierra con CerrarTodasMenosFijas)
        if (_estiloMenu != EstiloMenu.Lateral)
        {
            var ruta = RutaDeEstilo(_estiloMenu)!;
            var tabFijo = TabService.Tabs.FirstOrDefault(t => t.Ruta == ruta);
            if (tabFijo is not null) { tabFijo.EsCerrable = true; TabService.Cerrar(tabFijo.Id); }
            var info = WorkspaceRegistry.PorRuta(ruta)!;
            TabService.Abrir(info.Titulo, info.Icono, info.ComponentType, info.Ruta, esCerrable: false);
        }

        _cambiandoRol = false;
        await ErrorLog.TraceAsync($"CAMBIO DE ROL - Completado: [{codRolUsuario}] — {_rol} — {_opciones.Count} opciones cargadas");
        StateHasChanged();
    }
