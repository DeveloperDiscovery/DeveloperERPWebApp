@inherits LayoutComponentBase
@implements IDisposable
@inject IAuthService AuthService
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject ConfigService ConfigSvc
@inject EtiquetasService EtiquetasSvc
@inject ControlCambiosClientService Cambios
@inject LimitesService Limites
@inject MenuService MenuService
@inject MenuEstadoService MenuEstado
@inject FavoritoService FavoritoService
@inject FavoritosCacheService FavoritosCache
@inject WorkspaceTabService TabService
@inject ISnackbar Snackbar
@inject AccessLogService AccessLog
@inject ErrorLogService ErrorLog
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject UsuarioService UsuarioSvc
@inject FotoUsuarioService FotoSvc
@inject CatalogoService<Perfil, PerfilDto> PerfilSvc
@inject HttpClient Http
@inject ConfiguracionGeneralService CfgGeneralSvc
@inject ConfiguracionUsuarioService CfgUsuarioSvc
@inject CatalogoService<KONSolutions.Shared.Models.Estandar.TipoMenuOpciones, KONSolutions.Shared.Models.Estandar.TipoMenuOpcionesDto> TiposMenuSvc
@inject ShortcutService ShortcutSvc
@inject TransicionMenuService TransicionSvc
@inject NotificacionesFlujoService NotifSvc
@inject NotificacionesAprobacionesService AprobSvc
@using KONSolutions.Web.Pages.Developer

<MudThemeProvider Theme="_theme" />
@* MudPopoverProvider ahora vive fuera de #app (ver index.html/Program.cs) para que el
   zoom (transform:scale) no desalinee combos, menús contextuales y tooltips. *@
<MudDialogProvider />
<MudSnackbarProvider />

<style>
    /* ── Splash screen ── */
    .splash-overlay {
        position: fixed; inset: 0; z-index: 10000;
        background: #1a1714;
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 28px;
        transition: opacity .4s ease;
    }
    .splash-logo {
        width: 110px; height: 110px; object-fit: contain; border-radius: 12px;
        animation: splashPulse 1.5s ease-in-out infinite;
    }
    .splash-icon-wrap {
        font-size: 90px !important; color: #b8472d;
        animation: splashPulse 1.5s ease-in-out infinite;
        display: flex;
    }
    .splash-appname {
        font-family: 'Archivo', sans-serif;
        font-weight: 800; letter-spacing: .16em;
        font-size: 1.2rem; color: rgba(255,255,255,.55);
        text-transform: uppercase;
    }
    .splash-dots {
        display: flex; gap: 8px;
    }
    .splash-dots span {
        width: 8px; height: 8px; border-radius: 50%;
        background: #b8472d; opacity: .3;
        animation: splashDot 1.2s ease-in-out infinite;
    }
    .splash-dots span:nth-child(2) { animation-delay: .2s; }
    .splash-dots span:nth-child(3) { animation-delay: .4s; }
    @@keyframes splashPulse {
        0%, 100% { transform: scale(1);    opacity: 1; }
        50%       { transform: scale(1.18); opacity: .75; }
    }
    @@keyframes splashDot {
        0%, 100% { opacity: .3; transform: translateY(0); }
        50%       { opacity: 1;  transform: translateY(-5px); }
    }

    /* ── Persiana horizontal de apertura al terminar la carga del menú:
       franjas apiladas (una encima de otra) que se encogen en ancho (scaleX) desde
       su propio centro, en cascada desde la franja central hacia arriba y abajo. ── */
    .blind-overlay {
        position: fixed; inset: 0; z-index: 9999;
        display: flex; flex-direction: column; pointer-events: none;
    }
    .blind-slat {
        flex: 1 1 0;
        background: #1a1714;
        transform-origin: center;
        animation: blindOpen .6s cubic-bezier(.6,0,.35,1) forwards;
    }
    @@keyframes blindOpen {
        from { transform: scaleX(1); }
        to   { transform: scaleX(0); }
    }
    @@media (prefers-reduced-motion: reduce) {
        .blind-slat { animation-duration: .01ms; animation-delay: 0ms !important; }
    }

    .sidebar {
        position: fixed;
        top: 0; left: 0; bottom: 40px;
        width: 60px;
        background: var(--env-back, #1a1714);
        border-right: 1px solid rgba(255,255,255,.08);
        display: flex;
        flex-direction: column;
        z-index: 1100;
        transition: width .22s cubic-bezier(.4,0,.2,1);
        overflow: hidden;
    }
    /* Expandido solo cuando está fijado con pin */
    .sidebar.pinned { width: var(--sidebar-w, 280px); }
    /* Ocultar tooltip cuando el sidebar está expandido (solo pin) */
    .sidebar.pinned .sidebar-tooltip { display: none !important; }
    /* Modo menú circular: sidebar completamente oculto — empresa aparece en el AppBar */
    .sidebar.oculto { width: 0 !important; border: none !important; overflow: hidden !important; }
    /* Usuario zurdo: sidebar a la derecha */
    .sidebar.zurdo { left: auto; right: 0; border-right: none; border-left: 1px solid rgba(255,255,255,.08); }

    /* Header del sidebar */
    .sidebar-header {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 6px;
        padding: 8px 12px;
        height: 92px; /* igual a .app-bar, para que ambas franjas queden a la misma altura */
        border-bottom: 1px solid rgba(255,255,255,.08);
        flex-shrink: 0;
        overflow: visible;
    }
    .sidebar-logo-text {
        font-family: 'Archivo', sans-serif;
        font-weight: 800;
        letter-spacing: .08em;
        /* Tamaño base — sidebarTextFit.js lo reduce en tiempo real (con JS, no con calc())
           hasta que el texto entre en el ancho real del sidebar, sin recortarlo con "...". */
        font-size: 1.35rem;
        line-height: 1.1;
        color: var(--env-fore, #fff);
        opacity: 1;
        transition: opacity .15s;
        white-space: nowrap;
        overflow: hidden;
        flex: 1;
        min-width: 0;
    }
    .sidebar:not(.pinned) .sidebar-logo-text { opacity: 0; pointer-events: none; }

    /* Scroll area */
    .sidebar-scroll {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 8px 0;
    }
    .sidebar-scroll::-webkit-scrollbar { width: 4px; }
    .sidebar-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,.12); border-radius: 2px; }

    /* Sección label */
    .sidebar-section {
        padding: 12px 14px 4px;
        font-size: .68rem;
        letter-spacing: .1em;
        color: #FFB74D;
        font-family: monospace;
        white-space: nowrap;
        overflow: hidden;
        transition: opacity .15s;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        user-select: none;
    }
    .sidebar-section:hover { color: #FFE082; }
    .sidebar-section .section-chevron {
        font-size: .75rem;
        transition: transform .2s;
        opacity: .7;
    }
    .sidebar-section.colapsada .section-chevron { transform: rotate(-90deg); }
    .sidebar:not(.pinned) .sidebar-section { opacity: 0; pointer-events: none; }

    /* Ítem de menú */
    .sidebar-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 14px;
        cursor: pointer;
        border-radius: 6px;
        margin: 1px 6px;
        color: var(--env-fore, rgba(255,255,255,.70));
        opacity: .85;
        font-size: .84rem;
        transition: background .14s, color .14s, opacity .14s;
        white-space: nowrap;
        overflow: hidden;
        position: relative;
    }
    .sidebar-item:hover { background: rgba(255,255,255,.09); opacity: 1; }
    .sidebar-item.activo { background: #b8472d; color: #fff; opacity: 1; }
    .sidebar-item .item-text {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        transition: opacity .15s;
    }
    .sidebar:not(.pinned) .sidebar-item .item-text { opacity: 0; pointer-events: none; }
    .sidebar-item .item-icon { flex-shrink: 0; font-size: 1.1rem !important; }
    .sidebar-item .item-icon-img { width: 1.1rem; height: 1.1rem; object-fit: contain; border-radius: 3px; }

    /* Grupo colapsable */
    .sidebar-group-header {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 14px;
        cursor: pointer;
        border-radius: 6px;
        margin: 1px 6px;
        color: var(--env-fore, rgba(255,255,255,.70));
        opacity: .85;
        font-size: .84rem;
        transition: background .14s, color .14s, opacity .14s;
        white-space: nowrap;
        overflow: hidden;
    }
    .sidebar-group-header:hover { background: rgba(255,255,255,.09); opacity: 1; }
    .sidebar-group-header .item-text { flex:1; overflow:hidden; text-overflow:ellipsis; transition: opacity .15s; }
    .sidebar:not(.pinned) .sidebar-group-header .item-text { opacity:0; pointer-events:none; }
    .sidebar-group-children { padding-left: 8px; }

    /* Tooltip en modo colapsado */
    .sidebar-item-wrap { position: relative; }
    .sidebar-item-wrap:hover .sidebar-tooltip {
        opacity: 1;
        pointer-events: auto;
        transform: translateX(0);
    }
    .sidebar-tooltip {
        position: absolute;
        left: 64px;
        top: 50%;
        transform: translateY(-50%) translateX(-6px);
        background: var(--env-back, #1a1714);
        color: #fff;
        font-size: .78rem;
        padding: 4px 10px;
        border-radius: 6px;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: opacity .15s, transform .15s;
        z-index: 9999;
        border: 1px solid rgba(255,255,255,.12);
        box-shadow: 0 4px 16px rgba(0,0,0,.4);
    }

    /* Pin button */
    .pin-btn {
        padding: 8px 12px;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        border-top: 1px solid rgba(255,255,255,.08);
        flex-shrink: 0;
    }

    /* Contenido principal desplazado */
    :root { --sidebar-w: 280px; }
    .main-content {
        margin-left: 60px;
        transition: margin-left .22s cubic-bezier(.4,0,.2,1);
        height: 100%; /* relativo a #app (ver app.css), no a 100vh — necesario para que el
                         zoom propio de la app (transform:scale en #app) escale todo junto */
        display: flex;
        flex-direction: column;
        overflow: hidden; /* el scroll real ocurre dentro de .ws-tab-content, variable vía flexbox */
    }
    /* Solo el pin empuja el contenido; el hover es overlay (z-index mayor, no mueve el contenido) */
    .main-content.expanded { margin-left: var(--sidebar-w, 280px); }
    /* Modo circular / tiles: sidebar oculto → contenido a ancho completo */
    .main-content.circular, .main-content.tiles { margin-left: 0 !important; }
    /* Usuario zurdo: contenido desplazado desde la derecha */
    .main-content.zurdo { margin-left: 0; margin-right: 60px; }
    .main-content.zurdo.expanded { margin-right: var(--sidebar-w, 280px); margin-left: 0; }
    .main-content.zurdo.circular, .main-content.zurdo.tiles { margin-right: 0 !important; }

    /* Handle de redimensionado del sidebar */
    .sidebar-resize-handle {
        position: absolute;
        top: 0; right: -4px; bottom: 0;
        width: 9px;
        cursor: col-resize;
        z-index: 5000;
        background: transparent;
        transition: background .15s;
        touch-action: none;
    }
    .sidebar-resize-handle:hover,
    .sidebar-resize-handle.arrastrando { background: rgba(184,71,45,.5); }
    .sidebar.zurdo .sidebar-resize-handle { right: auto; left: -4px; }

    /* AppBar */
    .app-bar {
        position: sticky;
        top: 0;
        height: 92px; /* agrandada para que quepan los íconos de notificaciones (x3) */
        flex-shrink: 0; /* nunca se comprime dentro del flex column de .main-content */
        background: var(--env-back, #1a1714);
        display: flex;
        align-items: center;
        padding: 0 16px;
        z-index: 1100;
        gap: 12px;
    }

    /* Grupo de notificaciones del AppBar (punto: íconos del SP + badge) — tamaño x3 */
    .notif-icon-item {
        position: relative;
        width: 84px; height: 84px; border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; color: var(--env-fore, #fff);
        transition: background .15s ease;
    }
    .notif-icon-item:hover { background: rgba(255,255,255,.08); }
    .notif-badge {
        position: absolute; top: 4px; right: 4px; min-width: 24px; height: 24px; padding: 0 6px;
        border-radius: 13px; background: #e02424; color: #fff;
        font-size: .95rem; font-weight: 700; line-height: 1;
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 0 0 2px var(--env-back, #1a1714);
        font-variant-numeric: tabular-nums;
    }
    .notif-panel {
        /* top:100% (no un valor fijo en px) para que quede pegado justo al borde inferior
           del ícono, sin ninguna franja intermedia — con una franja el mouse "sale" del
           ícono al bajar hacia las filas y el mouseleave cierra el panel antes de poder
           hacer clic (ocurría "a veces", según qué tan rápido bajaba el mouse). */
        /* Ancho/avatar/tipografía vueltos a la mitad (el x2 anterior no era lo pedido —
           era solo el ALTO de la lista, para que entren más filas visibles). El alto de
           la lista sí queda más grande a propósito: antes se veían ~3 filas, ahora ~6-7. */
        position: absolute; top: 100%; right: 0; width: 384px; max-width: 90vw;
        border-radius: 10px; overflow: hidden; z-index: 1200; color: var(--env-fore, #fff);
    }
    .notif-panel-head {
        padding: 10px 14px; display: flex; align-items: center; justify-content: space-between;
        font-weight: 700; font-size: 0.8rem; border-bottom: 1px solid rgba(255,255,255,.12);
    }
    .notif-panel-list { max-height: 400px; overflow-y: auto; background: #fff; }
    .notif-panel-item { padding: 10px 14px; border-bottom: 1px solid #e2e8f0; background: #fff; transition: background .12s, color .12s; }
    .notif-panel-item:last-child { border-bottom: none; }
    /* Mismo color de foco que usan las filas de las grillas (FocoFondo/FocoTexto de
       Configuración General), en vez de un hover genérico — variables inyectadas
       desde el contenedor del grupo de íconos. */
    .notif-panel-item:hover {
        background: var(--notif-foco-back, #b8472d);
        color: var(--notif-foco-fore, #ffffff);
    }
    .notif-panel-item:hover .notif-panel-item-titulo,
    .notif-panel-item:hover .notif-panel-item-detalle,
    .notif-panel-item:hover .notif-panel-item-usuario { color: var(--notif-foco-fore, #ffffff); }
    .notif-panel-item-titulo { font-weight: 700; font-size: 0.78rem; color: #1d4ed8; }
    .notif-panel-item-detalle { font-size: 0.74rem; color: #2563eb; opacity: .85; margin-top: 4px; }
    .notif-panel-item-usuario { font-size: 0.68rem; color: #64748b; margin-top: 4px; font-weight: 600; }
    .notif-panel-item-avatar {
        width: 36px; height: 36px; border-radius: 50%; background: #e1dfdd; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center; overflow: hidden;
    }
    .notif-panel-item-avatar img { width: 100%; height: 100%; object-fit: cover; }

    /* Toasts de notificación nueva, estilo Outlook de escritorio (Windows). */
    .toast-outlook-host {
        position: fixed; right: 16px; bottom: 44px; z-index: 9500;
        display: flex; flex-direction: column-reverse; gap: 10px;
        pointer-events: none;
    }
    .toast-outlook {
        pointer-events: auto; width: 360px; max-width: 90vw;
        background: #f3f2f1; border-radius: 8px; overflow: hidden;
        box-shadow: 0 8px 24px rgba(0,0,0,.28), 0 0 0 1px rgba(0,0,0,.06);
        animation: toast-outlook-in .25s ease-out;
    }
    @@keyframes toast-outlook-in {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .toast-outlook-head {
        display: flex; align-items: center; gap: 8px; padding: 8px 6px 6px 12px;
    }
    .toast-outlook-appicon { width: 16px; height: 16px; object-fit: contain; border-radius: 3px; }
    .toast-outlook-body {
        display: flex; gap: 12px; padding: 4px 14px 12px; cursor: pointer;
    }
    .toast-outlook-avatar-col {
        display: flex; flex-direction: column; align-items: center; gap: 3px; flex-shrink: 0; width: 72px;
    }
    .toast-outlook-avatar {
        width: 56px; height: 56px; border-radius: 50%; background: #e1dfdd; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center; overflow: hidden;
    }
    .toast-outlook-avatar img { width: 100%; height: 100%; object-fit: cover; }
    .toast-outlook-usuario {
        font-size: .62rem; font-weight: 600; color: #605e5c; text-align: center;
        width: 72px; line-height: 1.15; word-break: break-word;
    }
    .toast-outlook-titulo { font-size: .84rem; font-weight: 700; color: #201f1e; line-height: 1.3; }
    .toast-outlook-msg { font-size: .78rem; color: #605e5c; margin-top: 2px; line-height: 1.35; }
    .toast-outlook-actions {
        display: flex; border-top: 1px solid rgba(0,0,0,.08);
    }
    .toast-outlook-actions .mud-icon-button { flex: 1; border-radius: 0; }
    .toast-outlook-actions .mud-icon-button:not(:last-child) { border-right: 1px solid rgba(0,0,0,.08); }

    /* Zoom control (estilo Chrome) */
    .zoom-control {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 1px;
        user-select: none;
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 4px;
        overflow: hidden;
    }
    .zoom-btn {
        padding: 2px 8px;
        font-size: .85rem;
        color: var(--env-fore, #fff);
        opacity: .7;
        cursor: pointer;
        transition: background .12s, opacity .12s;
        line-height: 1.6;
    }
    .zoom-btn:hover { background: rgba(255,255,255,.12); opacity: 1; }
    .zoom-pct {
        padding: 2px 6px;
        font-size: .73rem;
        font-family: 'Spline Sans Mono', monospace;
        color: var(--env-fore, #fff);
        opacity: .8;
        cursor: pointer;
        border-left: 1px solid rgba(255,255,255,.1);
        border-right: 1px solid rgba(255,255,255,.1);
        min-width: 38px;
        text-align: center;
        line-height: 1.6;
        transition: background .12s, opacity .12s;
    }
    .zoom-pct:hover { background: rgba(255,255,255,.1); opacity: 1; }

    /* Pin button sin outline ni ripple */
    .status-bar .mud-icon-button:focus,
    .status-bar .mud-icon-button:focus-visible {
        outline: none !important;
        box-shadow: none !important;
    }
    .status-bar .mud-icon-button::after { display: none !important; }

    /* Texto del valor seleccionado en el selector de roles */
    .env-role-select .mud-input,
    .env-role-select .mud-input-slot,
    .env-role-select .mud-select-input,
    .env-role-select input,
    .env-role-select .mud-input-text,
    .env-role-select .mud-input-root,
    .env-role-select .mud-input-root-text {
        color: var(--env-fore, #fff) !important;
        background: var(--env-back, #1a1714) !important;
        background-color: var(--env-back, #1a1714) !important;
        font-size: .8rem !important;
    }
    .env-role-select .mud-select-icon,
    .env-role-select .mud-icon-root {
        color: var(--env-fore, #fff) !important;
        opacity: .6;
    }

    /* Popover del selector de roles — colores del entorno */
    .env-roles-popover .mud-list,
    .env-roles-popover .mud-popover-paper {
        background: var(--env-back, #1a1714) !important;
        color: var(--env-fore, #fff) !important;
    }
    .env-roles-popover .mud-list-item-text,
    .env-roles-popover .mud-list-item {
        color: var(--env-fore, #fff) !important;
    }
    .env-roles-popover .mud-selected-item,
    .env-roles-popover .mud-list-item.mud-selected {
        background: rgba(255,255,255,.12) !important;
        color: var(--env-fore, #fff) !important;
    }
    .env-roles-popover .mud-list-item:hover {
        background: rgba(255,255,255,.09) !important;
    }

    /* Íconos de MudListItem dentro de menús contextuales del entorno */
    .env-menu .mud-list-item-icon,
    .env-menu .mud-icon-root,
    .env-menu svg {
        color: inherit !important;
        fill: inherit !important;
    }
    .env-menu .mud-list-item:hover {
        background: rgba(255,255,255,.09) !important;
    }

    /* Barra de estado inferior — ancho completo, fuera del área de tabs */
    .status-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: 40px;
        background: var(--env-back, #1a1714);
        border-top: 1px solid rgba(255,255,255,.15);
        display: flex;
        align-items: center;
        padding: 0 16px;
        gap: 12px;
        z-index: 1150;
        overflow: hidden;
    }
</style>

@* ── Splash screen ── *@
@if (!_menuCargado)
{
    <div class="splash-overlay">
        @* Logo: preferir app, fallback empresa, fallback ícono *@
        @if (_logoApp is not null)
        {
            <img src="data:image/png;base64,@_logoApp" class="splash-logo" />
        }
        else if (_logoEmpresa is not null)
        {
            <img src="data:image/png;base64,@_logoEmpresa" class="splash-logo" />
        }
        else
        {
            <div class="splash-icon-wrap">
                <MudIcon Icon="@Icons.Material.Filled.GridView" Style="font-size:inherit;color:inherit;" />
            </div>
        }
        @* Nombre de la aplicación (de config) con colores en dos partes *@
        <div class="splash-appname">
            @{ var parts = _nombreApp.Split(' ', 2); }
            @if (parts.Length == 2)
            {
                <span style="color:rgba(255,255,255,.85);">@parts[0] </span><span style="color:var(--rust,#b8472d);">@parts[1]</span>
            }
            else
            {
                @_nombreApp
            }
        </div>
        @* Nombre de la empresa debajo, pequeño y atenuado *@
        @if (!string.IsNullOrWhiteSpace(_nombreEmpresa))
        {
            <div class="splash-appname" style="opacity:.45;font-size:.75rem;letter-spacing:.18em;margin-top:-16px;">@_nombreEmpresa.ToUpperInvariant()</div>
        }
        <div style="position:relative;width:150px;height:150px;display:flex;align-items:center;justify-content:center;" class="mt-2">
            <svg viewBox="0 0 150 150" style="width:100%;height:100%;position:absolute;inset:0;">
                @{ const int totalMarcas = 60; var encendidas = (int)Math.Round(totalMarcas * _cargaPct / 100.0); }
                @for (var i = 0; i < totalMarcas; i++)
                {
                    var idx = i;
                    var angulo = (idx / (double)totalMarcas) * 2 * Math.PI - Math.PI / 2;
                    var x1 = 75 + 62 * Math.Cos(angulo); var y1 = 75 + 62 * Math.Sin(angulo);
                    var x2 = 75 + 70 * Math.Cos(angulo); var y2 = 75 + 70 * Math.Sin(angulo);
                    <line x1="@x1.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                          y1="@y1.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                          x2="@x2.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                          y2="@y2.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                          stroke="@(idx < encendidas ? "#39ff6a" : "rgba(255,255,255,.18)")"
                          stroke-width="3" stroke-linecap="round" />
                }
            </svg>
            <div style="position:relative;text-align:center;">
                <div style="font-weight:800;font-size:1.6rem;color:#fff;font-family:var(--mono-font,monospace);">@_cargaPct%</div>
            </div>
        </div>
        <div class="mono" style="color:#39ff6a;text-shadow:0 0 6px rgba(57,255,106,.55);font-size:.8rem;letter-spacing:.05em;margin-top:-8px;">@_cargaEtapa</div>
    </div>
}

@* ── Persiana horizontal: al terminar de cargar el menú, en vez de que el splash
     desaparezca de golpe, se cubre la pantalla con franjas horizontales apiladas que se
     abren (encogen en ancho desde su propio centro) empezando por la franja central y en
     cascada hacia arriba y hacia abajo, dejando ver el menú recién cargado detrás. ── *@
@if (_revelandoPersiana)
{
    <div class="blind-overlay">
        @{ double centro = (PersianaSlats - 1) / 2.0; }
        @for (var i = 0; i < PersianaSlats; i++)
        {
            var delayMs = (int)(Math.Abs(i - centro) * 45);
            <div class="blind-slat" style="animation-delay:@(delayMs)ms;"></div>
        }
    </div>
}

@* ── Overlay de transición corta (ej. giro del menú circular) — mismo estilo que el
     splash posterior al login, pero sin logo: solo tapa mientras se abre una pestaña. ── *@
@if (_mostrandoTransicion)
{
    <div class="splash-overlay">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <div class="mono" style="color:#39ff6a;text-shadow:0 0 6px rgba(57,255,106,.55);font-size:.85rem;letter-spacing:.05em;">@_transicionMensaje</div>
    </div>
}

<AuthorizeView>
    <Authorized>
    @if (_menuCargado)
