    private static List<NodoMenu> Aplanar(List<NodoMenu> nodos)
    {
        var result = new List<NodoMenu>();
        foreach (var n in nodos)
        {
            if (!n.EsCarpeta && !n.EsSeparador && !n.EsSubModulo)
                result.Add(n);
            if (n.Hijos.Count > 0)
                result.AddRange(Aplanar(n.Hijos));
        }
        return result;
    }

    private async Task AbrirDesdeCircularSidebar(WorkspaceMenuCircular.TileVm t)
    {
        await ErrorLog.TraceAsync($"MENU CIRCULAR - SeleccionarTile: [{t.CodApp}] {t.Nombre} → {t.Ruta}");
        var op = new OpcionMenu
        {
            COD_APLICACION        = t.CodApp,
            COD_OPCION_APLICACION = t.CodOpcion,
            DES_OPCION_APLICACION = t.Nombre,
            DES_FORMULARIO        = t.Ruta,
            FLG_ACCESO_PERMITIDO  = true
        };
        await AbrirTabOpcion(op);
    }

